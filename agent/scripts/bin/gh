#!/usr/bin/env bash
# gh — wrapper that injects a fresh GH_TOKEN before exec'ing the real `gh`.
#
# GitHub App auth ($GH_TOKEN_FILE points at an existing file): several orgs
# share the agent and each has its own installation token, so the caller must
# say which org a command targets via $SHIPWRIGHT_GH_OWNER. The token is read
# from the gh-token.d/<lowercase-owner> file next to $GH_TOKEN_FILE. An unset
# hint fails with a teaching error; a hint with no token file fails naming the
# org. Neither case ever falls back to another org's token or the default one.
#
# PAT auth (no $GH_TOKEN_FILE, or the file is missing): pass through without
# touching GH_TOKEN; the hint is ignored.

set -euo pipefail

source="${BASH_SOURCE[0]}"
while [[ -L "$source" ]]; do
  dir=$(cd -P "$(dirname "$source")" && pwd)
  source=$(readlink "$source")
  [[ "$source" != /* ]] && source="$dir/$source"
done
self_dir=$(cd -P "$(dirname "$source")" && pwd)

if [[ -n "${GH_TOKEN_FILE:-}" && -f "$GH_TOKEN_FILE" ]]; then
  if [[ -z "${SHIPWRIGHT_GH_OWNER:-}" ]]; then
    cat >&2 <<'MSG'
gh wrapper: SHIPWRIGHT_GH_OWNER is not set.
This agent serves several GitHub orgs and each org has its own token, so every
gh command must say which org it targets via SHIPWRIGHT_GH_OWNER (the org that
owns the repo, e.g. app-vitals).
Retry with: SHIPWRIGHT_GH_OWNER=<org> gh ...
Prefix each command with it, because shell state does not persist between
commands.
MSG
    exit 1
  fi
  owner=${SHIPWRIGHT_GH_OWNER,,}
  owner_dir="$(dirname "$GH_TOKEN_FILE")/gh-token.d"
  token_file="$owner_dir/$owner"
  if [[ ! "$owner" =~ ^[a-z0-9][a-z0-9-]*$ || ! -f "$token_file" ]]; then
    echo "gh wrapper: no GitHub App installation token for org '$owner': the installation is missing, broken or not in this agent's scope. Check the GitHub Installations card in the admin UI." >&2
    exit 1
  fi
  GH_TOKEN=$(cat "$token_file")
  export GH_TOKEN
fi

new_path=""
IFS=':' read -r -a path_entries <<< "${PATH:-}"
for entry in "${path_entries[@]}"; do
  if [[ "$entry" != "$self_dir" ]]; then
    if [[ -z "$new_path" ]]; then
      new_path="$entry"
    else
      new_path="$new_path:$entry"
    fi
  fi
done
export PATH="$new_path"

if ! command -v gh >/dev/null 2>&1; then
  echo "gh wrapper: no real \`gh\` found on PATH after stripping $self_dir" >&2
  exit 127
fi

exec gh "$@"
