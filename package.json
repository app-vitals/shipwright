{
  "name": "shipwright-monorepo",
  "version": "1.504.0",
  "private": true,
  "workspaces": [
    "plugins/shipwright",
    "metrics",
    "agent",
    "admin",
    "task-store",
    "mcp-server"
  ],
  "scripts": {
    "test": "bun test",
    "lint": "bunx biome lint .",
    "format": "bunx biome format --write .",
    "typecheck": "bun run --filter='*' --sequential typecheck",
    "generate:admin-spec": "bun run scripts/generate-admin-spec.ts",
    "generate:admin-types": "bunx openapi-typescript@7.13.0 ./admin/src/coding/openapi.coding.json --output ./admin/src/coding/admin-types.ts",
    "generate:task-store-spec": "bun run scripts/generate-task-store-spec.ts",
    "generate:mcp-tools": "bun run scripts/generate-mcp-tools.ts",
    "generate:mcp-docs": "bun run scripts/generate-mcp-docs.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@playwright/test": "^1.49.0",
    "openapi-fetch": "^0.17.0",
    "openapi-typescript": "^7",
    "prisma": "^7.0.0",
    "typescript": "^7.0.0"
  },
  "dependencies": {
    "@shipwright/admin": "workspace:*",
    "@app-vitals/agent-admin": "1.86.0",
    "@app-vitals/agent-lib": "1.86.0",
    "@app-vitals/agent-runtime": "1.86.0",
    "@prisma/client": "^7.0.0"
  },
  "overrides": {
    "uuid": "14.0.3",
    "@hono/node-server": "^2.0.12",
    "minimatch": "^11.0.0",
    "brace-expansion": "^5.0.12",
    "fast-uri": "^4.1.5",
    "hono": "^4.13.7",
    "ip-address": "^10.7.1",
    "undici": "^8.0.0",
    "http-cache-semantics": "^4.3.0",
    "js-yaml": "^5.0.0",
    "@redocly/openapi-core": {
      "js-yaml": "4.3.2"
    },
    "mysql2": "^3.23.1",
    "tar": "^7.5.21",
    "deepmerge-ts": "^8.0.2"
  },
  "patchedDependencies": {
    "@slack/socket-mode@3.0.1": "patches/@slack%2Fsocket-mode@3.0.1.patch"
  }
}
