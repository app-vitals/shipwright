// Shipwright — Task Store Service Schema
// Owns: Task, TaskToken, PullRequest, PrFinding, VerificationCheck, CoverageSnapshot,
// ReadinessSnapshot, RepoCronRun, PatrolFinding, SystemCronDefinition, SystemCronTrigger.
//
// WARNING: This schema uses DATABASE_URL_SHIPWRIGHT_TASK_STORE — a dedicated
// database for the task-store service. Do NOT point this at a shared database.

generator client {
  provider = "prisma-client"
  output   = "./client"
}

// Prisma 7 removed `url` from `datasource` blocks — the Migrate connection URL
// now lives in ../prisma.config.ts (`datasource.url`), and the runtime
// connection comes from the PrismaPg driver adapter built in src/prisma-client.ts.
// Both still read DATABASE_URL_SHIPWRIGHT_TASK_STORE.
datasource db {
  provider = "postgresql"
}

// ─── Task Status ──────────────────────────────────────────────────────────────
// Full pipeline status set. Lifecycle:
// pending → in_progress → pr_open → approved → merged → deployed | released
// `deployed` = the change is live in an environment; `released` (MPD-1.1) =
// the change shipped through a package/release flow. Both are reachable from
// `merged`, which itself stays terminal for repos that neither deploy nor
// release. (`deploying` was removed in MPD-3.5.)
// Terminal: merged | done | deployed | released | cancelled. Paused: blocked.

enum TaskStatus {
  pending
  in_progress
  pr_open
  approved
  merged
  done
  deployed
  released
  blocked
  cancelled
}

// ─── Task Kind ────────────────────────────────────────────────────────────────
// What a task record *is*, as opposed to what state it is in (TaskStatus).
//
//   dev — an ordinary work item, executed by /shipwright:dev-task. The default
//         for every task, including every row that predates this enum.
//   prd — a product-spec task awaiting an autonomous planning pass, dispatched
//         as /shipwright:plan-session {repo} {session} --autonomous {id}. Never
//         part of the ?ready=true set (ready.ts excludes it) — a PRD task has no
//         dependency graph to resolve and must not be picked up as dev work.
//
// TKD-1.1 introduced this enum as the successor to a boolean
// `autonomousPlanSession` flag, kept in sync with it during a transition
// window; TKD-1.3 dropped that legacy flag once every writer (TKD-1.2) moved
// off it.

enum TaskKind {
  dev
  prd
  initiative
  idea
}

// ─── Task ─────────────────────────────────────────────────────────────────────
// Canonical task record. Mirrors the store.ts Task interface (minus prNumber,
// prOpenedAt, file, size) plus claim/liveness fields for multi-agent execution.
//
// Timestamp fields that originate from the JS interface are stored as ISO
// strings (String?) to match the application contract. Only createdAt and
// updatedAt are system-managed DateTime columns.

model Task {
  id        String     @id @default(cuid())
  accountId String     @default("default") // SSP-6.1: tenant scope; DEFAULT_ACCOUNT_ID in lib/default-account.ts
  title     String
  status    TaskStatus

  source             String?
  session            String?
  repo               String?
  description        String?
  acceptanceCriteria String[]
  layer              String?
  branch             String?
  dependencies       String[]
  pr                 Int?
  hours              Float?
  startedAt          String?
  prCreatedAt        String?
  mergedAt           String?
  blockedAt          String?
  blockedReason      String?
  note               String?
  type               String?
  priority           String?
  cancelledAt        String?
  completedAt        String?
  deployedAt         String?
  releasedAt         String? // MPD-1.1: set when status → released (mirrors deployedAt)
  ciFixAttempts      Int?
  mergeCommit        String?
  prUrl              String?
  assignee           String?
  issue              String?
  model              String? // "haiku" | "sonnet" | "opus"
  complexity         Int?
  hitl               Boolean?
  kind               TaskKind @default(dev)

  // ─── Planning provenance (PLU-2.1) ───
  // All nullable and default-free so existing rows are untouched. owner is the
  // requester's email (never invented for scanner/cron tasks). planDocumentId /
  // specDocumentId point at PlanDocument.id but are deliberately plain strings,
  // not FK relations — the same convention as Task.session and
  // Task.dependencies: no constraint on existing data, and a document row can
  // never block a task write or delete. The API validates them (PLU-2.5).
  // originKind is one of a registered list (document | skill | cron | human)
  // validated in code, kept a string so the list can grow without a migration;
  // originRef names the thing (a document id, skill or cron name, ...).
  owner          String?
  planDocumentId String?
  specDocumentId String?
  originKind     String?
  originRef      String?

  // ─── Skip tracking (auto-block after repeated no-op dispatches) ───
  // skipCount increments each time the loop orchestrator dispatches this task
  // and finds nothing to do (a [silent] outcome). Crossing the threshold (3,
  // mirroring SPIN_DETECTION_THRESHOLD in agent/src/coding/loop-orchestrator.ts)
  // auto-sets status=blocked + blockedReason so the task stops being re-selected forever.
  skipCount      Int     @default(0)
  lastSkippedAt  String?
  // lastSkipReason records the skip-reason text ([skip-reason:...] marker, or
  // the server-side "unspecified" default) associated with the current
  // skipCount streak (SRB-1.1). recordSkip() resets skipCount to 1 whenever
  // the incoming reason differs from this value (a new streak), and
  // increments skipCount when it matches — so only *consecutive occurrences
  // of the same reason* count toward SKIP_BLOCK_THRESHOLD. Cleared to null by
  // resetSkip()/unblock() alongside skipCount/lastSkippedAt.
  lastSkipReason String?

  // ─── Claim / liveness (multi-agent execution) ───
  claimedBy   String? // agent ID that claimed this task
  agentHint   String? // hint for which agent should pick up this task
  claimedAt   String? // ISO timestamp when claimed
  heartbeatAt String? // ISO timestamp of last heartbeat (liveness check)

  // ─── Execution data columns ───
  simplifyTotal       Int?
  simplifyDry         Int?
  simplifyDeadCode    Int?
  simplifyNaming      Int?
  simplifyComplexity  Int?
  simplifyConsistency Int?
  coverageDelta       Float?
  effortLevel         String? // "low" | "medium" | "high" | "xhigh" | "max"
  inputTokens         Int?
  outputTokens        Int?
  cacheReadTokens     Int?
  cacheCreationTokens Int?
  costUsd             Float?
  metadata            Json? // escape hatch for structured data without dedicated columns

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events             TaskEvent[]
  verificationChecks VerificationCheck[]

  @@index([status])
  @@index([session])
  @@index([assignee])
  @@index([claimedBy])
  @@index([updatedAt])
  @@index([accountId])
}

// ─── Task Event ───────────────────────────────────────────────────────────────
// A single field-level state transition on a Task, written incrementally (and
// potentially concurrently) as service methods mutate a Task. Modeled as a
// dedicated append-only table rather than a JSON blob on Task — entries are
// appended via a plain INSERT, which is race-safe, whereas a JSON-array
// read-modify-write PATCH on Task is not (mirrors the PullRequestEvent
// rationale below).
//
// Each row captures which field changed, its old/new values, which actor
// (agentId or "system") and service method wrote it, and when. field, actor,
// and method are plain strings — deliberately not enums — so new fields and
// call sites don't require a schema migration to be auditable.
//
// at is an ISO timestamp of when the transition occurred, stamped by the
// caller at insert time — following the same "String for JS-interface-
// originated timestamps" convention as the rest of this schema.
//
// The task relation intentionally omits onDelete (defaulting to RESTRICT)
// rather than the Cascade/SetNull used elsewhere in this repo — an audit
// trail should never silently disappear if its parent Task row were ever
// deleted. Nothing deletes Task rows today, so this has no live effect.

model TaskEvent {
  id       String  @id @default(cuid())
  taskId   String
  task     Task    @relation(fields: [taskId], references: [id])
  field    String
  oldValue String?
  newValue String?
  actor    String?
  method   String
  at       String

  createdAt DateTime @default(now())

  @@index([taskId, at])
}

// ─── Pull Request State ───────────────────────────────────────────────────────
// Lifecycle of a PR through the review/patch/merge pipeline.

enum PrState {
  open
  merged
  closed
}

enum PrReviewState {
  pending
  in_progress
  posted
  approved
}

// ─── PR Phase ─────────────────────────────────────────────────────────────────
// Tracks which pipeline phase a PR is currently in.

enum PrPhase {
  review
  patch
  merge
}

// ─── PR Origin ────────────────────────────────────────────────────────────────
// Where a PullRequest record's row first learned about the PR — the metrics
// dimension POM-1.1 introduces. First-write-wins: once set, later writes never
// overwrite it (see PullRequestService.stampOrigin()).
//
//   shipwright      — opened by a Shipwright command (dev-task.md/unblock.md's
//                      pr_open transition stamps this server-side)
//   ci               — opened by a CI bot (e.g. an automated dependency-bump
//                      workflow that isn't the dependency_bot itself)
//   dependency_bot   — opened by a dependency-update bot (Renovate/Dependabot)
//   human            — opened directly by a human
//   unknown          — origin could not be determined (e.g. discovered via the
//                      POM-4.1 census sweep with no other signal)
//
// Nullable on the PullRequest model: a row with origin=NULL has never been
// stamped — see the "known accepted gap" in POM-1.1's planning doc for PRs
// that never go through pr_open, /prs/claim, or the census sweep.

enum PrOrigin {
  shipwright
  ci
  dependency_bot
  human
  unknown
}

// ─── Pull Request ─────────────────────────────────────────────────────────────
// Tracks a GitHub PR through the Shipwright review → patch → merge pipeline.
// repo is in org/repo format (e.g. "app-vitals/shipwright").
// @@unique([accountId, repo, prNumber]) ensures one record per GitHub PR per account.
//
// Review state semantics:
//   staged      — review content has been written but not yet posted to GitHub
//   reviewState — workflow phase: pending → in_progress → posted (see enum PrReviewState)
// Both fields encode review progress: staged=true means "ready to post"; reviewState
// tracks which phase of the full review→patch→merge cycle the PR is in.

model PullRequest {
  id                String        @id @default(cuid())
  accountId         String        @default("default") // SSP-6.1: tenant scope; DEFAULT_ACCOUNT_ID in lib/default-account.ts
  repo              String // org/repo format
  prNumber          Int
  staged            Boolean       @default(false) // true = review written but not yet posted
  state             PrState       @default(open)
  reviewState       PrReviewState @default(pending) // workflow phase within the review cycle
  commitSha         String?
  reviewedCommitSha String? // exclusive commit-tracking field for the review pipeline, separate from the shared commitSha written by claim()/patch()/merge
  patchCycles       Int           @default(0)
  reviewCycles      Int           @default(0)
  agentId           String?
  reviewedAt        String?
  patchedAt         String?
  mergedAt          String?
  prCreatedAt       String? // ISO timestamp of the GitHub PR's actual creation (distinct from createdAt, the task-store record's creation)
  claimedBy         String?
  claimedAt         String?
  heartbeatAt       String?
  phase             PrPhase? // current pipeline phase: review | patch | merge
  readyForReviewAt  String?
  readyForPatchAt   String?
  readyForMergeAt   String? // MPD-1.1: stamped on first phase=merge claim
  blocked           Boolean       @default(false)
  blockedReason     String?

  // ─── Origin metrics (POM-1.1) ───
  // All four nullable, purely additive columns. `origin` is written exactly
  // once (first-write-wins) by PullRequestService.stampOrigin() from three
  // call sites: TaskService.update()'s pr_open transition (this task),
  // POST /prs/census's batch upsert (this task), and a third call site
  // POM-1.2 wires up later. authorLogin/headRef/title are always written
  // unconditionally by whichever call site supplies them (no first-write-wins
  // — the latest known value wins for these three). A PR that never passes
  // through any of those three paths (e.g. deploy.md's canary-revert PR) has
  // no PullRequest row at all, let alone an origin — see POM-1.1's planning
  // doc for that accepted gap.
  origin      PrOrigin?
  authorLogin String?
  headRef     String?
  title       String?

  // ─── Commit-count metrics (CPP-1.1) ───
  // All five nullable, purely additive columns, written unconditionally by
  // POST /prs/census whenever supplied (mirrors authorLogin/headRef/title —
  // NOT origin's first-write-wins semantic). Only the census sweep supplies
  // these fields, so there's no competing lower-quality writer to guard
  // against.
  commitCount           Int?
  commitsDocsRefresh    Int?
  commitsReviewPatch    Int?
  commitsCiFix          Int?
  commitsImplementation Int?

  // ─── Skip tracking (auto-block after repeated no-op dispatches) ───
  // Mirrors Task.skipCount/lastSkippedAt — see comment there for the
  // threshold rationale (3, matching SPIN_DETECTION_THRESHOLD in
  // agent/src/coding/loop-orchestrator.ts).
  skipCount     Int     @default(0)
  lastSkippedAt String?

  // ─── CI-failure streak tracking (auto-block after repeated identical CI failures) ───
  // Tracks consecutive patch() calls that report the same ciFailureSignature
  // (e.g. a stable identifier for "which check + which test failed"). A
  // differing (or first-seen) signature resets the streak to 1; crossing
  // CI_FAILURE_BLOCK_THRESHOLD (3, matching SPIN_DETECTION_THRESHOLD /
  // SKIP_BLOCK_THRESHOLD) auto-sets hitl + blockedReason so the loop
  // orchestrator stops re-dispatching CI-fix cycles that keep hitting the
  // same wall. Mirrors skipCount/lastSkippedAt's shape and rationale.
  lastCiFailureSignature    String?
  consecutiveCiFailureCount Int     @default(0)

  // ─── Block-time state (PSL-3.1) ───
  // All five nullable, purely additive columns. recordSkip() fills them when
  // it crosses SKIP_BLOCK_THRESHOLD so block frequency and the head/review the
  // PR was blocked on are directly queryable. blockedHeadSha/blockedReviewId/
  // blockedAt describe the live block; resetSkip() leaves them as-is (they are
  // overwritten by the next block). lastAutoBlockReason/lastAutoBlockedAt are
  // the preserved auto-block history — resetSkip() never clears them.
  // blockedReviewId is the id of the latest review-source PrFinding known at
  // block time (no GitHub review id is tracked on PullRequest).
  blockedHeadSha      String?
  blockedReviewId     String?
  blockedAt           String?
  lastAutoBlockReason String?
  lastAutoBlockedAt   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  findings           PrFinding[]
  events             PullRequestEvent[]
  verificationChecks VerificationCheck[]

  @@unique([accountId, repo, prNumber])
  @@index([accountId])
  @@index([state])
  @@index([reviewState])
  @@index([updatedAt])
  @@index([origin])
}

// ─── PR Finding Disposition ───────────────────────────────────────────────────
// Outcome of a review/patch finding once triaged.

enum PrFindingDisposition {
  resolved
  superseded
  rejected
}

// ─── PR Finding Source ────────────────────────────────────────────────────────
// Which pipeline phase recorded the finding.

enum PrFindingSource {
  review
  patch
}

// ─── PR Finding ───────────────────────────────────────────────────────────────
// A single review/patch finding on a PR, written incrementally (and
// potentially concurrently) by the review and patch pipelines. Modeled as a
// dedicated table rather than a JSON blob on PullRequest — entries are
// appended via a plain INSERT, which is race-safe, whereas a JSON-array
// read-modify-write PATCH on PullRequest is not.
//
// at is an ISO timestamp of when the finding was triaged, stamped by the
// caller at insert time — following the same "String for JS-interface-
// originated timestamps" convention as the rest of this schema.
//
// The pullRequest relation intentionally omits onDelete (defaulting to
// RESTRICT) rather than the Cascade/SetNull used elsewhere in this repo —
// findings are a triage record and should never silently disappear if their
// parent PullRequest row were ever deleted. Nothing deletes PullRequest rows
// today, so this has no live effect.

model PrFinding {
  id          String               @id @default(cuid())
  prRecordId  String
  pullRequest PullRequest          @relation(fields: [prRecordId], references: [id])
  ref         String
  disposition PrFindingDisposition
  source      PrFindingSource
  evidence    String
  at          String
  agentId     String?

  createdAt DateTime @default(now())

  @@index([prRecordId, ref])
  @@index([prRecordId, source])
}

// ─── Pull Request Event ───────────────────────────────────────────────────────
// A single field-level state transition on a PullRequest, written
// incrementally (and potentially concurrently) as service methods mutate a PR.
// Modeled as a dedicated append-only table rather than a JSON blob on
// PullRequest — entries are appended via a plain INSERT, which is race-safe,
// whereas a JSON-array read-modify-write PATCH on PullRequest is not (mirrors
// the PrFinding rationale above).
//
// Each row captures which field changed, its old/new values, which actor
// (agentId or "system") and service method wrote it, and when. field, actor,
// and method are plain strings — deliberately not enums — so new fields and
// call sites don't require a schema migration to be auditable.
//
// at is an ISO timestamp of when the transition occurred, stamped by the
// caller at insert time — following the same "String for JS-interface-
// originated timestamps" convention as the rest of this schema.
//
// The pullRequest relation intentionally omits onDelete (defaulting to
// RESTRICT) rather than the Cascade/SetNull used elsewhere in this repo — an
// audit trail should never silently disappear if its parent PullRequest row
// were ever deleted. Nothing deletes PullRequest rows today, so this has no
// live effect.

model PullRequestEvent {
  id          String      @id @default(cuid())
  prRecordId  String
  pullRequest PullRequest @relation(fields: [prRecordId], references: [id])
  field       String
  oldValue    String?
  newValue    String?
  actor       String?
  method      String
  at          String

  createdAt DateTime @default(now())

  @@index([prRecordId, at])
}

// ─── Verification Check Status ────────────────────────────────────────────────
// Outcome of a single verification check attempted during dev-task's Step 8 (or
// patch.md's mirrored validate/lint/test call sites, LVB-2.1/LVB-2.2) — LVB-5.1's
// structured, queryable successor to the printed-only "PRE-SHIP CHECKS" table
// those commands emit today (see dev-task.md Step 8's forward pointer to
// LVB-5.1/5.2).
//
// Identifiers use snake_case (ran_passed, timed_out, ...) rather than the
// hyphenated prose form ("ran-passed") used to describe them — Prisma enum
// values cannot contain `-` (validation error: "The character `-` is not
// allowed in Enum Value names"), and the generated client surfaces the
// identifier itself as the runtime string value (there is no separate
// @map'd wire value to diverge from it). This mirrors the multi-word enum
// values already used elsewhere in this schema (TaskStatus.in_progress,
// TaskStatus.pr_open) rather than introducing a new convention.

enum VerificationCheckStatus {
  ran_passed
  ran_failed
  skipped
  timed_out
}

// ─── Verification Check Reason Category ───────────────────────────────────────
// A closed set of ENVIRONMENTAL causes for why a check was skipped or timed
// out — never a correctness judgment. Valid ONLY alongside
// status IN (ran_passed's complement — i.e. skipped/timed_out); a ran_failed
// row (the check executed and produced a genuine failure — a real assertion/
// test failure, a real lint violation) must NEVER carry one. This separation
// is load-bearing for LVB-4.4's skip-locally learning trigger, which must
// only fire on skipped/timed-out outcomes and must never be tripped by a
// genuine ran-failed result — enforced by VerificationCheckService.record(),
// not just by convention (see its doc comment).
//
//   check_timeout / install_timeout — the check's (or the install step's)
//                        time budget was exceeded (LVB-2.1/2.2's per-check
//                        budgets).
//   resource_limit    — insufficient CPU/memory/disk in the execution
//                        environment.
//   missing_tool       — the execution image lacks a required tool/runtime/
//                        SDK for this check (the "docker image" dimension).
//   missing_secret     — a required API key/credential isn't available.
//   missing_dependency — e.g. no local DB or external service reachable.
//   not_configured     — the repo hasn't declared what this check needs, so
//                        we don't know yet.
//   learned_skip       — classified from repeated prior occurrences rather
//                        than observed directly this run;
//                        `learnedFromCategory` carries the original
//                        root-cause category that triggered the learning.
//
// (Identifiers use snake_case rather than the hyphenated prose form used to
// describe them above — see VerificationCheckStatus's doc comment for why.)

enum VerificationCheckReasonCategory {
  check_timeout
  install_timeout
  resource_limit
  missing_tool
  missing_secret
  missing_dependency
  not_configured
  learned_skip
}

// ─── Verification Check ─────────────────────────────────────────────────────────
// A single per-check verification outcome — LVB-5.1. Modeled as a dedicated
// append-only table (mirrors PrFinding/TaskEvent) rather than a JSON blob:
// entries are appended via a plain INSERT, which is race-safe, whereas a
// JSON-array read-modify-write PATCH on a parent record is not (mirrors the
// PrFinding/TaskEvent rationale documented above).
//
// Exactly one of taskId/prRecordId is set: a check may be recorded against an
// in-progress task before a PR exists, or against an already-open PR. There is
// no existing "optional reference to one of two parent record types" pattern
// elsewhere in this schema to mirror, so this uses two nullable FK columns;
// Prisma has no schema-level XOR constraint, so "exactly one set" is enforced
// by VerificationCheckService.record() at the service layer, not the DB.
//
// repo is stored directly (not derived via the taskId/prRecordId join) —
// self-describing without an extra join, and not guaranteed to equal the
// parent's own repo field for every future caller shape.
//
// checkName is a free-form string (not an enum) — "install", "lint",
// "typecheck", "unit", "integration", etc. — deliberately, mirroring
// TaskEvent.field/method's "plain string, not an enum, so new call sites
// don't require a schema migration" rationale.
//
// at is an ISO timestamp of when the check completed, stamped by the caller
// at insert time — the same "String for JS-interface-originated timestamps"
// convention used throughout this schema.
//
// Both FKs deliberately omit onDelete (defaulting to RESTRICT), matching
// PrFinding/TaskEvent — an outcome record should never silently disappear if
// its parent Task/PullRequest row were ever deleted.

model VerificationCheck {
  id        String @id @default(cuid())
  accountId String @default("default") // SSP-6.1: tenant scope; DEFAULT_ACCOUNT_ID in lib/default-account.ts

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id])

  prRecordId  String?
  pullRequest PullRequest? @relation(fields: [prRecordId], references: [id])

  repo      String
  checkName String

  status VerificationCheckStatus

  // Only ever non-null alongside status IN (skipped, timed_out) — see the
  // enum's doc comment and VerificationCheckService.record()'s validation.
  reasonCategory VerificationCheckReasonCategory?

  // Only ever non-null alongside reasonCategory === learned_skip — the
  // original root-cause category that triggered the learned classification.
  learnedFromCategory VerificationCheckReasonCategory?

  durationMs Int?
  at         String

  createdAt DateTime @default(now())

  @@index([taskId, at])
  @@index([prRecordId, at])
  @@index([repo, checkName])
  @@index([accountId])
}

// ─── CoverageSnapshot ─────────────────────────────────────────────────────────
// CVT-2.1: one measured coverage reading per (account, repo, commit). Has no
// parent Task/PullRequest — accountId comes straight from the caller's scope.
// The percentages are computed server-side from the covered/total counts; the
// branches*/functions* triplets are all-null when the tool did not report them.
// A repeat POST for the same commit updates the row in place (upsert).

model CoverageSnapshot {
  id        String @id @default(cuid())
  accountId String @default("default") // SSP-6.1: tenant scope

  repo      String
  branch    String
  commitSha String

  linesCovered Int
  linesTotal   Int
  linesPct     Float

  branchesCovered Int?
  branchesTotal   Int?
  branchesPct     Float?

  functionsCovered Int?
  functionsTotal   Int?
  functionsPct     Float?

  tool       String
  runUrl     String?
  measuredAt DateTime

  createdAt DateTime @default(now())

  @@unique([accountId, repo, commitSha])
  @@index([repo, measuredAt])
}

// ─── ReadinessSnapshot ────────────────────────────────────────────────────────
// RDY-1.2: one agent-readiness score per (account, repo, commit). Like
// CoverageSnapshot it has no parent Task/PullRequest — accountId comes from the
// caller's scope. `level` is 0-5 (0 = a Level 1 check fails); `checks` is a JSON
// array of {id, level, result, owner} (result: pass | fail | n/a); passing/failing
// are the counts of those results (n/a counts as passing). A repeat POST for the
// same commit updates the row in place (upsert).

model ReadinessSnapshot {
  id        String @id @default(cuid())
  accountId String @default("default") // SSP-6.1: tenant scope

  repo      String
  commitSha String

  level   Int
  passing Int
  failing Int
  checks  Json

  catalogueVersion String
  measuredAt       DateTime

  createdAt DateTime @default(now())

  @@unique([accountId, repo, commitSha])
  @@index([repo, measuredAt])
}

// ─── RepoCronRun ──────────────────────────────────────────────────────────────
// PCR-1.1: append-only record of every per-repo system-cron run (one row per
// run, never updated). Named RepoCronRun so it cannot collide with the
// platform's AgentCronRun. `taskId` is the SC task that ran it and
// `scheduledFor` the trigger slot (both nullable). `metrics` is a JSON object
// of finite numbers; `machineState` is small non-finding state only (e.g. a
// Sentry project-to-repo mapping or page anchors) and is omitted from list
// responses unless includeDetail=true. outcome: ok | no_op | failed.

model RepoCronRun {
  id        String @id @default(cuid())
  accountId String @default("default") // SSP-6.1: tenant scope

  cronId       String
  repo         String
  taskId       String?
  scheduledFor DateTime?
  startedAt    DateTime
  finishedAt   DateTime
  commitSha    String
  outcome      String
  metrics      Json
  machineState Json?

  createdAt DateTime @default(now())

  @@index([accountId, cronId, repo, finishedAt])
}

// ─── PatrolFinding ────────────────────────────────────────────────────────────
// PCR-1.2: cross-run ledger of patrol scan findings, replacing the legacy
// per-agent JSON ledgers so any agent can read a repo's prior findings. One
// row per distinct finding keyed by (accountId, cronId, repo, fingerprint).
// status: tracking | ready_to_propose | open | resolved | suppressed.
// `history` is an append-only JSON array of {at, status, occurrenceCount}
// entries — upserts only ever append. `detail` holds patrol-specific fields;
// `taskId` is set once a fix task is filed. Entropy does not use this table.

model PatrolFinding {
  id        String @id @default(cuid())
  accountId String @default("default") // SSP-6.1: tenant scope

  cronId          String
  repo            String
  fingerprint     String
  status          String
  firstSeen       DateTime
  lastSeen        DateTime
  occurrenceCount Int      @default(1)
  history         Json
  detail          Json?
  taskId          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, cronId, repo, fingerprint])
  @@index([accountId, cronId, repo, status])
}

// ─── Session ──────────────────────────────────────────────────────────────────
// A session groups multiple related tasks. Sessions are identified by a human-
// readable slug within an account (SSP-6.9: the [accountId, slug] compound
// unique is the sole identity — there is no slug-only primary key), allowing
// sessions to be cited as a meaningful organizational unit.
//
// The Task.session field remains a free string (not a foreign key) for backward
// compatibility — existing tasks that reference sessions by slug continue to work
// without requiring schema migrations.

model Session {
  slug       String // Human-readable identifier, e.g. "shipwright-may-launch"
  title      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?
  archivedBy String?
  accountId  String    @default("default") // SSP-6.1: tenant scope; DEFAULT_ACCOUNT_ID in lib/default-account.ts

  // ─── Planning (PLU-2.1) ───
  // All nullable and default-free so existing rows are untouched. owner is an
  // email set from the session's first document; homeRepo is the org/repo the
  // planning files live in. The `repos` field in session responses is derived
  // from task repos and document repos.
  owner                 String?
  homeRepo              String?
  // Short-lived, self-expiring planning lock: a planning pass holds it while it
  // reads and appends to the session's PLAN.md. Free when the holder is null
  // or the expiry has passed.
  planningLockHolder    String?
  planningLockExpiresAt DateTime?

  @@unique([accountId, slug])
  @@index([accountId])
}

// ─── Plan Document ────────────────────────────────────────────────────────────
// PLU-2.1: one row per planning document (a numbered spec, or the session's
// single plan) living as a file in the session's home repo. The rows — not the
// files on local disk — decide what a session has. Keyed by
// [accountId, session, kind, number]; plans always use number 1.
//
// session is the session slug as a plain string (not an FK), matching
// Task.session: Session's identity is the composite [accountId, slug], and a
// document may be registered before any task creates its session row.
// originTaskId is likewise a plain string (the prd/initiative task the
// document came from).
//
// state lifecycle: draft (registered, no PR) → pr_open (a docs PR carries it)
// → merged (on the home repo's default branch) | abandoned (PR closed unmerged).

enum PlanDocumentKind {
  spec
  plan
}

enum PlanDocumentState {
  draft
  pr_open
  merged
  abandoned
}

model PlanDocument {
  id        String @id @default(cuid())
  accountId String @default("default") // SSP-6.1: tenant scope; DEFAULT_ACCOUNT_ID in lib/default-account.ts

  session String // session slug
  kind    PlanDocumentKind
  number  Int // specs: 1, 2, 3… within the session; plans: always 1
  repo    String // home repo (org/repo) the file lives in
  path    String // repo-relative path, e.g. planning/{session}/SPEC-0002.md
  title   String? // first heading of the file, when known
  owner   String? // email; optional by design
  repos   String[]         @default([]) // target repos (org/repo) this document covers

  prUrl        String? // docs PR carrying the file
  state        PlanDocumentState @default(draft)
  commitSha    String? // commit the file was last read or written at
  plannedAt    DateTime? // specs only: set when a planning pass consumed it
  originTaskId String? // the prd/initiative task this document came from

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([accountId, session, kind, number])
}

// ─── System Cron Definition ───────────────────────────────────────────────────
// A platform-level scheduled job that, each time it fires, fans out into one
// ordinary `dev` task per repo (SCR-1.1). The scheduler itself lives outside
// the task store — it calls POST /system-crons/:id/fire with the slot it is
// firing (`scheduledFor`) and the repos to fan out to; the task store owns
// only the definition and the exactly-once claim of each slot.
//
// id is a caller-chosen lowercase slug (e.g. "dep-audit"), not a cuid — it is
// embedded verbatim in every generated task id (SC-{id}-{slot}-{owner}-{repo}).
//
// titleTemplate/descriptionTemplate support exactly one placeholder, `{repo}`,
// replaced by plain substitution (see src/system-cron-template.ts) — nothing
// else in a template is ever evaluated.

model SystemCronDefinition {
  id                  String    @id
  accountId           String    @default("default") // SSP-6.1: tenant scope; generated tasks inherit it
  name                String
  schedule            String // 5-field cron expression, interpreted by the external scheduler
  timezone            String    @default("UTC") // IANA zone the schedule is evaluated in
  enabled             Boolean   @default(true)
  // SCR-1.3: when the definition last went disabled→enabled (null while
  // disabled). The scheduler's catch-up never fires a slot at or before it,
  // so enabling (or re-enabling) never replays a backlog.
  enabledAt           DateTime?
  titleTemplate       String
  descriptionTemplate String
  // CRS-1.1: which repos a firing fans out to. 'all' (default; existing rows)
  // keeps today's behavior; 'selected' restricts to `repos` (org/repo).
  repoScope           String    @default("all")
  repos               String[]  @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  triggers SystemCronTrigger[]

  @@index([accountId])
}

// ─── System Cron Trigger ──────────────────────────────────────────────────────
// One row per claimed (cronId, scheduledFor) slot — the idempotency key for
// POST /system-crons/:id/fire. The row is inserted in the same transaction as
// the slot's tasks, so either both land or neither does; a concurrent fire for
// the same slot loses the unique-key race and creates nothing.
//
// scheduledFor is a real DateTime (normalized to whole seconds, UTC) rather
// than this schema's usual ISO-string convention, because it is the unique
// key: two spellings of the same instant must collide. slot is the derived
// compact form (YYYYMMDDTHHMMSSZ) used in task ids, stored for readability.
//
// The definition relation omits onDelete (RESTRICT), matching the audit-trail
// tables above — a claim record must not silently disappear.

model SystemCronTrigger {
  id           String               @id @default(cuid())
  accountId    String               @default("default")
  cronId       String
  definition   SystemCronDefinition @relation(fields: [cronId], references: [id])
  scheduledFor DateTime
  slot         String
  taskCount    Int

  createdAt DateTime @default(now())

  @@unique([cronId, scheduledFor])
  @@index([accountId])
}

// ─── Task Token ───────────────────────────────────────────────────────────────
// Scoped API tokens for task-store authentication. The raw token is returned
// once at creation; only the SHA-256 hash is stored.

model TaskToken {
  id        String    @id @default(cuid())
  token     String    @unique // SHA-256 hash of the raw token (hex)
  label     String?
  agentId   String? // null = admin token; set = agent token scoped to this agent
  createdAt DateTime  @default(now())
  revokedAt DateTime?
}
