// Shipwright — Task Store Service Schema
// Owns: Task, TaskToken, PullRequest, PrFinding.
//
// WARNING: This schema uses DATABASE_URL_SHIPWRIGHT_TASK_STORE — a dedicated
// database for the task-store service. Do NOT point this at a shared database.

generator client {
  provider = "prisma-client-js"
  output   = "./client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_SHIPWRIGHT_TASK_STORE")
}

// ─── Task Status ──────────────────────────────────────────────────────────────
// Full pipeline status set. Lifecycle:
// pending → in_progress → pr_open → approved → merged → deploying → deployed
// Terminal: merged | done | deployed | cancelled. Paused: blocked.

enum TaskStatus {
  pending
  in_progress
  pr_open
  approved
  merged
  done
  deploying
  deployed
  blocked
  cancelled
}

// ─── Task ─────────────────────────────────────────────────────────────────────
// Canonical task record. Mirrors the store.ts Task interface (minus prNumber,
// prOpenedAt, file, size) plus claim/liveness fields for multi-agent execution.
//
// Timestamp fields that originate from the JS interface are stored as ISO
// strings (String?) to match the application contract. Only createdAt and
// updatedAt are system-managed DateTime columns.

model Task {
  id     String     @id @default(cuid())
  title  String
  status TaskStatus

  source             String?
  session            String?
  repo               String?
  description        String?
  acceptanceCriteria String[]
  layer              String?
  branch             String?
  dependencies       String[]
  pr                 Int?
  hours              Float?
  startedAt          String?
  prCreatedAt        String?
  mergedAt           String?
  blockedAt          String?
  blockedReason      String?
  note               String?
  type               String?
  priority           String?
  cancelledAt        String?
  completedAt        String?
  deployingAt        String?
  deployedAt         String?
  ciFixAttempts      Int?
  mergeCommit        String?
  prUrl              String?
  assignee           String?
  issue              String?
  model              String? // "haiku" | "sonnet" | "opus"
  complexity         Int?
  hitl               Boolean?

  // ─── Skip tracking (auto-block after repeated no-op dispatches) ───
  // skipCount increments each time the loop orchestrator dispatches this task
  // and finds nothing to do (a [silent] outcome). Crossing the threshold (3,
  // mirroring SPIN_DETECTION_THRESHOLD in agent/src/loop-orchestrator.ts)
  // auto-sets hitl+blockedReason so the task stops being re-selected forever.
  skipCount     Int     @default(0)
  lastSkippedAt String?

  // ─── Claim / liveness (multi-agent execution) ───
  claimedBy   String? // agent ID that claimed this task
  agentHint   String? // hint for which agent should pick up this task
  claimedAt   String? // ISO timestamp when claimed
  heartbeatAt String? // ISO timestamp of last heartbeat (liveness check)

  // ─── Execution data columns ───
  simplifyTotal       Int?
  simplifyDry         Int?
  simplifyDeadCode    Int?
  simplifyNaming      Int?
  simplifyComplexity  Int?
  simplifyConsistency Int?
  coverageDelta       Float?
  effortLevel         String? // "low" | "medium" | "high" | "xhigh" | "max"
  inputTokens         Int?
  outputTokens        Int?
  cacheReadTokens     Int?
  cacheCreationTokens Int?
  costUsd             Float?
  metadata            Json? // escape hatch for structured data without dedicated columns

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([session])
  @@index([assignee])
  @@index([claimedBy])
  @@index([updatedAt])
}

// ─── Pull Request State ───────────────────────────────────────────────────────
// Lifecycle of a PR through the review/patch/deploy pipeline.

enum PrState {
  open
  merged
  closed
}

enum PrReviewState {
  pending
  in_progress
  posted
  approved
}

// ─── PR Phase ─────────────────────────────────────────────────────────────────
// Tracks which pipeline phase a PR is currently in.

enum PrPhase {
  review
  patch
  deploy
}

// ─── Pull Request ─────────────────────────────────────────────────────────────
// Tracks a GitHub PR through the Shipwright review → patch → deploy pipeline.
// repo is in org/repo format (e.g. "app-vitals/shipwright").
// @@unique([repo, prNumber]) ensures one record per GitHub PR.
//
// Review state semantics:
//   staged      — review content has been written but not yet posted to GitHub
//   reviewState — workflow phase: pending → in_progress → posted (see enum PrReviewState)
// Both fields encode review progress: staged=true means "ready to post"; reviewState
// tracks which phase of the full review→patch→deploy cycle the PR is in.

model PullRequest {
  id                String        @id @default(cuid())
  repo              String // org/repo format
  prNumber          Int
  taskId            String?
  staged            Boolean       @default(false) // true = review written but not yet posted
  state             PrState       @default(open)
  reviewState       PrReviewState @default(pending) // workflow phase within the review cycle
  commitSha         String?
  reviewedCommitSha String? // exclusive commit-tracking field for the review pipeline, separate from the shared commitSha written by claim()/patch()/deploy
  patchCycles       Int           @default(0)
  reviewCycles      Int           @default(0)
  agentId           String?
  reviewedAt        String?
  patchedAt         String?
  mergedAt          String?
  prCreatedAt       String? // ISO timestamp of the GitHub PR's actual creation (distinct from createdAt, the task-store record's creation)
  claimedBy         String?
  claimedAt         String?
  heartbeatAt       String?
  phase             PrPhase? // current pipeline phase: review | patch | deploy
  readyForReviewAt  String?
  readyForPatchAt   String?
  readyForDeployAt  String?
  blocked           Boolean       @default(false)
  blockedReason     String?

  // ─── Skip tracking (auto-block after repeated no-op dispatches) ───
  // Mirrors Task.skipCount/lastSkippedAt — see comment there for the
  // threshold rationale (3, matching SPIN_DETECTION_THRESHOLD in
  // agent/src/loop-orchestrator.ts).
  skipCount     Int     @default(0)
  lastSkippedAt String?

  // ─── CI-failure streak tracking (auto-block after repeated identical CI failures) ───
  // Tracks consecutive patch() calls that report the same ciFailureSignature
  // (e.g. a stable identifier for "which check + which test failed"). A
  // differing (or first-seen) signature resets the streak to 1; crossing
  // CI_FAILURE_BLOCK_THRESHOLD (3, matching SPIN_DETECTION_THRESHOLD /
  // SKIP_BLOCK_THRESHOLD) auto-sets hitl + blockedReason so the loop
  // orchestrator stops re-dispatching CI-fix cycles that keep hitting the
  // same wall. Mirrors skipCount/lastSkippedAt's shape and rationale.
  lastCiFailureSignature    String?
  consecutiveCiFailureCount Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  findings PrFinding[]
  events   PullRequestEvent[]

  @@unique([repo, prNumber])
  @@index([taskId])
  @@index([state])
  @@index([reviewState])
  @@index([updatedAt])
}

// ─── PR Finding Disposition ───────────────────────────────────────────────────
// Outcome of a review/patch finding once triaged.

enum PrFindingDisposition {
  resolved
  superseded
  rejected
}

// ─── PR Finding Source ────────────────────────────────────────────────────────
// Which pipeline phase recorded the finding.

enum PrFindingSource {
  review
  patch
}

// ─── PR Finding ───────────────────────────────────────────────────────────────
// A single review/patch finding on a PR, written incrementally (and
// potentially concurrently) by the review and patch pipelines. Modeled as a
// dedicated table rather than a JSON blob on PullRequest — entries are
// appended via a plain INSERT, which is race-safe, whereas a JSON-array
// read-modify-write PATCH on PullRequest is not.
//
// at is an ISO timestamp of when the finding was triaged, stamped by the
// caller at insert time — following the same "String for JS-interface-
// originated timestamps" convention as the rest of this schema.
//
// The pullRequest relation intentionally omits onDelete (defaulting to
// RESTRICT) rather than the Cascade/SetNull used elsewhere in this repo —
// findings are a triage record and should never silently disappear if their
// parent PullRequest row were ever deleted. Nothing deletes PullRequest rows
// today, so this has no live effect.

model PrFinding {
  id          String               @id @default(cuid())
  prRecordId  String
  pullRequest PullRequest          @relation(fields: [prRecordId], references: [id])
  ref         String
  disposition PrFindingDisposition
  source      PrFindingSource
  evidence    String
  at          String

  createdAt DateTime @default(now())

  @@index([prRecordId, ref])
  @@index([prRecordId, source])
}

// ─── Pull Request Event ───────────────────────────────────────────────────────
// A single field-level state transition on a PullRequest, written
// incrementally (and potentially concurrently) as service methods mutate a PR.
// Modeled as a dedicated append-only table rather than a JSON blob on
// PullRequest — entries are appended via a plain INSERT, which is race-safe,
// whereas a JSON-array read-modify-write PATCH on PullRequest is not (mirrors
// the PrFinding rationale above).
//
// Each row captures which field changed, its old/new values, which actor
// (agentId or "system") and service method wrote it, and when. field, actor,
// and method are plain strings — deliberately not enums — so new fields and
// call sites don't require a schema migration to be auditable.
//
// at is an ISO timestamp of when the transition occurred, stamped by the
// caller at insert time — following the same "String for JS-interface-
// originated timestamps" convention as the rest of this schema.
//
// The pullRequest relation intentionally omits onDelete (defaulting to
// RESTRICT) rather than the Cascade/SetNull used elsewhere in this repo — an
// audit trail should never silently disappear if its parent PullRequest row
// were ever deleted. Nothing deletes PullRequest rows today, so this has no
// live effect.

model PullRequestEvent {
  id          String      @id @default(cuid())
  prRecordId  String
  pullRequest PullRequest @relation(fields: [prRecordId], references: [id])
  field       String
  oldValue    String?
  newValue    String?
  actor       String?
  method      String
  at          String

  createdAt DateTime @default(now())

  @@index([prRecordId, at])
}

// ─── Task Token ───────────────────────────────────────────────────────────────
// Scoped API tokens for task-store authentication. The raw token is returned
// once at creation; only the SHA-256 hash is stored.

model TaskToken {
  id        String    @id @default(cuid())
  token     String    @unique // SHA-256 hash of the raw token (hex)
  label     String?
  agentId   String? // null = admin token; set = agent token scoped to this agent
  createdAt DateTime  @default(now())
  revokedAt DateTime?
}
