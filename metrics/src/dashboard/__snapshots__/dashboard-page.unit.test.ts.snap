// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`renderDashboardPage — snapshot renders full page for a regular user 1`] = `
"<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="light dark" />
  <title>Metrics — Vitals OS</title>
  <script>(function(){var t="light";try{var s=localStorage.getItem("shipwright-theme");if(s==="dark"||s==="light"){t=s}else if(window.matchMedia&&window.matchMedia("(prefers-color-scheme: dark)").matches){t="dark"}}catch(e){}document.documentElement.setAttribute("data-theme",t)})();</script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root { color-scheme: light; --vos-bg: #f7f7fb; --vos-surface: #ffffff; --vos-surface-muted: #f9fafb; --vos-surface-subtle: #f3f4f6; --vos-border: #e8e8ee; --vos-border-strong: #d1d5db; --vos-text: #1a1a2e; --vos-text-body: #374151; --vos-text-muted: #6b7280; --vos-text-faint: #9ca3af; --vos-brand: #4f46e5; --vos-brand-strong: #4338ca; --vos-brand-bg: #eef2ff; --vos-brand-border: #c7d2fe; --vos-on-brand: #ffffff; --vos-primary: #1a1a2e; --vos-primary-hover: #2d2d4e; --vos-primary-text: #ffffff; --vos-success-bg: #d1fae5; --vos-success-text: #065f46; --vos-success-border: #a7f3d0; --vos-warning-bg: #fef3c7; --vos-warning-text: #92400e; --vos-warning-border: #fde68a; --vos-danger: #dc2626; --vos-danger-text: #b91c1c; --vos-danger-bg: #fee2e2; --vos-danger-border: #fecaca; --vos-info-bg: #dbeafe; --vos-info-text: #1e40af; --vos-info-border: #93c5fd; --vos-violet-bg: #ede9fe; --vos-violet-text: #5b21b6; --vos-teal-bg: #ccfbf1; --vos-teal-text: #0f766e; }
    :root[data-theme="dark"] { color-scheme: dark; --vos-bg: #0f1117; --vos-surface: #171a22; --vos-surface-muted: #1b1f29; --vos-surface-subtle: #1f2330; --vos-border: #2a2f3d; --vos-border-strong: #3a4052; --vos-text: #e6e8ef; --vos-text-body: #c9cdd8; --vos-text-muted: #a3a9b8; --vos-text-faint: #8891a3; --vos-brand: #818cf8; --vos-brand-strong: #a5b4fc; --vos-brand-bg: #23264a; --vos-brand-border: #3b3f7a; --vos-on-brand: #0f1117; --vos-primary: #e6e8ef; --vos-primary-hover: #ffffff; --vos-primary-text: #0f1117; --vos-success-bg: #0f2e1d; --vos-success-text: #86efac; --vos-success-border: #14532d; --vos-warning-bg: #3a2a0c; --vos-warning-text: #fcd34d; --vos-warning-border: #78350f; --vos-danger: #f87171; --vos-danger-text: #fca5a5; --vos-danger-bg: #3b1518; --vos-danger-border: #7f1d1d; --vos-info-bg: #16264a; --vos-info-text: #93c5fd; --vos-info-border: #1e3a8a; --vos-violet-bg: #2a1f4d; --vos-violet-text: #c4b5fd; --vos-teal-bg: #0f2f2c; --vos-teal-text: #5eead4; }
    :root[data-theme="dark"] textarea, :root[data-theme="dark"] select, :root[data-theme="dark"] input:not([type="checkbox"]):not([type="radio"]):not([type="range"]) { background-color: var(--vos-surface); color: var(--vos-text); }
    html { font-size: 16px; -webkit-font-smoothing: antialiased; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background: var(--vos-bg);
      color: var(--vos-text);
      min-height: 100vh;
    }

    /* ─── Toolbar ───────────────────────────────────────── */
    .vos-toolbar {
      background: var(--vos-surface);
      border-bottom: 1px solid var(--vos-border);
      height: 52px;
      display: flex;
      align-items: center;
      padding: 0 24px;
      gap: 24px;
      position: sticky;
      top: 0;
      z-index: 100;
    }
    .vos-wordmark {
      font-size: 15px;
      font-weight: 700;
      color: var(--vos-text);
      text-decoration: none;
      letter-spacing: -0.3px;
      flex-shrink: 0;
    }
    .vos-wordmark:hover { color: var(--vos-brand); }
    .vos-nav {
      display: flex;
      align-items: center;
      gap: 4px;
      flex: 1;
    }
    .vos-nav-link {
      padding: 5px 12px;
      border-radius: 6px;
      font-size: 13px;
      font-weight: 500;
      color: var(--vos-text-muted);
      text-decoration: none;
      transition: background 0.1s, color 0.1s;
      white-space: nowrap;
    }
    .vos-nav-link:hover { background: var(--vos-surface-subtle); color: var(--vos-text); }
    .vos-nav-link.active {
      background: var(--vos-brand-bg);
      color: var(--vos-brand);
      font-weight: 600;
    }
    .vos-user {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-shrink: 0;
      margin-left: auto;
    }
    .vos-username {
      font-size: 13px;
      color: var(--vos-text-muted);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 160px;
    }
    .vos-signout-btn {
      font-size: 13px;
      font-weight: 500;
      color: var(--vos-text-muted);
      background: none;
      border: 1px solid var(--vos-border);
      border-radius: 6px;
      padding: 5px 12px;
      cursor: pointer;
      font-family: inherit;
      transition: background 0.1s, color 0.1s, border-color 0.1s;
      white-space: nowrap;
    }
    .vos-signout-btn:hover { background: var(--vos-bg); color: var(--vos-text); border-color: var(--vos-border-strong); }

    /* ─── Page body ─────────────────────────────────────── */
    .vos-theme-toggle {
      font-size: 13px;
      font-weight: 500;
      color: var(--vos-text-muted);
      background: none;
      border: 1px solid var(--vos-border);
      border-radius: 6px;
      padding: 5px 12px;
      min-height: 28px;
      cursor: pointer;
      white-space: nowrap;
      transition: background 0.1s, color 0.1s, border-color 0.1s;
    }
    .vos-theme-toggle:hover { background: var(--vos-bg); color: var(--vos-text); border-color: var(--vos-border-strong); }
    .vos-theme-toggle[aria-pressed="true"] { background: var(--vos-brand-bg); color: var(--vos-brand); border-color: var(--vos-brand-border); }
    .vos-page {
      max-width: 960px;
      margin: 0 auto;
      padding: 32px 24px 64px;
    }
    .vos-page-wide { max-width: none; width: 100%; }

    /* ─── Hamburger toggle (CSS-only, no JS) ───────────── */
    .vos-nav-toggle { display: none; }
    .vos-hamburger {
      display: none;
      background: none;
      border: none;
      font-size: 20px;
      cursor: pointer;
      color: var(--vos-text);
      padding: 4px 8px;
      line-height: 1;
      font-family: inherit;
    }
    .vos-hamburger:hover { color: var(--vos-brand); }

    @media (max-width: 640px) {
      .vos-toolbar { padding: 0 16px; gap: 12px; flex-wrap: wrap; height: auto; min-height: 52px; align-items: center; }
      .vos-username { display: none; }
      .vos-nav-link { padding: 5px 8px; }
      .vos-page { padding: 20px 16px 48px; }

      /* Hide nav links by default on mobile */
      .vos-nav {
        display: none;
        flex-direction: column;
        width: 100%;
        gap: 2px;
        padding: 8px 0;
        order: 3;
      }
      /* Show nav links when hamburger checkbox is checked */
      .vos-nav-toggle:checked + nav .vos-nav {
        display: flex;
      }
      .vos-nav-link {
        display: block;
        padding: 10px 12px;
        border-radius: 6px;
        font-size: 14px;
      }
      .vos-nav-link.active {
        background: var(--vos-brand-bg);
        color: var(--vos-brand);
        font-weight: 600;
      }
      /* Show hamburger on mobile */
      .vos-hamburger {
        display: block;
      }
      /* Hide user section sign-out on mobile when nav is closed */
      .vos-user {
        order: 2;
        margin-left: 0;
      }
    }

  </style>
  <link rel="stylesheet" href="/dashboard/styles.css" />
</head>
<body>
  <input type="checkbox" id="vos-nav-toggle" class="vos-nav-toggle" aria-hidden="true">
  <nav class="vos-toolbar" aria-label="Site navigation">
    <a href="/admin/agents" class="vos-wordmark">Shipwright</a>
    <div id="vos-nav-content" class="vos-nav">
      <a href="/admin/agents" class="vos-nav-link">Agents</a>
      <a href="/admin/tasks" class="vos-nav-link">Tasks</a>
      <a href="/admin/sessions" class="vos-nav-link">Sessions</a>
      <a href="/admin/prs" class="vos-nav-link">PRs</a>
      <a href="/admin/chat" class="vos-nav-link">Chat</a>
      <a href="/admin/queue-activity" class="vos-nav-link">Queue &amp; Activity</a>
      <a href="/dashboard" class="vos-nav-link active">Metrics</a>
    </div>
    <div class="vos-user">
      <span class="vos-username">Alice</span>
      <button type="button" id="vos-theme-toggle" class="vos-theme-toggle" aria-pressed="false">Dark mode</button>
      <form method="POST" action="/admin/logout" style="margin:0">
        <button type="submit" class="vos-signout-btn">Sign out</button>
      </form>
    </div>
    <label for="vos-nav-toggle" class="vos-hamburger" aria-label="Toggle navigation" aria-expanded="false" aria-controls="vos-nav-content">☰</label>
  </nav>
  <script>(function(){var t=document.getElementById('vos-nav-toggle');if(t)t.addEventListener('change',function(){var l=document.querySelector('label[for="vos-nav-toggle"]');if(l)l.setAttribute('aria-expanded',t.checked?'true':'false');});})();</script>
  <script>(function(){var d=document,r=d.documentElement,k="shipwright-theme",q=window.matchMedia?window.matchMedia("(prefers-color-scheme: dark)"):null;function saved(){try{var s=localStorage.getItem(k);return s==="dark"||s==="light"?s:null}catch(e){return null}}function apply(t){r.setAttribute("data-theme",t);var b=d.getElementById("vos-theme-toggle");if(b)b.setAttribute("aria-pressed",t==="dark"?"true":"false");d.dispatchEvent(new CustomEvent("vos-theme-change",{detail:{theme:t}}))}apply(saved()||(q&&q.matches?"dark":"light"));var b=d.getElementById("vos-theme-toggle");if(b)b.addEventListener("click",function(){var t=r.getAttribute("data-theme")==="dark"?"light":"dark";try{localStorage.setItem(k,t)}catch(e){}apply(t)});if(q&&q.addEventListener)q.addEventListener("change",function(e){if(!saved())apply(e.matches?"dark":"light")})})();</script>
  <div class="app">

    <!-- Page Controls -->
    <div class="page-controls">
      <div class="date-range-picker" role="group" aria-label="Date range">
        <button class="date-btn active" data-range="today" type="button">1D</button>
        <button class="date-btn" data-range="7d" type="button">7D</button>
        <button class="date-btn" data-range="30d" type="button">30D</button>
        <button class="date-btn" data-range="90d" type="button">90D</button>
      </div>
      <div class="page-meta">
        <button id="theme-toggle" class="theme-toggle" type="button" aria-pressed="false">Dark mode</button>
        <span id="freshness-indicator" class="freshness" aria-live="polite"></span>
        <span id="refresh-countdown" class="countdown" aria-live="polite"></span>
      </div>
    </div>

    <!-- Main -->
    <main class="main">

      <!-- KPI Cards -->
      <section class="section" aria-label="Key performance indicators">
        <div class="section-header">
          <h2 class="section-title">Overview</h2>
          <span class="section-badge" id="task-count-badge">0 tasks</span>
        </div>
        <div class="kpi-grid">
          <div class="kpi-card" data-metric="tasks-completed">
            <div class="kpi-label">Tasks Completed<span class="info-icon" data-tooltip="Total tasks shipped as merged PRs in the selected period" tabindex="0" aria-label="Total tasks shipped as merged PRs in the selected period">i</span></div>
            <div class="kpi-value" id="kpi-tasks"><span class="skeleton">&nbsp;</span></div>
            <div class="kpi-meta">shipwright_task_completed events</div>
          </div>
          <div class="kpi-card" data-metric="ci-first-pass">
            <div class="kpi-label">CI First-Pass Rate<span class="info-icon" data-tooltip="% of CI gate runs that passed without any fix attempts" tabindex="0" aria-label="% of CI gate runs that passed without any fix attempts">i</span></div>
            <div class="kpi-value" id="kpi-ci-rate"><span class="skeleton">&nbsp;</span></div>
            <div class="kpi-meta">passed_first_try / total gates</div>
          </div>
          <div class="kpi-card" data-metric="shipwright-prs-merged">
            <div class="kpi-label">Shipwright PRs Merged<span class="info-icon" data-tooltip="PRs authored by Shipwright that were merged in the selected period" tabindex="0" aria-label="PRs authored by Shipwright that were merged in the selected period">i</span></div>
            <div class="kpi-value" id="kpi-shipwright-prs"><span class="skeleton">&nbsp;</span></div>
            <div class="kpi-meta">origin=shipwright, state=merged</div>
          </div>
          <div class="kpi-card" data-metric="review-ship-it">
            <div class="kpi-label">Review SHIP IT Rate<span class="info-icon" data-tooltip="% of code reviews that received an immediate ship-it verdict" tabindex="0" aria-label="% of code reviews that received an immediate ship-it verdict">i</span></div>
            <div class="kpi-value" id="kpi-review-rate"><span class="skeleton">&nbsp;</span></div>
            <div class="kpi-meta">SHIP IT / total reviews</div>
          </div>
        </div>
      </section>

      <!-- Merged PRs by repo -->
      <section class="section" aria-label="Merged PRs by repo">
        <div class="section-header">
          <h2 class="section-title">Merged PRs by repo</h2>
        </div>
        <div id="merged-prs-content">
          <div class="merged-prs-repo-picker" id="merged-prs-repo-picker" style="display:none">
            <label for="merged-prs-repo-select">Repo</label>
            <select id="merged-prs-repo-select"></select>
          </div>
          <div class="merged-prs-charts">
            <div class="chart-container">
              <canvas id="merged-prs-bar-chart" aria-label="Merged PRs by repo and origin"></canvas>
            </div>
            <div class="chart-container">
              <canvas id="merged-prs-trend-chart" aria-label="Merged PRs trend by origin over time"></canvas>
            </div>
          </div>
        </div>
        <p id="merged-prs-empty" class="empty-state" style="display:none">No merged PRs in this range</p>
      </section>

      <!-- Coverage by repo -->
      <section class="section" id="coverage-section" aria-label="Coverage by repo">
        <div class="section-header">
          <h2 class="section-title">Coverage by repo</h2>
        </div>
        <div id="coverage-content">
          <div class="coverage-table-wrapper">
            <table class="token-table" id="coverage-repo-table">
              <thead>
                <tr>
                  <th>Repo</th>
                  <th>Lines %</th>
                  <th>Change<span class="info-icon" data-tooltip="Line-coverage change versus the repo's previous snapshot, in percentage points" tabindex="0" aria-label="Line-coverage change versus the repo's previous snapshot, in percentage points">i</span></th>
                  <th>Last measured<span class="info-icon" data-tooltip="Rows measured more than 14 days ago are marked stale" tabindex="0" aria-label="Rows measured more than 14 days ago are marked stale">i</span></th>
                </tr>
              </thead>
              <tbody id="coverage-tbody"></tbody>
            </table>
          </div>
          <div class="merged-prs-repo-picker" id="coverage-repo-picker" style="display:none">
            <label for="coverage-repo-select">Repo</label>
            <select id="coverage-repo-select"></select>
          </div>
          <div class="chart-container">
            <canvas id="coverage-trend-chart" aria-label="Line coverage trend by repo, one point per snapshot"></canvas>
          </div>
          <p id="coverage-trend-empty" class="empty-state" style="display:none">No coverage snapshots in the selected date range. Pick a wider range to see the trend.</p>
        </div>
        <p id="coverage-empty" class="empty-state" style="display:none">No coverage snapshots yet. A repo starts reporting when its CI posts a coverage report to the task store (POST /coverage-snapshots with repo, commitSha, and line/branch/function counts); it then appears here with its next snapshot.</p>
      </section>

      <!-- System crons -->
      <section class="section" id="system-crons-section" aria-label="System crons">
        <div class="section-header">
          <h2 class="section-title">System crons</h2>
          <span class="section-badge" id="system-crons-meta"></span>
        </div>
        <div id="system-crons-content">
          <table class="token-table" id="system-crons-table">
            <thead>
              <tr>
                <th>Cron</th>
                <th>Shipped<span class="info-icon" data-tooltip="Tasks the cron created that reached a merged PR (or merged/deployed/released status) in this range" tabindex="0" aria-label="Tasks the cron created that reached a merged PR (or merged/deployed/released status) in this range">i</span></th>
                <th>Stuck<span class="info-icon" data-tooltip="Blocked, or PR open for 24h or more" tabindex="0" aria-label="Blocked, or PR open for 24h or more">i</span></th>
                <th>Failed<span class="info-icon" data-tooltip="Cancelled tasks" tabindex="0" aria-label="Cancelled tasks">i</span></th>
                <th>Follow-ons<span class="info-icon" data-tooltip="Cron-origin tasks not created by the cron itself: created / shipped" tabindex="0" aria-label="Cron-origin tasks not created by the cron itself: created / shipped">i</span></th>
                <th>Other<span class="info-icon" data-tooltip="No-op (done without a PR), in flight (PR open under 24h), pending" tabindex="0" aria-label="No-op (done without a PR), in flight (PR open under 24h), pending">i</span></th>
              </tr>
            </thead>
            <tbody id="system-crons-tbody"></tbody>
          </table>
        </div>
        <p id="system-crons-empty" class="empty-state" style="display:none">No system crons are registered for this account.</p>
      </section>

      <!-- Pipeline Quality -->
      <section class="section" aria-label="Pipeline quality">
        <div class="section-header">
          <h2 class="section-title">Pipeline Quality</h2>
        </div>
        <div class="quality-grid">

          <!-- CI Gates -->
          <div class="quality-panel">
            <h3 class="panel-title">CI Gates</h3>
            <div class="stat-row" data-metric="ci-gates">
              <span class="stat-label">Total gates<span class="info-icon" data-tooltip="Total CI runs triggered by PRs in the period" tabindex="0" aria-label="Total CI runs triggered by PRs in the period">i</span></span>
              <span class="stat-value" id="ci-total">--</span>
            </div>
            <div class="stat-row" data-metric="ci-first-pass-count">
              <span class="stat-label">First-pass<span class="info-icon" data-tooltip="CI runs that passed without any fix commits" tabindex="0" aria-label="CI runs that passed without any fix commits">i</span></span>
              <span class="stat-value" id="ci-first">--</span>
            </div>
            <div class="stat-row" data-metric="avg-fix-attempts">
              <span class="stat-label">Avg fix attempts<span class="info-icon" data-tooltip="Mean number of fix commits needed before CI passed" tabindex="0" aria-label="Mean number of fix commits needed before CI passed">i</span></span>
              <span class="stat-value" id="ci-fix-avg">--</span>
            </div>
          </div>

          <!-- Simplify -->
          <div class="quality-panel">
            <h3 class="panel-title">Simplify Fixes</h3>
            <div class="stat-row" data-metric="simplify-total">
              <span class="stat-label">Total fixes<span class="info-icon" data-tooltip="Code simplifications applied automatically after implementation" tabindex="0" aria-label="Code simplifications applied automatically after implementation">i</span></span>
              <span class="stat-value" id="simplify-total">--</span>
            </div>
            <div class="simplify-breakdown" id="simplify-breakdown">
              <div class="bar-item" data-metric="simplify-dry"><span class="bar-label">DRY<span class="info-icon" data-tooltip="Duplicated code extractions applied" tabindex="0" aria-label="Duplicated code extractions applied">i</span></span><div class="bar-track"><div class="bar-fill" id="bar-dry"></div></div><span class="bar-val" id="val-dry">--</span></div>
              <div class="bar-item" data-metric="simplify-dead"><span class="bar-label">Dead code<span class="info-icon" data-tooltip="Unused imports, variables, or functions removed" tabindex="0" aria-label="Unused imports, variables, or functions removed">i</span></span><div class="bar-track"><div class="bar-fill" id="bar-dead"></div></div><span class="bar-val" id="val-dead">--</span></div>
              <div class="bar-item" data-metric="simplify-naming"><span class="bar-label">Naming<span class="info-icon" data-tooltip="Variable and function name improvements applied" tabindex="0" aria-label="Variable and function name improvements applied">i</span></span><div class="bar-track"><div class="bar-fill" id="bar-naming"></div></div><span class="bar-val" id="val-naming">--</span></div>
              <div class="bar-item" data-metric="simplify-complexity"><span class="bar-label">Complexity<span class="info-icon" data-tooltip="Over-engineered patterns simplified" tabindex="0" aria-label="Over-engineered patterns simplified">i</span></span><div class="bar-track"><div class="bar-fill" id="bar-complexity"></div></div><span class="bar-val" id="val-complexity">--</span></div>
              <div class="bar-item" data-metric="simplify-consistency"><span class="bar-label">Consistency<span class="info-icon" data-tooltip="Style or pattern inconsistencies corrected" tabindex="0" aria-label="Style or pattern inconsistencies corrected">i</span></span><div class="bar-track"><div class="bar-fill" id="bar-consistency"></div></div><span class="bar-val" id="val-consistency">--</span></div>
            </div>
          </div>

          <!-- Reviews -->
          <div class="quality-panel">
            <h3 class="panel-title">Reviews</h3>
            <div class="stat-row" data-metric="reviews-total">
              <span class="stat-label">Total reviews<span class="info-icon" data-tooltip="Code reviews run by the shipwright review agent" tabindex="0" aria-label="Code reviews run by the shipwright review agent">i</span></span>
              <span class="stat-value" id="review-total">--</span>
            </div>
            <div class="stat-row" data-metric="reviews-ship-it">
              <span class="stat-label">SHIP IT<span class="info-icon" data-tooltip="Reviews where no blocking issues were found" tabindex="0" aria-label="Reviews where no blocking issues were found">i</span></span>
              <span class="stat-value good" id="review-ship-it">--</span>
            </div>
            <div class="stat-row" data-metric="review-iterations">
              <span class="stat-label">Review Iterations<span class="info-icon" data-tooltip="Avg review + patch cycles per PR — an iteration-count proxy, not a findings count" tabindex="0" aria-label="Avg review + patch cycles per PR — an iteration-count proxy, not a findings count">i</span></span>
              <span class="stat-value" id="review-iterations">--</span>
            </div>
          </div>

          <!-- Coverage -->
          <div class="quality-panel">
            <h3 class="panel-title">Coverage</h3>
            <div class="stat-row">
              <span class="stat-label">Reports<span class="info-icon" data-tooltip="Tasks with a measured coverage delta" tabindex="0" aria-label="Tasks with a measured coverage delta">i</span></span>
              <span class="stat-value" id="coverage-reports">--</span>
            </div>
            <div class="stat-row">
              <span class="stat-label">Avg delta<span class="info-icon" data-tooltip="Mean change in line coverage % across all reports" tabindex="0" aria-label="Mean change in line coverage % across all reports">i</span></span>
              <span class="stat-value" id="coverage-delta">--</span>
            </div>
          </div>

          <!-- PR Commits -->
          <div class="quality-panel">
            <h3 class="panel-title">PR Commits</h3>
            <div class="stat-row" data-metric="pr-commits-total">
              <span class="stat-label">Avg per PR<span class="info-icon" data-tooltip="Fleet-wide weighted-average commits per Shipwright PR" tabindex="0" aria-label="Fleet-wide weighted-average commits per Shipwright PR">i</span></span>
              <span class="stat-value" id="pr-commits-total">--</span>
            </div>
            <div class="pr-commits-breakdown" id="pr-commits-breakdown">
              <div class="bar-item" data-metric="pr-commits-docs-refresh"><span class="bar-label">Docs refresh<span class="info-icon" data-tooltip="Avg commits for documentation updates" tabindex="0" aria-label="Avg commits for documentation updates">i</span></span><div class="bar-track"><div class="bar-fill" id="bar-pr-commits-docs-refresh"></div></div><span class="bar-val" id="val-pr-commits-docs-refresh">--</span></div>
              <div class="bar-item" data-metric="pr-commits-review-patch"><span class="bar-label">Review patch<span class="info-icon" data-tooltip="Avg commits for review feedback changes" tabindex="0" aria-label="Avg commits for review feedback changes">i</span></span><div class="bar-track"><div class="bar-fill" id="bar-pr-commits-review-patch"></div></div><span class="bar-val" id="val-pr-commits-review-patch">--</span></div>
              <div class="bar-item" data-metric="pr-commits-ci-fix"><span class="bar-label">CI fix<span class="info-icon" data-tooltip="Avg commits for CI gate fixes" tabindex="0" aria-label="Avg commits for CI gate fixes">i</span></span><div class="bar-track"><div class="bar-fill" id="bar-pr-commits-ci-fix"></div></div><span class="bar-val" id="val-pr-commits-ci-fix">--</span></div>
              <div class="bar-item" data-metric="pr-commits-implementation"><span class="bar-label">Implementation<span class="info-icon" data-tooltip="Avg commits for implementation work" tabindex="0" aria-label="Avg commits for implementation work">i</span></span><div class="bar-track"><div class="bar-fill" id="bar-pr-commits-implementation"></div></div><span class="bar-val" id="val-pr-commits-implementation">--</span></div>
            </div>
          </div>

        </div>
      </section>

      <!-- Token Usage -->
      <section class="section" aria-label="Token usage">
        <div class="section-header">
          <h2 class="section-title">Token Usage</h2>
        </div>
        <div class="token-kpi-row">
          <div class="kpi-card" data-metric="token-input">
            <div class="kpi-label">Input Tokens</div>
            <div class="kpi-value" id="token-input"><span class="skeleton">&nbsp;</span></div>
            <div class="kpi-meta">total input tokens</div>
          </div>
          <div class="kpi-card" data-metric="token-output">
            <div class="kpi-label">Output Tokens</div>
            <div class="kpi-value" id="token-output"><span class="skeleton">&nbsp;</span></div>
            <div class="kpi-meta">total output tokens</div>
          </div>
          <div class="kpi-card" data-metric="token-cache">
            <div class="kpi-label">Cache Tokens</div>
            <div class="kpi-value" id="token-cache"><span class="skeleton">&nbsp;</span></div>
            <div class="kpi-meta">cache read + creation</div>
          </div>
          <div class="kpi-card" data-metric="token-cost">
            <div class="kpi-label">Total Cost</div>
            <div class="kpi-value" id="token-cost"><span class="skeleton">&nbsp;</span></div>
            <div class="kpi-meta">total cost (USD)</div>
          </div>
        </div>
        <div class="quality-panel">
          <h3 class="panel-title">By Agent</h3>
          <table class="token-table" id="token-agent-table">
            <thead>
              <tr><th>Agent</th><th>Cron</th><th>DM/Mention</th><th>Total</th><th>Cost ($)</th></tr>
            </thead>
            <tbody id="token-agent-tbody"></tbody>
          </table>
          <p id="token-agent-empty" class="empty-state" style="display:none">No data</p>
        </div>
        <div class="token-trends-section">
          <div class="token-trends-toggles" role="group" aria-label="Token series">
            <button class="token-series-btn active" data-token-series="input" type="button">Input</button>
            <button class="token-series-btn" data-token-series="output" type="button">Output</button>
            <button class="token-series-btn" data-token-series="total" type="button">Total</button>
            <button class="token-series-btn" data-token-series="all" type="button">All</button>
          </div>
          <div class="chart-container token-trends-chart-container">
            <canvas id="token-trends-chart" aria-label="Token usage trends chart"></canvas>
          </div>
        </div>
      </section>



      <!-- Feature Breakdown -->
      <section class="section features-section" aria-label="Feature breakdown">
        <div class="section-header">
          <h2 class="section-title">Feature Breakdown</h2>
        </div>
        <div class="features-table-wrapper">
          <table class="features-table">
            <thead>
              <tr>
                <th>Feature<span class="info-icon" data-tooltip="Planning session or feature group name" tabindex="0" aria-label="Planning session or feature group name">i</span></th>
                <th>Tasks<span class="info-icon" data-tooltip="Number of tasks shipped in this feature" tabindex="0" aria-label="Number of tasks shipped in this feature">i</span></th>
                <th>Avg Hrs<span class="info-icon" data-tooltip="Mean actual hours per task" tabindex="0" aria-label="Mean actual hours per task">i</span></th>
                <th>CI Pass<span class="info-icon" data-tooltip="CI first-pass rate for this feature's tasks" tabindex="0" aria-label="CI first-pass rate for this feature's tasks">i</span></th>
                <th>Review<span class="info-icon" data-tooltip="SHIP IT rate for this feature's tasks" tabindex="0" aria-label="SHIP IT rate for this feature's tasks">i</span></th>
              </tr>
            </thead>
            <tbody id="features-tbody"></tbody>
          </table>
        </div>
        <p id="features-empty" class="empty-state" style="display:none">No feature data for this period</p>
      </section>

      <!-- Efficiency -->
      <section class="section" aria-label="Efficiency">
        <div class="section-header">
          <h2 class="section-title">Efficiency</h2>
        </div>
        <div class="efficiency-grid">
          <div class="stat-block" data-metric="avg-actual-hours">
            <span class="stat-block-value" id="eff-avg-hours">--</span>
            <span class="stat-block-label">Avg actual hours<span class="info-icon" data-tooltip="Mean wall-clock hours per task from start to PR merge" tabindex="0" aria-label="Mean wall-clock hours per task from start to PR merge">i</span></span>
          </div>
          <div class="stat-block" data-metric="avg-estimated-hours">
            <span class="stat-block-value" id="eff-est-hours">--</span>
            <span class="stat-block-label">Avg estimated hours<span class="info-icon" data-tooltip="Mean planned hours per task from the planning doc" tabindex="0" aria-label="Mean planned hours per task from the planning doc">i</span></span>
          </div>
          <div class="stat-block" data-metric="avg-retries">
            <span class="stat-block-value" id="eff-retries">--</span>
            <span class="stat-block-label">Avg retries<span class="info-icon" data-tooltip="Mean CI fix attempts needed before the CI gate passed" tabindex="0" aria-label="Mean CI fix attempts needed before the CI gate passed">i</span></span>
          </div>
          <div class="stat-block" data-metric="avg-files-changed">
            <span class="stat-block-value" id="eff-files">--</span>
            <span class="stat-block-label">Avg files changed<span class="info-icon" data-tooltip="Mean files modified per task" tabindex="0" aria-label="Mean files modified per task">i</span></span>
          </div>
        </div>
      </section>

      <!-- Trends -->
      <section class="section" aria-label="Trends">
        <div class="section-header">
          <h2 class="section-title">Trends</h2>
        </div>
        <div class="chart-container">
          <canvas id="trends-chart" aria-label="Pipeline trends chart"></canvas>
        </div>
      </section>

    </main>

    <!-- Metric Graph Modal -->
    <div id="metric-modal" class="metric-modal" role="dialog" aria-modal="true" aria-labelledby="metric-modal-title" hidden>
      <div class="metric-modal-backdrop"></div>
      <div class="metric-modal-box">
        <div class="metric-modal-header">
          <h3 class="metric-modal-title" id="metric-modal-title">Metric</h3>
          <button class="metric-modal-close" type="button" aria-label="Close modal">×</button>
        </div>
        <div class="metric-modal-body">
          <canvas id="metric-chart" aria-label="Metric trend chart"></canvas>
        </div>
      </div>
    </div>

  </div>

  <script>window.__METRICS_BASE__ = ""; window.__ADMIN_BASE__ = "";</script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
  <script src="/dashboard/app.js"></script>
</body>
</html>"
`;

exports[`renderDashboardPage — snapshot renders full page for an owner 1`] = `
"<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="light dark" />
  <title>Metrics — Vitals OS</title>
  <script>(function(){var t="light";try{var s=localStorage.getItem("shipwright-theme");if(s==="dark"||s==="light"){t=s}else if(window.matchMedia&&window.matchMedia("(prefers-color-scheme: dark)").matches){t="dark"}}catch(e){}document.documentElement.setAttribute("data-theme",t)})();</script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root { color-scheme: light; --vos-bg: #f7f7fb; --vos-surface: #ffffff; --vos-surface-muted: #f9fafb; --vos-surface-subtle: #f3f4f6; --vos-border: #e8e8ee; --vos-border-strong: #d1d5db; --vos-text: #1a1a2e; --vos-text-body: #374151; --vos-text-muted: #6b7280; --vos-text-faint: #9ca3af; --vos-brand: #4f46e5; --vos-brand-strong: #4338ca; --vos-brand-bg: #eef2ff; --vos-brand-border: #c7d2fe; --vos-on-brand: #ffffff; --vos-primary: #1a1a2e; --vos-primary-hover: #2d2d4e; --vos-primary-text: #ffffff; --vos-success-bg: #d1fae5; --vos-success-text: #065f46; --vos-success-border: #a7f3d0; --vos-warning-bg: #fef3c7; --vos-warning-text: #92400e; --vos-warning-border: #fde68a; --vos-danger: #dc2626; --vos-danger-text: #b91c1c; --vos-danger-bg: #fee2e2; --vos-danger-border: #fecaca; --vos-info-bg: #dbeafe; --vos-info-text: #1e40af; --vos-info-border: #93c5fd; --vos-violet-bg: #ede9fe; --vos-violet-text: #5b21b6; --vos-teal-bg: #ccfbf1; --vos-teal-text: #0f766e; }
    :root[data-theme="dark"] { color-scheme: dark; --vos-bg: #0f1117; --vos-surface: #171a22; --vos-surface-muted: #1b1f29; --vos-surface-subtle: #1f2330; --vos-border: #2a2f3d; --vos-border-strong: #3a4052; --vos-text: #e6e8ef; --vos-text-body: #c9cdd8; --vos-text-muted: #a3a9b8; --vos-text-faint: #8891a3; --vos-brand: #818cf8; --vos-brand-strong: #a5b4fc; --vos-brand-bg: #23264a; --vos-brand-border: #3b3f7a; --vos-on-brand: #0f1117; --vos-primary: #e6e8ef; --vos-primary-hover: #ffffff; --vos-primary-text: #0f1117; --vos-success-bg: #0f2e1d; --vos-success-text: #86efac; --vos-success-border: #14532d; --vos-warning-bg: #3a2a0c; --vos-warning-text: #fcd34d; --vos-warning-border: #78350f; --vos-danger: #f87171; --vos-danger-text: #fca5a5; --vos-danger-bg: #3b1518; --vos-danger-border: #7f1d1d; --vos-info-bg: #16264a; --vos-info-text: #93c5fd; --vos-info-border: #1e3a8a; --vos-violet-bg: #2a1f4d; --vos-violet-text: #c4b5fd; --vos-teal-bg: #0f2f2c; --vos-teal-text: #5eead4; }
    :root[data-theme="dark"] textarea, :root[data-theme="dark"] select, :root[data-theme="dark"] input:not([type="checkbox"]):not([type="radio"]):not([type="range"]) { background-color: var(--vos-surface); color: var(--vos-text); }
    html { font-size: 16px; -webkit-font-smoothing: antialiased; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background: var(--vos-bg);
      color: var(--vos-text);
      min-height: 100vh;
    }

    /* ─── Toolbar ───────────────────────────────────────── */
    .vos-toolbar {
      background: var(--vos-surface);
      border-bottom: 1px solid var(--vos-border);
      height: 52px;
      display: flex;
      align-items: center;
      padding: 0 24px;
      gap: 24px;
      position: sticky;
      top: 0;
      z-index: 100;
    }
    .vos-wordmark {
      font-size: 15px;
      font-weight: 700;
      color: var(--vos-text);
      text-decoration: none;
      letter-spacing: -0.3px;
      flex-shrink: 0;
    }
    .vos-wordmark:hover { color: var(--vos-brand); }
    .vos-nav {
      display: flex;
      align-items: center;
      gap: 4px;
      flex: 1;
    }
    .vos-nav-link {
      padding: 5px 12px;
      border-radius: 6px;
      font-size: 13px;
      font-weight: 500;
      color: var(--vos-text-muted);
      text-decoration: none;
      transition: background 0.1s, color 0.1s;
      white-space: nowrap;
    }
    .vos-nav-link:hover { background: var(--vos-surface-subtle); color: var(--vos-text); }
    .vos-nav-link.active {
      background: var(--vos-brand-bg);
      color: var(--vos-brand);
      font-weight: 600;
    }
    .vos-user {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-shrink: 0;
      margin-left: auto;
    }
    .vos-username {
      font-size: 13px;
      color: var(--vos-text-muted);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 160px;
    }
    .vos-signout-btn {
      font-size: 13px;
      font-weight: 500;
      color: var(--vos-text-muted);
      background: none;
      border: 1px solid var(--vos-border);
      border-radius: 6px;
      padding: 5px 12px;
      cursor: pointer;
      font-family: inherit;
      transition: background 0.1s, color 0.1s, border-color 0.1s;
      white-space: nowrap;
    }
    .vos-signout-btn:hover { background: var(--vos-bg); color: var(--vos-text); border-color: var(--vos-border-strong); }

    /* ─── Page body ─────────────────────────────────────── */
    .vos-theme-toggle {
      font-size: 13px;
      font-weight: 500;
      color: var(--vos-text-muted);
      background: none;
      border: 1px solid var(--vos-border);
      border-radius: 6px;
      padding: 5px 12px;
      min-height: 28px;
      cursor: pointer;
      white-space: nowrap;
      transition: background 0.1s, color 0.1s, border-color 0.1s;
    }
    .vos-theme-toggle:hover { background: var(--vos-bg); color: var(--vos-text); border-color: var(--vos-border-strong); }
    .vos-theme-toggle[aria-pressed="true"] { background: var(--vos-brand-bg); color: var(--vos-brand); border-color: var(--vos-brand-border); }
    .vos-page {
      max-width: 960px;
      margin: 0 auto;
      padding: 32px 24px 64px;
    }
    .vos-page-wide { max-width: none; width: 100%; }

    /* ─── Hamburger toggle (CSS-only, no JS) ───────────── */
    .vos-nav-toggle { display: none; }
    .vos-hamburger {
      display: none;
      background: none;
      border: none;
      font-size: 20px;
      cursor: pointer;
      color: var(--vos-text);
      padding: 4px 8px;
      line-height: 1;
      font-family: inherit;
    }
    .vos-hamburger:hover { color: var(--vos-brand); }

    @media (max-width: 640px) {
      .vos-toolbar { padding: 0 16px; gap: 12px; flex-wrap: wrap; height: auto; min-height: 52px; align-items: center; }
      .vos-username { display: none; }
      .vos-nav-link { padding: 5px 8px; }
      .vos-page { padding: 20px 16px 48px; }

      /* Hide nav links by default on mobile */
      .vos-nav {
        display: none;
        flex-direction: column;
        width: 100%;
        gap: 2px;
        padding: 8px 0;
        order: 3;
      }
      /* Show nav links when hamburger checkbox is checked */
      .vos-nav-toggle:checked + nav .vos-nav {
        display: flex;
      }
      .vos-nav-link {
        display: block;
        padding: 10px 12px;
        border-radius: 6px;
        font-size: 14px;
      }
      .vos-nav-link.active {
        background: var(--vos-brand-bg);
        color: var(--vos-brand);
        font-weight: 600;
      }
      /* Show hamburger on mobile */
      .vos-hamburger {
        display: block;
      }
      /* Hide user section sign-out on mobile when nav is closed */
      .vos-user {
        order: 2;
        margin-left: 0;
      }
    }

  </style>
  <link rel="stylesheet" href="/dashboard/styles.css" />
</head>
<body>
  <input type="checkbox" id="vos-nav-toggle" class="vos-nav-toggle" aria-hidden="true">
  <nav class="vos-toolbar" aria-label="Site navigation">
    <a href="/admin/agents" class="vos-wordmark">Shipwright</a>
    <div id="vos-nav-content" class="vos-nav">
      <a href="/admin/agents" class="vos-nav-link">Agents</a>
      <a href="/admin/tasks" class="vos-nav-link">Tasks</a>
      <a href="/admin/sessions" class="vos-nav-link">Sessions</a>
      <a href="/admin/prs" class="vos-nav-link">PRs</a>
      <a href="/admin/chat" class="vos-nav-link">Chat</a>
      <a href="/admin/queue-activity" class="vos-nav-link">Queue &amp; Activity</a>
      <a href="/dashboard" class="vos-nav-link active">Metrics</a>
    </div>
    <div class="vos-user">
      <span class="vos-username">Alice</span>
      <button type="button" id="vos-theme-toggle" class="vos-theme-toggle" aria-pressed="false">Dark mode</button>
      <form method="POST" action="/admin/logout" style="margin:0">
        <button type="submit" class="vos-signout-btn">Sign out</button>
      </form>
    </div>
    <label for="vos-nav-toggle" class="vos-hamburger" aria-label="Toggle navigation" aria-expanded="false" aria-controls="vos-nav-content">☰</label>
  </nav>
  <script>(function(){var t=document.getElementById('vos-nav-toggle');if(t)t.addEventListener('change',function(){var l=document.querySelector('label[for="vos-nav-toggle"]');if(l)l.setAttribute('aria-expanded',t.checked?'true':'false');});})();</script>
  <script>(function(){var d=document,r=d.documentElement,k="shipwright-theme",q=window.matchMedia?window.matchMedia("(prefers-color-scheme: dark)"):null;function saved(){try{var s=localStorage.getItem(k);return s==="dark"||s==="light"?s:null}catch(e){return null}}function apply(t){r.setAttribute("data-theme",t);var b=d.getElementById("vos-theme-toggle");if(b)b.setAttribute("aria-pressed",t==="dark"?"true":"false");d.dispatchEvent(new CustomEvent("vos-theme-change",{detail:{theme:t}}))}apply(saved()||(q&&q.matches?"dark":"light"));var b=d.getElementById("vos-theme-toggle");if(b)b.addEventListener("click",function(){var t=r.getAttribute("data-theme")==="dark"?"light":"dark";try{localStorage.setItem(k,t)}catch(e){}apply(t)});if(q&&q.addEventListener)q.addEventListener("change",function(e){if(!saved())apply(e.matches?"dark":"light")})})();</script>
  <div class="app">

    <!-- Page Controls -->
    <div class="page-controls">
      <div class="date-range-picker" role="group" aria-label="Date range">
        <button class="date-btn active" data-range="today" type="button">1D</button>
        <button class="date-btn" data-range="7d" type="button">7D</button>
        <button class="date-btn" data-range="30d" type="button">30D</button>
        <button class="date-btn" data-range="90d" type="button">90D</button>
      </div>
      <div class="page-meta">
        <button id="theme-toggle" class="theme-toggle" type="button" aria-pressed="false">Dark mode</button>
        <span id="freshness-indicator" class="freshness" aria-live="polite"></span>
        <span id="refresh-countdown" class="countdown" aria-live="polite"></span>
      </div>
    </div>

    <!-- Main -->
    <main class="main">

      <!-- KPI Cards -->
      <section class="section" aria-label="Key performance indicators">
        <div class="section-header">
          <h2 class="section-title">Overview</h2>
          <span class="section-badge" id="task-count-badge">0 tasks</span>
        </div>
        <div class="kpi-grid">
          <div class="kpi-card" data-metric="tasks-completed">
            <div class="kpi-label">Tasks Completed<span class="info-icon" data-tooltip="Total tasks shipped as merged PRs in the selected period" tabindex="0" aria-label="Total tasks shipped as merged PRs in the selected period">i</span></div>
            <div class="kpi-value" id="kpi-tasks"><span class="skeleton">&nbsp;</span></div>
            <div class="kpi-meta">shipwright_task_completed events</div>
          </div>
          <div class="kpi-card" data-metric="ci-first-pass">
            <div class="kpi-label">CI First-Pass Rate<span class="info-icon" data-tooltip="% of CI gate runs that passed without any fix attempts" tabindex="0" aria-label="% of CI gate runs that passed without any fix attempts">i</span></div>
            <div class="kpi-value" id="kpi-ci-rate"><span class="skeleton">&nbsp;</span></div>
            <div class="kpi-meta">passed_first_try / total gates</div>
          </div>
          <div class="kpi-card" data-metric="shipwright-prs-merged">
            <div class="kpi-label">Shipwright PRs Merged<span class="info-icon" data-tooltip="PRs authored by Shipwright that were merged in the selected period" tabindex="0" aria-label="PRs authored by Shipwright that were merged in the selected period">i</span></div>
            <div class="kpi-value" id="kpi-shipwright-prs"><span class="skeleton">&nbsp;</span></div>
            <div class="kpi-meta">origin=shipwright, state=merged</div>
          </div>
          <div class="kpi-card" data-metric="review-ship-it">
            <div class="kpi-label">Review SHIP IT Rate<span class="info-icon" data-tooltip="% of code reviews that received an immediate ship-it verdict" tabindex="0" aria-label="% of code reviews that received an immediate ship-it verdict">i</span></div>
            <div class="kpi-value" id="kpi-review-rate"><span class="skeleton">&nbsp;</span></div>
            <div class="kpi-meta">SHIP IT / total reviews</div>
          </div>
        </div>
      </section>

      <!-- Merged PRs by repo -->
      <section class="section" aria-label="Merged PRs by repo">
        <div class="section-header">
          <h2 class="section-title">Merged PRs by repo</h2>
        </div>
        <div id="merged-prs-content">
          <div class="merged-prs-repo-picker" id="merged-prs-repo-picker" style="display:none">
            <label for="merged-prs-repo-select">Repo</label>
            <select id="merged-prs-repo-select"></select>
          </div>
          <div class="merged-prs-charts">
            <div class="chart-container">
              <canvas id="merged-prs-bar-chart" aria-label="Merged PRs by repo and origin"></canvas>
            </div>
            <div class="chart-container">
              <canvas id="merged-prs-trend-chart" aria-label="Merged PRs trend by origin over time"></canvas>
            </div>
          </div>
        </div>
        <p id="merged-prs-empty" class="empty-state" style="display:none">No merged PRs in this range</p>
      </section>

      <!-- Coverage by repo -->
      <section class="section" id="coverage-section" aria-label="Coverage by repo">
        <div class="section-header">
          <h2 class="section-title">Coverage by repo</h2>
        </div>
        <div id="coverage-content">
          <div class="coverage-table-wrapper">
            <table class="token-table" id="coverage-repo-table">
              <thead>
                <tr>
                  <th>Repo</th>
                  <th>Lines %</th>
                  <th>Change<span class="info-icon" data-tooltip="Line-coverage change versus the repo's previous snapshot, in percentage points" tabindex="0" aria-label="Line-coverage change versus the repo's previous snapshot, in percentage points">i</span></th>
                  <th>Last measured<span class="info-icon" data-tooltip="Rows measured more than 14 days ago are marked stale" tabindex="0" aria-label="Rows measured more than 14 days ago are marked stale">i</span></th>
                </tr>
              </thead>
              <tbody id="coverage-tbody"></tbody>
            </table>
          </div>
          <div class="merged-prs-repo-picker" id="coverage-repo-picker" style="display:none">
            <label for="coverage-repo-select">Repo</label>
            <select id="coverage-repo-select"></select>
          </div>
          <div class="chart-container">
            <canvas id="coverage-trend-chart" aria-label="Line coverage trend by repo, one point per snapshot"></canvas>
          </div>
          <p id="coverage-trend-empty" class="empty-state" style="display:none">No coverage snapshots in the selected date range. Pick a wider range to see the trend.</p>
        </div>
        <p id="coverage-empty" class="empty-state" style="display:none">No coverage snapshots yet. A repo starts reporting when its CI posts a coverage report to the task store (POST /coverage-snapshots with repo, commitSha, and line/branch/function counts); it then appears here with its next snapshot.</p>
      </section>

      <!-- System crons -->
      <section class="section" id="system-crons-section" aria-label="System crons">
        <div class="section-header">
          <h2 class="section-title">System crons</h2>
          <span class="section-badge" id="system-crons-meta"></span>
        </div>
        <div id="system-crons-content">
          <table class="token-table" id="system-crons-table">
            <thead>
              <tr>
                <th>Cron</th>
                <th>Shipped<span class="info-icon" data-tooltip="Tasks the cron created that reached a merged PR (or merged/deployed/released status) in this range" tabindex="0" aria-label="Tasks the cron created that reached a merged PR (or merged/deployed/released status) in this range">i</span></th>
                <th>Stuck<span class="info-icon" data-tooltip="Blocked, or PR open for 24h or more" tabindex="0" aria-label="Blocked, or PR open for 24h or more">i</span></th>
                <th>Failed<span class="info-icon" data-tooltip="Cancelled tasks" tabindex="0" aria-label="Cancelled tasks">i</span></th>
                <th>Follow-ons<span class="info-icon" data-tooltip="Cron-origin tasks not created by the cron itself: created / shipped" tabindex="0" aria-label="Cron-origin tasks not created by the cron itself: created / shipped">i</span></th>
                <th>Other<span class="info-icon" data-tooltip="No-op (done without a PR), in flight (PR open under 24h), pending" tabindex="0" aria-label="No-op (done without a PR), in flight (PR open under 24h), pending">i</span></th>
              </tr>
            </thead>
            <tbody id="system-crons-tbody"></tbody>
          </table>
        </div>
        <p id="system-crons-empty" class="empty-state" style="display:none">No system crons are registered for this account.</p>
      </section>

      <!-- Pipeline Quality -->
      <section class="section" aria-label="Pipeline quality">
        <div class="section-header">
          <h2 class="section-title">Pipeline Quality</h2>
        </div>
        <div class="quality-grid">

          <!-- CI Gates -->
          <div class="quality-panel">
            <h3 class="panel-title">CI Gates</h3>
            <div class="stat-row" data-metric="ci-gates">
              <span class="stat-label">Total gates<span class="info-icon" data-tooltip="Total CI runs triggered by PRs in the period" tabindex="0" aria-label="Total CI runs triggered by PRs in the period">i</span></span>
              <span class="stat-value" id="ci-total">--</span>
            </div>
            <div class="stat-row" data-metric="ci-first-pass-count">
              <span class="stat-label">First-pass<span class="info-icon" data-tooltip="CI runs that passed without any fix commits" tabindex="0" aria-label="CI runs that passed without any fix commits">i</span></span>
              <span class="stat-value" id="ci-first">--</span>
            </div>
            <div class="stat-row" data-metric="avg-fix-attempts">
              <span class="stat-label">Avg fix attempts<span class="info-icon" data-tooltip="Mean number of fix commits needed before CI passed" tabindex="0" aria-label="Mean number of fix commits needed before CI passed">i</span></span>
              <span class="stat-value" id="ci-fix-avg">--</span>
            </div>
          </div>

          <!-- Simplify -->
          <div class="quality-panel">
            <h3 class="panel-title">Simplify Fixes</h3>
            <div class="stat-row" data-metric="simplify-total">
              <span class="stat-label">Total fixes<span class="info-icon" data-tooltip="Code simplifications applied automatically after implementation" tabindex="0" aria-label="Code simplifications applied automatically after implementation">i</span></span>
              <span class="stat-value" id="simplify-total">--</span>
            </div>
            <div class="simplify-breakdown" id="simplify-breakdown">
              <div class="bar-item" data-metric="simplify-dry"><span class="bar-label">DRY<span class="info-icon" data-tooltip="Duplicated code extractions applied" tabindex="0" aria-label="Duplicated code extractions applied">i</span></span><div class="bar-track"><div class="bar-fill" id="bar-dry"></div></div><span class="bar-val" id="val-dry">--</span></div>
              <div class="bar-item" data-metric="simplify-dead"><span class="bar-label">Dead code<span class="info-icon" data-tooltip="Unused imports, variables, or functions removed" tabindex="0" aria-label="Unused imports, variables, or functions removed">i</span></span><div class="bar-track"><div class="bar-fill" id="bar-dead"></div></div><span class="bar-val" id="val-dead">--</span></div>
              <div class="bar-item" data-metric="simplify-naming"><span class="bar-label">Naming<span class="info-icon" data-tooltip="Variable and function name improvements applied" tabindex="0" aria-label="Variable and function name improvements applied">i</span></span><div class="bar-track"><div class="bar-fill" id="bar-naming"></div></div><span class="bar-val" id="val-naming">--</span></div>
              <div class="bar-item" data-metric="simplify-complexity"><span class="bar-label">Complexity<span class="info-icon" data-tooltip="Over-engineered patterns simplified" tabindex="0" aria-label="Over-engineered patterns simplified">i</span></span><div class="bar-track"><div class="bar-fill" id="bar-complexity"></div></div><span class="bar-val" id="val-complexity">--</span></div>
              <div class="bar-item" data-metric="simplify-consistency"><span class="bar-label">Consistency<span class="info-icon" data-tooltip="Style or pattern inconsistencies corrected" tabindex="0" aria-label="Style or pattern inconsistencies corrected">i</span></span><div class="bar-track"><div class="bar-fill" id="bar-consistency"></div></div><span class="bar-val" id="val-consistency">--</span></div>
            </div>
          </div>

          <!-- Reviews -->
          <div class="quality-panel">
            <h3 class="panel-title">Reviews</h3>
            <div class="stat-row" data-metric="reviews-total">
              <span class="stat-label">Total reviews<span class="info-icon" data-tooltip="Code reviews run by the shipwright review agent" tabindex="0" aria-label="Code reviews run by the shipwright review agent">i</span></span>
              <span class="stat-value" id="review-total">--</span>
            </div>
            <div class="stat-row" data-metric="reviews-ship-it">
              <span class="stat-label">SHIP IT<span class="info-icon" data-tooltip="Reviews where no blocking issues were found" tabindex="0" aria-label="Reviews where no blocking issues were found">i</span></span>
              <span class="stat-value good" id="review-ship-it">--</span>
            </div>
            <div class="stat-row" data-metric="review-iterations">
              <span class="stat-label">Review Iterations<span class="info-icon" data-tooltip="Avg review + patch cycles per PR — an iteration-count proxy, not a findings count" tabindex="0" aria-label="Avg review + patch cycles per PR — an iteration-count proxy, not a findings count">i</span></span>
              <span class="stat-value" id="review-iterations">--</span>
            </div>
          </div>

          <!-- Coverage -->
          <div class="quality-panel">
            <h3 class="panel-title">Coverage</h3>
            <div class="stat-row">
              <span class="stat-label">Reports<span class="info-icon" data-tooltip="Tasks with a measured coverage delta" tabindex="0" aria-label="Tasks with a measured coverage delta">i</span></span>
              <span class="stat-value" id="coverage-reports">--</span>
            </div>
            <div class="stat-row">
              <span class="stat-label">Avg delta<span class="info-icon" data-tooltip="Mean change in line coverage % across all reports" tabindex="0" aria-label="Mean change in line coverage % across all reports">i</span></span>
              <span class="stat-value" id="coverage-delta">--</span>
            </div>
          </div>

          <!-- PR Commits -->
          <div class="quality-panel">
            <h3 class="panel-title">PR Commits</h3>
            <div class="stat-row" data-metric="pr-commits-total">
              <span class="stat-label">Avg per PR<span class="info-icon" data-tooltip="Fleet-wide weighted-average commits per Shipwright PR" tabindex="0" aria-label="Fleet-wide weighted-average commits per Shipwright PR">i</span></span>
              <span class="stat-value" id="pr-commits-total">--</span>
            </div>
            <div class="pr-commits-breakdown" id="pr-commits-breakdown">
              <div class="bar-item" data-metric="pr-commits-docs-refresh"><span class="bar-label">Docs refresh<span class="info-icon" data-tooltip="Avg commits for documentation updates" tabindex="0" aria-label="Avg commits for documentation updates">i</span></span><div class="bar-track"><div class="bar-fill" id="bar-pr-commits-docs-refresh"></div></div><span class="bar-val" id="val-pr-commits-docs-refresh">--</span></div>
              <div class="bar-item" data-metric="pr-commits-review-patch"><span class="bar-label">Review patch<span class="info-icon" data-tooltip="Avg commits for review feedback changes" tabindex="0" aria-label="Avg commits for review feedback changes">i</span></span><div class="bar-track"><div class="bar-fill" id="bar-pr-commits-review-patch"></div></div><span class="bar-val" id="val-pr-commits-review-patch">--</span></div>
              <div class="bar-item" data-metric="pr-commits-ci-fix"><span class="bar-label">CI fix<span class="info-icon" data-tooltip="Avg commits for CI gate fixes" tabindex="0" aria-label="Avg commits for CI gate fixes">i</span></span><div class="bar-track"><div class="bar-fill" id="bar-pr-commits-ci-fix"></div></div><span class="bar-val" id="val-pr-commits-ci-fix">--</span></div>
              <div class="bar-item" data-metric="pr-commits-implementation"><span class="bar-label">Implementation<span class="info-icon" data-tooltip="Avg commits for implementation work" tabindex="0" aria-label="Avg commits for implementation work">i</span></span><div class="bar-track"><div class="bar-fill" id="bar-pr-commits-implementation"></div></div><span class="bar-val" id="val-pr-commits-implementation">--</span></div>
            </div>
          </div>

        </div>
      </section>

      <!-- Token Usage -->
      <section class="section" aria-label="Token usage">
        <div class="section-header">
          <h2 class="section-title">Token Usage</h2>
        </div>
        <div class="token-kpi-row">
          <div class="kpi-card" data-metric="token-input">
            <div class="kpi-label">Input Tokens</div>
            <div class="kpi-value" id="token-input"><span class="skeleton">&nbsp;</span></div>
            <div class="kpi-meta">total input tokens</div>
          </div>
          <div class="kpi-card" data-metric="token-output">
            <div class="kpi-label">Output Tokens</div>
            <div class="kpi-value" id="token-output"><span class="skeleton">&nbsp;</span></div>
            <div class="kpi-meta">total output tokens</div>
          </div>
          <div class="kpi-card" data-metric="token-cache">
            <div class="kpi-label">Cache Tokens</div>
            <div class="kpi-value" id="token-cache"><span class="skeleton">&nbsp;</span></div>
            <div class="kpi-meta">cache read + creation</div>
          </div>
          <div class="kpi-card" data-metric="token-cost">
            <div class="kpi-label">Total Cost</div>
            <div class="kpi-value" id="token-cost"><span class="skeleton">&nbsp;</span></div>
            <div class="kpi-meta">total cost (USD)</div>
          </div>
        </div>
        <div class="quality-panel">
          <h3 class="panel-title">By Agent</h3>
          <table class="token-table" id="token-agent-table">
            <thead>
              <tr><th>Agent</th><th>Cron</th><th>DM/Mention</th><th>Total</th><th>Cost ($)</th></tr>
            </thead>
            <tbody id="token-agent-tbody"></tbody>
          </table>
          <p id="token-agent-empty" class="empty-state" style="display:none">No data</p>
        </div>
        <div class="token-trends-section">
          <div class="token-trends-toggles" role="group" aria-label="Token series">
            <button class="token-series-btn active" data-token-series="input" type="button">Input</button>
            <button class="token-series-btn" data-token-series="output" type="button">Output</button>
            <button class="token-series-btn" data-token-series="total" type="button">Total</button>
            <button class="token-series-btn" data-token-series="all" type="button">All</button>
          </div>
          <div class="chart-container token-trends-chart-container">
            <canvas id="token-trends-chart" aria-label="Token usage trends chart"></canvas>
          </div>
        </div>
      </section>



      <!-- Feature Breakdown -->
      <section class="section features-section" aria-label="Feature breakdown">
        <div class="section-header">
          <h2 class="section-title">Feature Breakdown</h2>
        </div>
        <div class="features-table-wrapper">
          <table class="features-table">
            <thead>
              <tr>
                <th>Feature<span class="info-icon" data-tooltip="Planning session or feature group name" tabindex="0" aria-label="Planning session or feature group name">i</span></th>
                <th>Tasks<span class="info-icon" data-tooltip="Number of tasks shipped in this feature" tabindex="0" aria-label="Number of tasks shipped in this feature">i</span></th>
                <th>Avg Hrs<span class="info-icon" data-tooltip="Mean actual hours per task" tabindex="0" aria-label="Mean actual hours per task">i</span></th>
                <th>CI Pass<span class="info-icon" data-tooltip="CI first-pass rate for this feature's tasks" tabindex="0" aria-label="CI first-pass rate for this feature's tasks">i</span></th>
                <th>Review<span class="info-icon" data-tooltip="SHIP IT rate for this feature's tasks" tabindex="0" aria-label="SHIP IT rate for this feature's tasks">i</span></th>
              </tr>
            </thead>
            <tbody id="features-tbody"></tbody>
          </table>
        </div>
        <p id="features-empty" class="empty-state" style="display:none">No feature data for this period</p>
      </section>

      <!-- Efficiency -->
      <section class="section" aria-label="Efficiency">
        <div class="section-header">
          <h2 class="section-title">Efficiency</h2>
        </div>
        <div class="efficiency-grid">
          <div class="stat-block" data-metric="avg-actual-hours">
            <span class="stat-block-value" id="eff-avg-hours">--</span>
            <span class="stat-block-label">Avg actual hours<span class="info-icon" data-tooltip="Mean wall-clock hours per task from start to PR merge" tabindex="0" aria-label="Mean wall-clock hours per task from start to PR merge">i</span></span>
          </div>
          <div class="stat-block" data-metric="avg-estimated-hours">
            <span class="stat-block-value" id="eff-est-hours">--</span>
            <span class="stat-block-label">Avg estimated hours<span class="info-icon" data-tooltip="Mean planned hours per task from the planning doc" tabindex="0" aria-label="Mean planned hours per task from the planning doc">i</span></span>
          </div>
          <div class="stat-block" data-metric="avg-retries">
            <span class="stat-block-value" id="eff-retries">--</span>
            <span class="stat-block-label">Avg retries<span class="info-icon" data-tooltip="Mean CI fix attempts needed before the CI gate passed" tabindex="0" aria-label="Mean CI fix attempts needed before the CI gate passed">i</span></span>
          </div>
          <div class="stat-block" data-metric="avg-files-changed">
            <span class="stat-block-value" id="eff-files">--</span>
            <span class="stat-block-label">Avg files changed<span class="info-icon" data-tooltip="Mean files modified per task" tabindex="0" aria-label="Mean files modified per task">i</span></span>
          </div>
        </div>
      </section>

      <!-- Trends -->
      <section class="section" aria-label="Trends">
        <div class="section-header">
          <h2 class="section-title">Trends</h2>
        </div>
        <div class="chart-container">
          <canvas id="trends-chart" aria-label="Pipeline trends chart"></canvas>
        </div>
      </section>

    </main>

    <!-- Metric Graph Modal -->
    <div id="metric-modal" class="metric-modal" role="dialog" aria-modal="true" aria-labelledby="metric-modal-title" hidden>
      <div class="metric-modal-backdrop"></div>
      <div class="metric-modal-box">
        <div class="metric-modal-header">
          <h3 class="metric-modal-title" id="metric-modal-title">Metric</h3>
          <button class="metric-modal-close" type="button" aria-label="Close modal">×</button>
        </div>
        <div class="metric-modal-body">
          <canvas id="metric-chart" aria-label="Metric trend chart"></canvas>
        </div>
      </div>
    </div>

  </div>

  <script>window.__METRICS_BASE__ = ""; window.__ADMIN_BASE__ = "";</script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
  <script src="/dashboard/app.js"></script>
</body>
</html>"
`;

exports[`renderDashboardPage — MG-1.2 clickable metric graphs snapshot matches after MG-1.2 changes 1`] = `
"<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="light dark" />
  <title>Metrics — Vitals OS</title>
  <script>(function(){var t="light";try{var s=localStorage.getItem("shipwright-theme");if(s==="dark"||s==="light"){t=s}else if(window.matchMedia&&window.matchMedia("(prefers-color-scheme: dark)").matches){t="dark"}}catch(e){}document.documentElement.setAttribute("data-theme",t)})();</script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root { color-scheme: light; --vos-bg: #f7f7fb; --vos-surface: #ffffff; --vos-surface-muted: #f9fafb; --vos-surface-subtle: #f3f4f6; --vos-border: #e8e8ee; --vos-border-strong: #d1d5db; --vos-text: #1a1a2e; --vos-text-body: #374151; --vos-text-muted: #6b7280; --vos-text-faint: #9ca3af; --vos-brand: #4f46e5; --vos-brand-strong: #4338ca; --vos-brand-bg: #eef2ff; --vos-brand-border: #c7d2fe; --vos-on-brand: #ffffff; --vos-primary: #1a1a2e; --vos-primary-hover: #2d2d4e; --vos-primary-text: #ffffff; --vos-success-bg: #d1fae5; --vos-success-text: #065f46; --vos-success-border: #a7f3d0; --vos-warning-bg: #fef3c7; --vos-warning-text: #92400e; --vos-warning-border: #fde68a; --vos-danger: #dc2626; --vos-danger-text: #b91c1c; --vos-danger-bg: #fee2e2; --vos-danger-border: #fecaca; --vos-info-bg: #dbeafe; --vos-info-text: #1e40af; --vos-info-border: #93c5fd; --vos-violet-bg: #ede9fe; --vos-violet-text: #5b21b6; --vos-teal-bg: #ccfbf1; --vos-teal-text: #0f766e; }
    :root[data-theme="dark"] { color-scheme: dark; --vos-bg: #0f1117; --vos-surface: #171a22; --vos-surface-muted: #1b1f29; --vos-surface-subtle: #1f2330; --vos-border: #2a2f3d; --vos-border-strong: #3a4052; --vos-text: #e6e8ef; --vos-text-body: #c9cdd8; --vos-text-muted: #a3a9b8; --vos-text-faint: #8891a3; --vos-brand: #818cf8; --vos-brand-strong: #a5b4fc; --vos-brand-bg: #23264a; --vos-brand-border: #3b3f7a; --vos-on-brand: #0f1117; --vos-primary: #e6e8ef; --vos-primary-hover: #ffffff; --vos-primary-text: #0f1117; --vos-success-bg: #0f2e1d; --vos-success-text: #86efac; --vos-success-border: #14532d; --vos-warning-bg: #3a2a0c; --vos-warning-text: #fcd34d; --vos-warning-border: #78350f; --vos-danger: #f87171; --vos-danger-text: #fca5a5; --vos-danger-bg: #3b1518; --vos-danger-border: #7f1d1d; --vos-info-bg: #16264a; --vos-info-text: #93c5fd; --vos-info-border: #1e3a8a; --vos-violet-bg: #2a1f4d; --vos-violet-text: #c4b5fd; --vos-teal-bg: #0f2f2c; --vos-teal-text: #5eead4; }
    :root[data-theme="dark"] textarea, :root[data-theme="dark"] select, :root[data-theme="dark"] input:not([type="checkbox"]):not([type="radio"]):not([type="range"]) { background-color: var(--vos-surface); color: var(--vos-text); }
    html { font-size: 16px; -webkit-font-smoothing: antialiased; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background: var(--vos-bg);
      color: var(--vos-text);
      min-height: 100vh;
    }

    /* ─── Toolbar ───────────────────────────────────────── */
    .vos-toolbar {
      background: var(--vos-surface);
      border-bottom: 1px solid var(--vos-border);
      height: 52px;
      display: flex;
      align-items: center;
      padding: 0 24px;
      gap: 24px;
      position: sticky;
      top: 0;
      z-index: 100;
    }
    .vos-wordmark {
      font-size: 15px;
      font-weight: 700;
      color: var(--vos-text);
      text-decoration: none;
      letter-spacing: -0.3px;
      flex-shrink: 0;
    }
    .vos-wordmark:hover { color: var(--vos-brand); }
    .vos-nav {
      display: flex;
      align-items: center;
      gap: 4px;
      flex: 1;
    }
    .vos-nav-link {
      padding: 5px 12px;
      border-radius: 6px;
      font-size: 13px;
      font-weight: 500;
      color: var(--vos-text-muted);
      text-decoration: none;
      transition: background 0.1s, color 0.1s;
      white-space: nowrap;
    }
    .vos-nav-link:hover { background: var(--vos-surface-subtle); color: var(--vos-text); }
    .vos-nav-link.active {
      background: var(--vos-brand-bg);
      color: var(--vos-brand);
      font-weight: 600;
    }
    .vos-user {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-shrink: 0;
      margin-left: auto;
    }
    .vos-username {
      font-size: 13px;
      color: var(--vos-text-muted);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 160px;
    }
    .vos-signout-btn {
      font-size: 13px;
      font-weight: 500;
      color: var(--vos-text-muted);
      background: none;
      border: 1px solid var(--vos-border);
      border-radius: 6px;
      padding: 5px 12px;
      cursor: pointer;
      font-family: inherit;
      transition: background 0.1s, color 0.1s, border-color 0.1s;
      white-space: nowrap;
    }
    .vos-signout-btn:hover { background: var(--vos-bg); color: var(--vos-text); border-color: var(--vos-border-strong); }

    /* ─── Page body ─────────────────────────────────────── */
    .vos-theme-toggle {
      font-size: 13px;
      font-weight: 500;
      color: var(--vos-text-muted);
      background: none;
      border: 1px solid var(--vos-border);
      border-radius: 6px;
      padding: 5px 12px;
      min-height: 28px;
      cursor: pointer;
      white-space: nowrap;
      transition: background 0.1s, color 0.1s, border-color 0.1s;
    }
    .vos-theme-toggle:hover { background: var(--vos-bg); color: var(--vos-text); border-color: var(--vos-border-strong); }
    .vos-theme-toggle[aria-pressed="true"] { background: var(--vos-brand-bg); color: var(--vos-brand); border-color: var(--vos-brand-border); }
    .vos-page {
      max-width: 960px;
      margin: 0 auto;
      padding: 32px 24px 64px;
    }
    .vos-page-wide { max-width: none; width: 100%; }

    /* ─── Hamburger toggle (CSS-only, no JS) ───────────── */
    .vos-nav-toggle { display: none; }
    .vos-hamburger {
      display: none;
      background: none;
      border: none;
      font-size: 20px;
      cursor: pointer;
      color: var(--vos-text);
      padding: 4px 8px;
      line-height: 1;
      font-family: inherit;
    }
    .vos-hamburger:hover { color: var(--vos-brand); }

    @media (max-width: 640px) {
      .vos-toolbar { padding: 0 16px; gap: 12px; flex-wrap: wrap; height: auto; min-height: 52px; align-items: center; }
      .vos-username { display: none; }
      .vos-nav-link { padding: 5px 8px; }
      .vos-page { padding: 20px 16px 48px; }

      /* Hide nav links by default on mobile */
      .vos-nav {
        display: none;
        flex-direction: column;
        width: 100%;
        gap: 2px;
        padding: 8px 0;
        order: 3;
      }
      /* Show nav links when hamburger checkbox is checked */
      .vos-nav-toggle:checked + nav .vos-nav {
        display: flex;
      }
      .vos-nav-link {
        display: block;
        padding: 10px 12px;
        border-radius: 6px;
        font-size: 14px;
      }
      .vos-nav-link.active {
        background: var(--vos-brand-bg);
        color: var(--vos-brand);
        font-weight: 600;
      }
      /* Show hamburger on mobile */
      .vos-hamburger {
        display: block;
      }
      /* Hide user section sign-out on mobile when nav is closed */
      .vos-user {
        order: 2;
        margin-left: 0;
      }
    }

  </style>
  <link rel="stylesheet" href="/dashboard/styles.css" />
</head>
<body>
  <input type="checkbox" id="vos-nav-toggle" class="vos-nav-toggle" aria-hidden="true">
  <nav class="vos-toolbar" aria-label="Site navigation">
    <a href="/admin/agents" class="vos-wordmark">Shipwright</a>
    <div id="vos-nav-content" class="vos-nav">
      <a href="/admin/agents" class="vos-nav-link">Agents</a>
      <a href="/admin/tasks" class="vos-nav-link">Tasks</a>
      <a href="/admin/sessions" class="vos-nav-link">Sessions</a>
      <a href="/admin/prs" class="vos-nav-link">PRs</a>
      <a href="/admin/chat" class="vos-nav-link">Chat</a>
      <a href="/admin/queue-activity" class="vos-nav-link">Queue &amp; Activity</a>
      <a href="/dashboard" class="vos-nav-link active">Metrics</a>
    </div>
    <div class="vos-user">
      <span class="vos-username">Alice</span>
      <button type="button" id="vos-theme-toggle" class="vos-theme-toggle" aria-pressed="false">Dark mode</button>
      <form method="POST" action="/admin/logout" style="margin:0">
        <button type="submit" class="vos-signout-btn">Sign out</button>
      </form>
    </div>
    <label for="vos-nav-toggle" class="vos-hamburger" aria-label="Toggle navigation" aria-expanded="false" aria-controls="vos-nav-content">☰</label>
  </nav>
  <script>(function(){var t=document.getElementById('vos-nav-toggle');if(t)t.addEventListener('change',function(){var l=document.querySelector('label[for="vos-nav-toggle"]');if(l)l.setAttribute('aria-expanded',t.checked?'true':'false');});})();</script>
  <script>(function(){var d=document,r=d.documentElement,k="shipwright-theme",q=window.matchMedia?window.matchMedia("(prefers-color-scheme: dark)"):null;function saved(){try{var s=localStorage.getItem(k);return s==="dark"||s==="light"?s:null}catch(e){return null}}function apply(t){r.setAttribute("data-theme",t);var b=d.getElementById("vos-theme-toggle");if(b)b.setAttribute("aria-pressed",t==="dark"?"true":"false");d.dispatchEvent(new CustomEvent("vos-theme-change",{detail:{theme:t}}))}apply(saved()||(q&&q.matches?"dark":"light"));var b=d.getElementById("vos-theme-toggle");if(b)b.addEventListener("click",function(){var t=r.getAttribute("data-theme")==="dark"?"light":"dark";try{localStorage.setItem(k,t)}catch(e){}apply(t)});if(q&&q.addEventListener)q.addEventListener("change",function(e){if(!saved())apply(e.matches?"dark":"light")})})();</script>
  <div class="app">

    <!-- Page Controls -->
    <div class="page-controls">
      <div class="date-range-picker" role="group" aria-label="Date range">
        <button class="date-btn active" data-range="today" type="button">1D</button>
        <button class="date-btn" data-range="7d" type="button">7D</button>
        <button class="date-btn" data-range="30d" type="button">30D</button>
        <button class="date-btn" data-range="90d" type="button">90D</button>
      </div>
      <div class="page-meta">
        <button id="theme-toggle" class="theme-toggle" type="button" aria-pressed="false">Dark mode</button>
        <span id="freshness-indicator" class="freshness" aria-live="polite"></span>
        <span id="refresh-countdown" class="countdown" aria-live="polite"></span>
      </div>
    </div>

    <!-- Main -->
    <main class="main">

      <!-- KPI Cards -->
      <section class="section" aria-label="Key performance indicators">
        <div class="section-header">
          <h2 class="section-title">Overview</h2>
          <span class="section-badge" id="task-count-badge">0 tasks</span>
        </div>
        <div class="kpi-grid">
          <div class="kpi-card" data-metric="tasks-completed">
            <div class="kpi-label">Tasks Completed<span class="info-icon" data-tooltip="Total tasks shipped as merged PRs in the selected period" tabindex="0" aria-label="Total tasks shipped as merged PRs in the selected period">i</span></div>
            <div class="kpi-value" id="kpi-tasks"><span class="skeleton">&nbsp;</span></div>
            <div class="kpi-meta">shipwright_task_completed events</div>
          </div>
          <div class="kpi-card" data-metric="ci-first-pass">
            <div class="kpi-label">CI First-Pass Rate<span class="info-icon" data-tooltip="% of CI gate runs that passed without any fix attempts" tabindex="0" aria-label="% of CI gate runs that passed without any fix attempts">i</span></div>
            <div class="kpi-value" id="kpi-ci-rate"><span class="skeleton">&nbsp;</span></div>
            <div class="kpi-meta">passed_first_try / total gates</div>
          </div>
          <div class="kpi-card" data-metric="shipwright-prs-merged">
            <div class="kpi-label">Shipwright PRs Merged<span class="info-icon" data-tooltip="PRs authored by Shipwright that were merged in the selected period" tabindex="0" aria-label="PRs authored by Shipwright that were merged in the selected period">i</span></div>
            <div class="kpi-value" id="kpi-shipwright-prs"><span class="skeleton">&nbsp;</span></div>
            <div class="kpi-meta">origin=shipwright, state=merged</div>
          </div>
          <div class="kpi-card" data-metric="review-ship-it">
            <div class="kpi-label">Review SHIP IT Rate<span class="info-icon" data-tooltip="% of code reviews that received an immediate ship-it verdict" tabindex="0" aria-label="% of code reviews that received an immediate ship-it verdict">i</span></div>
            <div class="kpi-value" id="kpi-review-rate"><span class="skeleton">&nbsp;</span></div>
            <div class="kpi-meta">SHIP IT / total reviews</div>
          </div>
        </div>
      </section>

      <!-- Merged PRs by repo -->
      <section class="section" aria-label="Merged PRs by repo">
        <div class="section-header">
          <h2 class="section-title">Merged PRs by repo</h2>
        </div>
        <div id="merged-prs-content">
          <div class="merged-prs-repo-picker" id="merged-prs-repo-picker" style="display:none">
            <label for="merged-prs-repo-select">Repo</label>
            <select id="merged-prs-repo-select"></select>
          </div>
          <div class="merged-prs-charts">
            <div class="chart-container">
              <canvas id="merged-prs-bar-chart" aria-label="Merged PRs by repo and origin"></canvas>
            </div>
            <div class="chart-container">
              <canvas id="merged-prs-trend-chart" aria-label="Merged PRs trend by origin over time"></canvas>
            </div>
          </div>
        </div>
        <p id="merged-prs-empty" class="empty-state" style="display:none">No merged PRs in this range</p>
      </section>

      <!-- Coverage by repo -->
      <section class="section" id="coverage-section" aria-label="Coverage by repo">
        <div class="section-header">
          <h2 class="section-title">Coverage by repo</h2>
        </div>
        <div id="coverage-content">
          <div class="coverage-table-wrapper">
            <table class="token-table" id="coverage-repo-table">
              <thead>
                <tr>
                  <th>Repo</th>
                  <th>Lines %</th>
                  <th>Change<span class="info-icon" data-tooltip="Line-coverage change versus the repo's previous snapshot, in percentage points" tabindex="0" aria-label="Line-coverage change versus the repo's previous snapshot, in percentage points">i</span></th>
                  <th>Last measured<span class="info-icon" data-tooltip="Rows measured more than 14 days ago are marked stale" tabindex="0" aria-label="Rows measured more than 14 days ago are marked stale">i</span></th>
                </tr>
              </thead>
              <tbody id="coverage-tbody"></tbody>
            </table>
          </div>
          <div class="merged-prs-repo-picker" id="coverage-repo-picker" style="display:none">
            <label for="coverage-repo-select">Repo</label>
            <select id="coverage-repo-select"></select>
          </div>
          <div class="chart-container">
            <canvas id="coverage-trend-chart" aria-label="Line coverage trend by repo, one point per snapshot"></canvas>
          </div>
          <p id="coverage-trend-empty" class="empty-state" style="display:none">No coverage snapshots in the selected date range. Pick a wider range to see the trend.</p>
        </div>
        <p id="coverage-empty" class="empty-state" style="display:none">No coverage snapshots yet. A repo starts reporting when its CI posts a coverage report to the task store (POST /coverage-snapshots with repo, commitSha, and line/branch/function counts); it then appears here with its next snapshot.</p>
      </section>

      <!-- System crons -->
      <section class="section" id="system-crons-section" aria-label="System crons">
        <div class="section-header">
          <h2 class="section-title">System crons</h2>
          <span class="section-badge" id="system-crons-meta"></span>
        </div>
        <div id="system-crons-content">
          <table class="token-table" id="system-crons-table">
            <thead>
              <tr>
                <th>Cron</th>
                <th>Shipped<span class="info-icon" data-tooltip="Tasks the cron created that reached a merged PR (or merged/deployed/released status) in this range" tabindex="0" aria-label="Tasks the cron created that reached a merged PR (or merged/deployed/released status) in this range">i</span></th>
                <th>Stuck<span class="info-icon" data-tooltip="Blocked, or PR open for 24h or more" tabindex="0" aria-label="Blocked, or PR open for 24h or more">i</span></th>
                <th>Failed<span class="info-icon" data-tooltip="Cancelled tasks" tabindex="0" aria-label="Cancelled tasks">i</span></th>
                <th>Follow-ons<span class="info-icon" data-tooltip="Cron-origin tasks not created by the cron itself: created / shipped" tabindex="0" aria-label="Cron-origin tasks not created by the cron itself: created / shipped">i</span></th>
                <th>Other<span class="info-icon" data-tooltip="No-op (done without a PR), in flight (PR open under 24h), pending" tabindex="0" aria-label="No-op (done without a PR), in flight (PR open under 24h), pending">i</span></th>
              </tr>
            </thead>
            <tbody id="system-crons-tbody"></tbody>
          </table>
        </div>
        <p id="system-crons-empty" class="empty-state" style="display:none">No system crons are registered for this account.</p>
      </section>

      <!-- Pipeline Quality -->
      <section class="section" aria-label="Pipeline quality">
        <div class="section-header">
          <h2 class="section-title">Pipeline Quality</h2>
        </div>
        <div class="quality-grid">

          <!-- CI Gates -->
          <div class="quality-panel">
            <h3 class="panel-title">CI Gates</h3>
            <div class="stat-row" data-metric="ci-gates">
              <span class="stat-label">Total gates<span class="info-icon" data-tooltip="Total CI runs triggered by PRs in the period" tabindex="0" aria-label="Total CI runs triggered by PRs in the period">i</span></span>
              <span class="stat-value" id="ci-total">--</span>
            </div>
            <div class="stat-row" data-metric="ci-first-pass-count">
              <span class="stat-label">First-pass<span class="info-icon" data-tooltip="CI runs that passed without any fix commits" tabindex="0" aria-label="CI runs that passed without any fix commits">i</span></span>
              <span class="stat-value" id="ci-first">--</span>
            </div>
            <div class="stat-row" data-metric="avg-fix-attempts">
              <span class="stat-label">Avg fix attempts<span class="info-icon" data-tooltip="Mean number of fix commits needed before CI passed" tabindex="0" aria-label="Mean number of fix commits needed before CI passed">i</span></span>
              <span class="stat-value" id="ci-fix-avg">--</span>
            </div>
          </div>

          <!-- Simplify -->
          <div class="quality-panel">
            <h3 class="panel-title">Simplify Fixes</h3>
            <div class="stat-row" data-metric="simplify-total">
              <span class="stat-label">Total fixes<span class="info-icon" data-tooltip="Code simplifications applied automatically after implementation" tabindex="0" aria-label="Code simplifications applied automatically after implementation">i</span></span>
              <span class="stat-value" id="simplify-total">--</span>
            </div>
            <div class="simplify-breakdown" id="simplify-breakdown">
              <div class="bar-item" data-metric="simplify-dry"><span class="bar-label">DRY<span class="info-icon" data-tooltip="Duplicated code extractions applied" tabindex="0" aria-label="Duplicated code extractions applied">i</span></span><div class="bar-track"><div class="bar-fill" id="bar-dry"></div></div><span class="bar-val" id="val-dry">--</span></div>
              <div class="bar-item" data-metric="simplify-dead"><span class="bar-label">Dead code<span class="info-icon" data-tooltip="Unused imports, variables, or functions removed" tabindex="0" aria-label="Unused imports, variables, or functions removed">i</span></span><div class="bar-track"><div class="bar-fill" id="bar-dead"></div></div><span class="bar-val" id="val-dead">--</span></div>
              <div class="bar-item" data-metric="simplify-naming"><span class="bar-label">Naming<span class="info-icon" data-tooltip="Variable and function name improvements applied" tabindex="0" aria-label="Variable and function name improvements applied">i</span></span><div class="bar-track"><div class="bar-fill" id="bar-naming"></div></div><span class="bar-val" id="val-naming">--</span></div>
              <div class="bar-item" data-metric="simplify-complexity"><span class="bar-label">Complexity<span class="info-icon" data-tooltip="Over-engineered patterns simplified" tabindex="0" aria-label="Over-engineered patterns simplified">i</span></span><div class="bar-track"><div class="bar-fill" id="bar-complexity"></div></div><span class="bar-val" id="val-complexity">--</span></div>
              <div class="bar-item" data-metric="simplify-consistency"><span class="bar-label">Consistency<span class="info-icon" data-tooltip="Style or pattern inconsistencies corrected" tabindex="0" aria-label="Style or pattern inconsistencies corrected">i</span></span><div class="bar-track"><div class="bar-fill" id="bar-consistency"></div></div><span class="bar-val" id="val-consistency">--</span></div>
            </div>
          </div>

          <!-- Reviews -->
          <div class="quality-panel">
            <h3 class="panel-title">Reviews</h3>
            <div class="stat-row" data-metric="reviews-total">
              <span class="stat-label">Total reviews<span class="info-icon" data-tooltip="Code reviews run by the shipwright review agent" tabindex="0" aria-label="Code reviews run by the shipwright review agent">i</span></span>
              <span class="stat-value" id="review-total">--</span>
            </div>
            <div class="stat-row" data-metric="reviews-ship-it">
              <span class="stat-label">SHIP IT<span class="info-icon" data-tooltip="Reviews where no blocking issues were found" tabindex="0" aria-label="Reviews where no blocking issues were found">i</span></span>
              <span class="stat-value good" id="review-ship-it">--</span>
            </div>
            <div class="stat-row" data-metric="review-iterations">
              <span class="stat-label">Review Iterations<span class="info-icon" data-tooltip="Avg review + patch cycles per PR — an iteration-count proxy, not a findings count" tabindex="0" aria-label="Avg review + patch cycles per PR — an iteration-count proxy, not a findings count">i</span></span>
              <span class="stat-value" id="review-iterations">--</span>
            </div>
          </div>

          <!-- Coverage -->
          <div class="quality-panel">
            <h3 class="panel-title">Coverage</h3>
            <div class="stat-row">
              <span class="stat-label">Reports<span class="info-icon" data-tooltip="Tasks with a measured coverage delta" tabindex="0" aria-label="Tasks with a measured coverage delta">i</span></span>
              <span class="stat-value" id="coverage-reports">--</span>
            </div>
            <div class="stat-row">
              <span class="stat-label">Avg delta<span class="info-icon" data-tooltip="Mean change in line coverage % across all reports" tabindex="0" aria-label="Mean change in line coverage % across all reports">i</span></span>
              <span class="stat-value" id="coverage-delta">--</span>
            </div>
          </div>

          <!-- PR Commits -->
          <div class="quality-panel">
            <h3 class="panel-title">PR Commits</h3>
            <div class="stat-row" data-metric="pr-commits-total">
              <span class="stat-label">Avg per PR<span class="info-icon" data-tooltip="Fleet-wide weighted-average commits per Shipwright PR" tabindex="0" aria-label="Fleet-wide weighted-average commits per Shipwright PR">i</span></span>
              <span class="stat-value" id="pr-commits-total">--</span>
            </div>
            <div class="pr-commits-breakdown" id="pr-commits-breakdown">
              <div class="bar-item" data-metric="pr-commits-docs-refresh"><span class="bar-label">Docs refresh<span class="info-icon" data-tooltip="Avg commits for documentation updates" tabindex="0" aria-label="Avg commits for documentation updates">i</span></span><div class="bar-track"><div class="bar-fill" id="bar-pr-commits-docs-refresh"></div></div><span class="bar-val" id="val-pr-commits-docs-refresh">--</span></div>
              <div class="bar-item" data-metric="pr-commits-review-patch"><span class="bar-label">Review patch<span class="info-icon" data-tooltip="Avg commits for review feedback changes" tabindex="0" aria-label="Avg commits for review feedback changes">i</span></span><div class="bar-track"><div class="bar-fill" id="bar-pr-commits-review-patch"></div></div><span class="bar-val" id="val-pr-commits-review-patch">--</span></div>
              <div class="bar-item" data-metric="pr-commits-ci-fix"><span class="bar-label">CI fix<span class="info-icon" data-tooltip="Avg commits for CI gate fixes" tabindex="0" aria-label="Avg commits for CI gate fixes">i</span></span><div class="bar-track"><div class="bar-fill" id="bar-pr-commits-ci-fix"></div></div><span class="bar-val" id="val-pr-commits-ci-fix">--</span></div>
              <div class="bar-item" data-metric="pr-commits-implementation"><span class="bar-label">Implementation<span class="info-icon" data-tooltip="Avg commits for implementation work" tabindex="0" aria-label="Avg commits for implementation work">i</span></span><div class="bar-track"><div class="bar-fill" id="bar-pr-commits-implementation"></div></div><span class="bar-val" id="val-pr-commits-implementation">--</span></div>
            </div>
          </div>

        </div>
      </section>

      <!-- Token Usage -->
      <section class="section" aria-label="Token usage">
        <div class="section-header">
          <h2 class="section-title">Token Usage</h2>
        </div>
        <div class="token-kpi-row">
          <div class="kpi-card" data-metric="token-input">
            <div class="kpi-label">Input Tokens</div>
            <div class="kpi-value" id="token-input"><span class="skeleton">&nbsp;</span></div>
            <div class="kpi-meta">total input tokens</div>
          </div>
          <div class="kpi-card" data-metric="token-output">
            <div class="kpi-label">Output Tokens</div>
            <div class="kpi-value" id="token-output"><span class="skeleton">&nbsp;</span></div>
            <div class="kpi-meta">total output tokens</div>
          </div>
          <div class="kpi-card" data-metric="token-cache">
            <div class="kpi-label">Cache Tokens</div>
            <div class="kpi-value" id="token-cache"><span class="skeleton">&nbsp;</span></div>
            <div class="kpi-meta">cache read + creation</div>
          </div>
          <div class="kpi-card" data-metric="token-cost">
            <div class="kpi-label">Total Cost</div>
            <div class="kpi-value" id="token-cost"><span class="skeleton">&nbsp;</span></div>
            <div class="kpi-meta">total cost (USD)</div>
          </div>
        </div>
        <div class="quality-panel">
          <h3 class="panel-title">By Agent</h3>
          <table class="token-table" id="token-agent-table">
            <thead>
              <tr><th>Agent</th><th>Cron</th><th>DM/Mention</th><th>Total</th><th>Cost ($)</th></tr>
            </thead>
            <tbody id="token-agent-tbody"></tbody>
          </table>
          <p id="token-agent-empty" class="empty-state" style="display:none">No data</p>
        </div>
        <div class="token-trends-section">
          <div class="token-trends-toggles" role="group" aria-label="Token series">
            <button class="token-series-btn active" data-token-series="input" type="button">Input</button>
            <button class="token-series-btn" data-token-series="output" type="button">Output</button>
            <button class="token-series-btn" data-token-series="total" type="button">Total</button>
            <button class="token-series-btn" data-token-series="all" type="button">All</button>
          </div>
          <div class="chart-container token-trends-chart-container">
            <canvas id="token-trends-chart" aria-label="Token usage trends chart"></canvas>
          </div>
        </div>
      </section>



      <!-- Feature Breakdown -->
      <section class="section features-section" aria-label="Feature breakdown">
        <div class="section-header">
          <h2 class="section-title">Feature Breakdown</h2>
        </div>
        <div class="features-table-wrapper">
          <table class="features-table">
            <thead>
              <tr>
                <th>Feature<span class="info-icon" data-tooltip="Planning session or feature group name" tabindex="0" aria-label="Planning session or feature group name">i</span></th>
                <th>Tasks<span class="info-icon" data-tooltip="Number of tasks shipped in this feature" tabindex="0" aria-label="Number of tasks shipped in this feature">i</span></th>
                <th>Avg Hrs<span class="info-icon" data-tooltip="Mean actual hours per task" tabindex="0" aria-label="Mean actual hours per task">i</span></th>
                <th>CI Pass<span class="info-icon" data-tooltip="CI first-pass rate for this feature's tasks" tabindex="0" aria-label="CI first-pass rate for this feature's tasks">i</span></th>
                <th>Review<span class="info-icon" data-tooltip="SHIP IT rate for this feature's tasks" tabindex="0" aria-label="SHIP IT rate for this feature's tasks">i</span></th>
              </tr>
            </thead>
            <tbody id="features-tbody"></tbody>
          </table>
        </div>
        <p id="features-empty" class="empty-state" style="display:none">No feature data for this period</p>
      </section>

      <!-- Efficiency -->
      <section class="section" aria-label="Efficiency">
        <div class="section-header">
          <h2 class="section-title">Efficiency</h2>
        </div>
        <div class="efficiency-grid">
          <div class="stat-block" data-metric="avg-actual-hours">
            <span class="stat-block-value" id="eff-avg-hours">--</span>
            <span class="stat-block-label">Avg actual hours<span class="info-icon" data-tooltip="Mean wall-clock hours per task from start to PR merge" tabindex="0" aria-label="Mean wall-clock hours per task from start to PR merge">i</span></span>
          </div>
          <div class="stat-block" data-metric="avg-estimated-hours">
            <span class="stat-block-value" id="eff-est-hours">--</span>
            <span class="stat-block-label">Avg estimated hours<span class="info-icon" data-tooltip="Mean planned hours per task from the planning doc" tabindex="0" aria-label="Mean planned hours per task from the planning doc">i</span></span>
          </div>
          <div class="stat-block" data-metric="avg-retries">
            <span class="stat-block-value" id="eff-retries">--</span>
            <span class="stat-block-label">Avg retries<span class="info-icon" data-tooltip="Mean CI fix attempts needed before the CI gate passed" tabindex="0" aria-label="Mean CI fix attempts needed before the CI gate passed">i</span></span>
          </div>
          <div class="stat-block" data-metric="avg-files-changed">
            <span class="stat-block-value" id="eff-files">--</span>
            <span class="stat-block-label">Avg files changed<span class="info-icon" data-tooltip="Mean files modified per task" tabindex="0" aria-label="Mean files modified per task">i</span></span>
          </div>
        </div>
      </section>

      <!-- Trends -->
      <section class="section" aria-label="Trends">
        <div class="section-header">
          <h2 class="section-title">Trends</h2>
        </div>
        <div class="chart-container">
          <canvas id="trends-chart" aria-label="Pipeline trends chart"></canvas>
        </div>
      </section>

    </main>

    <!-- Metric Graph Modal -->
    <div id="metric-modal" class="metric-modal" role="dialog" aria-modal="true" aria-labelledby="metric-modal-title" hidden>
      <div class="metric-modal-backdrop"></div>
      <div class="metric-modal-box">
        <div class="metric-modal-header">
          <h3 class="metric-modal-title" id="metric-modal-title">Metric</h3>
          <button class="metric-modal-close" type="button" aria-label="Close modal">×</button>
        </div>
        <div class="metric-modal-body">
          <canvas id="metric-chart" aria-label="Metric trend chart"></canvas>
        </div>
      </div>
    </div>

  </div>

  <script>window.__METRICS_BASE__ = ""; window.__ADMIN_BASE__ = "";</script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
  <script src="/dashboard/app.js"></script>
</body>
</html>"
`;

exports[`renderDashboardPage — TK-1.2 token trends chart snapshot matches after TK-1.2 changes 1`] = `
"<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="light dark" />
  <title>Metrics — Vitals OS</title>
  <script>(function(){var t="light";try{var s=localStorage.getItem("shipwright-theme");if(s==="dark"||s==="light"){t=s}else if(window.matchMedia&&window.matchMedia("(prefers-color-scheme: dark)").matches){t="dark"}}catch(e){}document.documentElement.setAttribute("data-theme",t)})();</script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root { color-scheme: light; --vos-bg: #f7f7fb; --vos-surface: #ffffff; --vos-surface-muted: #f9fafb; --vos-surface-subtle: #f3f4f6; --vos-border: #e8e8ee; --vos-border-strong: #d1d5db; --vos-text: #1a1a2e; --vos-text-body: #374151; --vos-text-muted: #6b7280; --vos-text-faint: #9ca3af; --vos-brand: #4f46e5; --vos-brand-strong: #4338ca; --vos-brand-bg: #eef2ff; --vos-brand-border: #c7d2fe; --vos-on-brand: #ffffff; --vos-primary: #1a1a2e; --vos-primary-hover: #2d2d4e; --vos-primary-text: #ffffff; --vos-success-bg: #d1fae5; --vos-success-text: #065f46; --vos-success-border: #a7f3d0; --vos-warning-bg: #fef3c7; --vos-warning-text: #92400e; --vos-warning-border: #fde68a; --vos-danger: #dc2626; --vos-danger-text: #b91c1c; --vos-danger-bg: #fee2e2; --vos-danger-border: #fecaca; --vos-info-bg: #dbeafe; --vos-info-text: #1e40af; --vos-info-border: #93c5fd; --vos-violet-bg: #ede9fe; --vos-violet-text: #5b21b6; --vos-teal-bg: #ccfbf1; --vos-teal-text: #0f766e; }
    :root[data-theme="dark"] { color-scheme: dark; --vos-bg: #0f1117; --vos-surface: #171a22; --vos-surface-muted: #1b1f29; --vos-surface-subtle: #1f2330; --vos-border: #2a2f3d; --vos-border-strong: #3a4052; --vos-text: #e6e8ef; --vos-text-body: #c9cdd8; --vos-text-muted: #a3a9b8; --vos-text-faint: #8891a3; --vos-brand: #818cf8; --vos-brand-strong: #a5b4fc; --vos-brand-bg: #23264a; --vos-brand-border: #3b3f7a; --vos-on-brand: #0f1117; --vos-primary: #e6e8ef; --vos-primary-hover: #ffffff; --vos-primary-text: #0f1117; --vos-success-bg: #0f2e1d; --vos-success-text: #86efac; --vos-success-border: #14532d; --vos-warning-bg: #3a2a0c; --vos-warning-text: #fcd34d; --vos-warning-border: #78350f; --vos-danger: #f87171; --vos-danger-text: #fca5a5; --vos-danger-bg: #3b1518; --vos-danger-border: #7f1d1d; --vos-info-bg: #16264a; --vos-info-text: #93c5fd; --vos-info-border: #1e3a8a; --vos-violet-bg: #2a1f4d; --vos-violet-text: #c4b5fd; --vos-teal-bg: #0f2f2c; --vos-teal-text: #5eead4; }
    :root[data-theme="dark"] textarea, :root[data-theme="dark"] select, :root[data-theme="dark"] input:not([type="checkbox"]):not([type="radio"]):not([type="range"]) { background-color: var(--vos-surface); color: var(--vos-text); }
    html { font-size: 16px; -webkit-font-smoothing: antialiased; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background: var(--vos-bg);
      color: var(--vos-text);
      min-height: 100vh;
    }

    /* ─── Toolbar ───────────────────────────────────────── */
    .vos-toolbar {
      background: var(--vos-surface);
      border-bottom: 1px solid var(--vos-border);
      height: 52px;
      display: flex;
      align-items: center;
      padding: 0 24px;
      gap: 24px;
      position: sticky;
      top: 0;
      z-index: 100;
    }
    .vos-wordmark {
      font-size: 15px;
      font-weight: 700;
      color: var(--vos-text);
      text-decoration: none;
      letter-spacing: -0.3px;
      flex-shrink: 0;
    }
    .vos-wordmark:hover { color: var(--vos-brand); }
    .vos-nav {
      display: flex;
      align-items: center;
      gap: 4px;
      flex: 1;
    }
    .vos-nav-link {
      padding: 5px 12px;
      border-radius: 6px;
      font-size: 13px;
      font-weight: 500;
      color: var(--vos-text-muted);
      text-decoration: none;
      transition: background 0.1s, color 0.1s;
      white-space: nowrap;
    }
    .vos-nav-link:hover { background: var(--vos-surface-subtle); color: var(--vos-text); }
    .vos-nav-link.active {
      background: var(--vos-brand-bg);
      color: var(--vos-brand);
      font-weight: 600;
    }
    .vos-user {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-shrink: 0;
      margin-left: auto;
    }
    .vos-username {
      font-size: 13px;
      color: var(--vos-text-muted);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 160px;
    }
    .vos-signout-btn {
      font-size: 13px;
      font-weight: 500;
      color: var(--vos-text-muted);
      background: none;
      border: 1px solid var(--vos-border);
      border-radius: 6px;
      padding: 5px 12px;
      cursor: pointer;
      font-family: inherit;
      transition: background 0.1s, color 0.1s, border-color 0.1s;
      white-space: nowrap;
    }
    .vos-signout-btn:hover { background: var(--vos-bg); color: var(--vos-text); border-color: var(--vos-border-strong); }

    /* ─── Page body ─────────────────────────────────────── */
    .vos-theme-toggle {
      font-size: 13px;
      font-weight: 500;
      color: var(--vos-text-muted);
      background: none;
      border: 1px solid var(--vos-border);
      border-radius: 6px;
      padding: 5px 12px;
      min-height: 28px;
      cursor: pointer;
      white-space: nowrap;
      transition: background 0.1s, color 0.1s, border-color 0.1s;
    }
    .vos-theme-toggle:hover { background: var(--vos-bg); color: var(--vos-text); border-color: var(--vos-border-strong); }
    .vos-theme-toggle[aria-pressed="true"] { background: var(--vos-brand-bg); color: var(--vos-brand); border-color: var(--vos-brand-border); }
    .vos-page {
      max-width: 960px;
      margin: 0 auto;
      padding: 32px 24px 64px;
    }
    .vos-page-wide { max-width: none; width: 100%; }

    /* ─── Hamburger toggle (CSS-only, no JS) ───────────── */
    .vos-nav-toggle { display: none; }
    .vos-hamburger {
      display: none;
      background: none;
      border: none;
      font-size: 20px;
      cursor: pointer;
      color: var(--vos-text);
      padding: 4px 8px;
      line-height: 1;
      font-family: inherit;
    }
    .vos-hamburger:hover { color: var(--vos-brand); }

    @media (max-width: 640px) {
      .vos-toolbar { padding: 0 16px; gap: 12px; flex-wrap: wrap; height: auto; min-height: 52px; align-items: center; }
      .vos-username { display: none; }
      .vos-nav-link { padding: 5px 8px; }
      .vos-page { padding: 20px 16px 48px; }

      /* Hide nav links by default on mobile */
      .vos-nav {
        display: none;
        flex-direction: column;
        width: 100%;
        gap: 2px;
        padding: 8px 0;
        order: 3;
      }
      /* Show nav links when hamburger checkbox is checked */
      .vos-nav-toggle:checked + nav .vos-nav {
        display: flex;
      }
      .vos-nav-link {
        display: block;
        padding: 10px 12px;
        border-radius: 6px;
        font-size: 14px;
      }
      .vos-nav-link.active {
        background: var(--vos-brand-bg);
        color: var(--vos-brand);
        font-weight: 600;
      }
      /* Show hamburger on mobile */
      .vos-hamburger {
        display: block;
      }
      /* Hide user section sign-out on mobile when nav is closed */
      .vos-user {
        order: 2;
        margin-left: 0;
      }
    }

  </style>
  <link rel="stylesheet" href="/dashboard/styles.css" />
</head>
<body>
  <input type="checkbox" id="vos-nav-toggle" class="vos-nav-toggle" aria-hidden="true">
  <nav class="vos-toolbar" aria-label="Site navigation">
    <a href="/admin/agents" class="vos-wordmark">Shipwright</a>
    <div id="vos-nav-content" class="vos-nav">
      <a href="/admin/agents" class="vos-nav-link">Agents</a>
      <a href="/admin/tasks" class="vos-nav-link">Tasks</a>
      <a href="/admin/sessions" class="vos-nav-link">Sessions</a>
      <a href="/admin/prs" class="vos-nav-link">PRs</a>
      <a href="/admin/chat" class="vos-nav-link">Chat</a>
      <a href="/admin/queue-activity" class="vos-nav-link">Queue &amp; Activity</a>
      <a href="/dashboard" class="vos-nav-link active">Metrics</a>
    </div>
    <div class="vos-user">
      <span class="vos-username">Alice</span>
      <button type="button" id="vos-theme-toggle" class="vos-theme-toggle" aria-pressed="false">Dark mode</button>
      <form method="POST" action="/admin/logout" style="margin:0">
        <button type="submit" class="vos-signout-btn">Sign out</button>
      </form>
    </div>
    <label for="vos-nav-toggle" class="vos-hamburger" aria-label="Toggle navigation" aria-expanded="false" aria-controls="vos-nav-content">☰</label>
  </nav>
  <script>(function(){var t=document.getElementById('vos-nav-toggle');if(t)t.addEventListener('change',function(){var l=document.querySelector('label[for="vos-nav-toggle"]');if(l)l.setAttribute('aria-expanded',t.checked?'true':'false');});})();</script>
  <script>(function(){var d=document,r=d.documentElement,k="shipwright-theme",q=window.matchMedia?window.matchMedia("(prefers-color-scheme: dark)"):null;function saved(){try{var s=localStorage.getItem(k);return s==="dark"||s==="light"?s:null}catch(e){return null}}function apply(t){r.setAttribute("data-theme",t);var b=d.getElementById("vos-theme-toggle");if(b)b.setAttribute("aria-pressed",t==="dark"?"true":"false");d.dispatchEvent(new CustomEvent("vos-theme-change",{detail:{theme:t}}))}apply(saved()||(q&&q.matches?"dark":"light"));var b=d.getElementById("vos-theme-toggle");if(b)b.addEventListener("click",function(){var t=r.getAttribute("data-theme")==="dark"?"light":"dark";try{localStorage.setItem(k,t)}catch(e){}apply(t)});if(q&&q.addEventListener)q.addEventListener("change",function(e){if(!saved())apply(e.matches?"dark":"light")})})();</script>
  <div class="app">

    <!-- Page Controls -->
    <div class="page-controls">
      <div class="date-range-picker" role="group" aria-label="Date range">
        <button class="date-btn active" data-range="today" type="button">1D</button>
        <button class="date-btn" data-range="7d" type="button">7D</button>
        <button class="date-btn" data-range="30d" type="button">30D</button>
        <button class="date-btn" data-range="90d" type="button">90D</button>
      </div>
      <div class="page-meta">
        <button id="theme-toggle" class="theme-toggle" type="button" aria-pressed="false">Dark mode</button>
        <span id="freshness-indicator" class="freshness" aria-live="polite"></span>
        <span id="refresh-countdown" class="countdown" aria-live="polite"></span>
      </div>
    </div>

    <!-- Main -->
    <main class="main">

      <!-- KPI Cards -->
      <section class="section" aria-label="Key performance indicators">
        <div class="section-header">
          <h2 class="section-title">Overview</h2>
          <span class="section-badge" id="task-count-badge">0 tasks</span>
        </div>
        <div class="kpi-grid">
          <div class="kpi-card" data-metric="tasks-completed">
            <div class="kpi-label">Tasks Completed<span class="info-icon" data-tooltip="Total tasks shipped as merged PRs in the selected period" tabindex="0" aria-label="Total tasks shipped as merged PRs in the selected period">i</span></div>
            <div class="kpi-value" id="kpi-tasks"><span class="skeleton">&nbsp;</span></div>
            <div class="kpi-meta">shipwright_task_completed events</div>
          </div>
          <div class="kpi-card" data-metric="ci-first-pass">
            <div class="kpi-label">CI First-Pass Rate<span class="info-icon" data-tooltip="% of CI gate runs that passed without any fix attempts" tabindex="0" aria-label="% of CI gate runs that passed without any fix attempts">i</span></div>
            <div class="kpi-value" id="kpi-ci-rate"><span class="skeleton">&nbsp;</span></div>
            <div class="kpi-meta">passed_first_try / total gates</div>
          </div>
          <div class="kpi-card" data-metric="shipwright-prs-merged">
            <div class="kpi-label">Shipwright PRs Merged<span class="info-icon" data-tooltip="PRs authored by Shipwright that were merged in the selected period" tabindex="0" aria-label="PRs authored by Shipwright that were merged in the selected period">i</span></div>
            <div class="kpi-value" id="kpi-shipwright-prs"><span class="skeleton">&nbsp;</span></div>
            <div class="kpi-meta">origin=shipwright, state=merged</div>
          </div>
          <div class="kpi-card" data-metric="review-ship-it">
            <div class="kpi-label">Review SHIP IT Rate<span class="info-icon" data-tooltip="% of code reviews that received an immediate ship-it verdict" tabindex="0" aria-label="% of code reviews that received an immediate ship-it verdict">i</span></div>
            <div class="kpi-value" id="kpi-review-rate"><span class="skeleton">&nbsp;</span></div>
            <div class="kpi-meta">SHIP IT / total reviews</div>
          </div>
        </div>
      </section>

      <!-- Merged PRs by repo -->
      <section class="section" aria-label="Merged PRs by repo">
        <div class="section-header">
          <h2 class="section-title">Merged PRs by repo</h2>
        </div>
        <div id="merged-prs-content">
          <div class="merged-prs-repo-picker" id="merged-prs-repo-picker" style="display:none">
            <label for="merged-prs-repo-select">Repo</label>
            <select id="merged-prs-repo-select"></select>
          </div>
          <div class="merged-prs-charts">
            <div class="chart-container">
              <canvas id="merged-prs-bar-chart" aria-label="Merged PRs by repo and origin"></canvas>
            </div>
            <div class="chart-container">
              <canvas id="merged-prs-trend-chart" aria-label="Merged PRs trend by origin over time"></canvas>
            </div>
          </div>
        </div>
        <p id="merged-prs-empty" class="empty-state" style="display:none">No merged PRs in this range</p>
      </section>

      <!-- Coverage by repo -->
      <section class="section" id="coverage-section" aria-label="Coverage by repo">
        <div class="section-header">
          <h2 class="section-title">Coverage by repo</h2>
        </div>
        <div id="coverage-content">
          <div class="coverage-table-wrapper">
            <table class="token-table" id="coverage-repo-table">
              <thead>
                <tr>
                  <th>Repo</th>
                  <th>Lines %</th>
                  <th>Change<span class="info-icon" data-tooltip="Line-coverage change versus the repo's previous snapshot, in percentage points" tabindex="0" aria-label="Line-coverage change versus the repo's previous snapshot, in percentage points">i</span></th>
                  <th>Last measured<span class="info-icon" data-tooltip="Rows measured more than 14 days ago are marked stale" tabindex="0" aria-label="Rows measured more than 14 days ago are marked stale">i</span></th>
                </tr>
              </thead>
              <tbody id="coverage-tbody"></tbody>
            </table>
          </div>
          <div class="merged-prs-repo-picker" id="coverage-repo-picker" style="display:none">
            <label for="coverage-repo-select">Repo</label>
            <select id="coverage-repo-select"></select>
          </div>
          <div class="chart-container">
            <canvas id="coverage-trend-chart" aria-label="Line coverage trend by repo, one point per snapshot"></canvas>
          </div>
          <p id="coverage-trend-empty" class="empty-state" style="display:none">No coverage snapshots in the selected date range. Pick a wider range to see the trend.</p>
        </div>
        <p id="coverage-empty" class="empty-state" style="display:none">No coverage snapshots yet. A repo starts reporting when its CI posts a coverage report to the task store (POST /coverage-snapshots with repo, commitSha, and line/branch/function counts); it then appears here with its next snapshot.</p>
      </section>

      <!-- System crons -->
      <section class="section" id="system-crons-section" aria-label="System crons">
        <div class="section-header">
          <h2 class="section-title">System crons</h2>
          <span class="section-badge" id="system-crons-meta"></span>
        </div>
        <div id="system-crons-content">
          <table class="token-table" id="system-crons-table">
            <thead>
              <tr>
                <th>Cron</th>
                <th>Shipped<span class="info-icon" data-tooltip="Tasks the cron created that reached a merged PR (or merged/deployed/released status) in this range" tabindex="0" aria-label="Tasks the cron created that reached a merged PR (or merged/deployed/released status) in this range">i</span></th>
                <th>Stuck<span class="info-icon" data-tooltip="Blocked, or PR open for 24h or more" tabindex="0" aria-label="Blocked, or PR open for 24h or more">i</span></th>
                <th>Failed<span class="info-icon" data-tooltip="Cancelled tasks" tabindex="0" aria-label="Cancelled tasks">i</span></th>
                <th>Follow-ons<span class="info-icon" data-tooltip="Cron-origin tasks not created by the cron itself: created / shipped" tabindex="0" aria-label="Cron-origin tasks not created by the cron itself: created / shipped">i</span></th>
                <th>Other<span class="info-icon" data-tooltip="No-op (done without a PR), in flight (PR open under 24h), pending" tabindex="0" aria-label="No-op (done without a PR), in flight (PR open under 24h), pending">i</span></th>
              </tr>
            </thead>
            <tbody id="system-crons-tbody"></tbody>
          </table>
        </div>
        <p id="system-crons-empty" class="empty-state" style="display:none">No system crons are registered for this account.</p>
      </section>

      <!-- Pipeline Quality -->
      <section class="section" aria-label="Pipeline quality">
        <div class="section-header">
          <h2 class="section-title">Pipeline Quality</h2>
        </div>
        <div class="quality-grid">

          <!-- CI Gates -->
          <div class="quality-panel">
            <h3 class="panel-title">CI Gates</h3>
            <div class="stat-row" data-metric="ci-gates">
              <span class="stat-label">Total gates<span class="info-icon" data-tooltip="Total CI runs triggered by PRs in the period" tabindex="0" aria-label="Total CI runs triggered by PRs in the period">i</span></span>
              <span class="stat-value" id="ci-total">--</span>
            </div>
            <div class="stat-row" data-metric="ci-first-pass-count">
              <span class="stat-label">First-pass<span class="info-icon" data-tooltip="CI runs that passed without any fix commits" tabindex="0" aria-label="CI runs that passed without any fix commits">i</span></span>
              <span class="stat-value" id="ci-first">--</span>
            </div>
            <div class="stat-row" data-metric="avg-fix-attempts">
              <span class="stat-label">Avg fix attempts<span class="info-icon" data-tooltip="Mean number of fix commits needed before CI passed" tabindex="0" aria-label="Mean number of fix commits needed before CI passed">i</span></span>
              <span class="stat-value" id="ci-fix-avg">--</span>
            </div>
          </div>

          <!-- Simplify -->
          <div class="quality-panel">
            <h3 class="panel-title">Simplify Fixes</h3>
            <div class="stat-row" data-metric="simplify-total">
              <span class="stat-label">Total fixes<span class="info-icon" data-tooltip="Code simplifications applied automatically after implementation" tabindex="0" aria-label="Code simplifications applied automatically after implementation">i</span></span>
              <span class="stat-value" id="simplify-total">--</span>
            </div>
            <div class="simplify-breakdown" id="simplify-breakdown">
              <div class="bar-item" data-metric="simplify-dry"><span class="bar-label">DRY<span class="info-icon" data-tooltip="Duplicated code extractions applied" tabindex="0" aria-label="Duplicated code extractions applied">i</span></span><div class="bar-track"><div class="bar-fill" id="bar-dry"></div></div><span class="bar-val" id="val-dry">--</span></div>
              <div class="bar-item" data-metric="simplify-dead"><span class="bar-label">Dead code<span class="info-icon" data-tooltip="Unused imports, variables, or functions removed" tabindex="0" aria-label="Unused imports, variables, or functions removed">i</span></span><div class="bar-track"><div class="bar-fill" id="bar-dead"></div></div><span class="bar-val" id="val-dead">--</span></div>
              <div class="bar-item" data-metric="simplify-naming"><span class="bar-label">Naming<span class="info-icon" data-tooltip="Variable and function name improvements applied" tabindex="0" aria-label="Variable and function name improvements applied">i</span></span><div class="bar-track"><div class="bar-fill" id="bar-naming"></div></div><span class="bar-val" id="val-naming">--</span></div>
              <div class="bar-item" data-metric="simplify-complexity"><span class="bar-label">Complexity<span class="info-icon" data-tooltip="Over-engineered patterns simplified" tabindex="0" aria-label="Over-engineered patterns simplified">i</span></span><div class="bar-track"><div class="bar-fill" id="bar-complexity"></div></div><span class="bar-val" id="val-complexity">--</span></div>
              <div class="bar-item" data-metric="simplify-consistency"><span class="bar-label">Consistency<span class="info-icon" data-tooltip="Style or pattern inconsistencies corrected" tabindex="0" aria-label="Style or pattern inconsistencies corrected">i</span></span><div class="bar-track"><div class="bar-fill" id="bar-consistency"></div></div><span class="bar-val" id="val-consistency">--</span></div>
            </div>
          </div>

          <!-- Reviews -->
          <div class="quality-panel">
            <h3 class="panel-title">Reviews</h3>
            <div class="stat-row" data-metric="reviews-total">
              <span class="stat-label">Total reviews<span class="info-icon" data-tooltip="Code reviews run by the shipwright review agent" tabindex="0" aria-label="Code reviews run by the shipwright review agent">i</span></span>
              <span class="stat-value" id="review-total">--</span>
            </div>
            <div class="stat-row" data-metric="reviews-ship-it">
              <span class="stat-label">SHIP IT<span class="info-icon" data-tooltip="Reviews where no blocking issues were found" tabindex="0" aria-label="Reviews where no blocking issues were found">i</span></span>
              <span class="stat-value good" id="review-ship-it">--</span>
            </div>
            <div class="stat-row" data-metric="review-iterations">
              <span class="stat-label">Review Iterations<span class="info-icon" data-tooltip="Avg review + patch cycles per PR — an iteration-count proxy, not a findings count" tabindex="0" aria-label="Avg review + patch cycles per PR — an iteration-count proxy, not a findings count">i</span></span>
              <span class="stat-value" id="review-iterations">--</span>
            </div>
          </div>

          <!-- Coverage -->
          <div class="quality-panel">
            <h3 class="panel-title">Coverage</h3>
            <div class="stat-row">
              <span class="stat-label">Reports<span class="info-icon" data-tooltip="Tasks with a measured coverage delta" tabindex="0" aria-label="Tasks with a measured coverage delta">i</span></span>
              <span class="stat-value" id="coverage-reports">--</span>
            </div>
            <div class="stat-row">
              <span class="stat-label">Avg delta<span class="info-icon" data-tooltip="Mean change in line coverage % across all reports" tabindex="0" aria-label="Mean change in line coverage % across all reports">i</span></span>
              <span class="stat-value" id="coverage-delta">--</span>
            </div>
          </div>

          <!-- PR Commits -->
          <div class="quality-panel">
            <h3 class="panel-title">PR Commits</h3>
            <div class="stat-row" data-metric="pr-commits-total">
              <span class="stat-label">Avg per PR<span class="info-icon" data-tooltip="Fleet-wide weighted-average commits per Shipwright PR" tabindex="0" aria-label="Fleet-wide weighted-average commits per Shipwright PR">i</span></span>
              <span class="stat-value" id="pr-commits-total">--</span>
            </div>
            <div class="pr-commits-breakdown" id="pr-commits-breakdown">
              <div class="bar-item" data-metric="pr-commits-docs-refresh"><span class="bar-label">Docs refresh<span class="info-icon" data-tooltip="Avg commits for documentation updates" tabindex="0" aria-label="Avg commits for documentation updates">i</span></span><div class="bar-track"><div class="bar-fill" id="bar-pr-commits-docs-refresh"></div></div><span class="bar-val" id="val-pr-commits-docs-refresh">--</span></div>
              <div class="bar-item" data-metric="pr-commits-review-patch"><span class="bar-label">Review patch<span class="info-icon" data-tooltip="Avg commits for review feedback changes" tabindex="0" aria-label="Avg commits for review feedback changes">i</span></span><div class="bar-track"><div class="bar-fill" id="bar-pr-commits-review-patch"></div></div><span class="bar-val" id="val-pr-commits-review-patch">--</span></div>
              <div class="bar-item" data-metric="pr-commits-ci-fix"><span class="bar-label">CI fix<span class="info-icon" data-tooltip="Avg commits for CI gate fixes" tabindex="0" aria-label="Avg commits for CI gate fixes">i</span></span><div class="bar-track"><div class="bar-fill" id="bar-pr-commits-ci-fix"></div></div><span class="bar-val" id="val-pr-commits-ci-fix">--</span></div>
              <div class="bar-item" data-metric="pr-commits-implementation"><span class="bar-label">Implementation<span class="info-icon" data-tooltip="Avg commits for implementation work" tabindex="0" aria-label="Avg commits for implementation work">i</span></span><div class="bar-track"><div class="bar-fill" id="bar-pr-commits-implementation"></div></div><span class="bar-val" id="val-pr-commits-implementation">--</span></div>
            </div>
          </div>

        </div>
      </section>

      <!-- Token Usage -->
      <section class="section" aria-label="Token usage">
        <div class="section-header">
          <h2 class="section-title">Token Usage</h2>
        </div>
        <div class="token-kpi-row">
          <div class="kpi-card" data-metric="token-input">
            <div class="kpi-label">Input Tokens</div>
            <div class="kpi-value" id="token-input"><span class="skeleton">&nbsp;</span></div>
            <div class="kpi-meta">total input tokens</div>
          </div>
          <div class="kpi-card" data-metric="token-output">
            <div class="kpi-label">Output Tokens</div>
            <div class="kpi-value" id="token-output"><span class="skeleton">&nbsp;</span></div>
            <div class="kpi-meta">total output tokens</div>
          </div>
          <div class="kpi-card" data-metric="token-cache">
            <div class="kpi-label">Cache Tokens</div>
            <div class="kpi-value" id="token-cache"><span class="skeleton">&nbsp;</span></div>
            <div class="kpi-meta">cache read + creation</div>
          </div>
          <div class="kpi-card" data-metric="token-cost">
            <div class="kpi-label">Total Cost</div>
            <div class="kpi-value" id="token-cost"><span class="skeleton">&nbsp;</span></div>
            <div class="kpi-meta">total cost (USD)</div>
          </div>
        </div>
        <div class="quality-panel">
          <h3 class="panel-title">By Agent</h3>
          <table class="token-table" id="token-agent-table">
            <thead>
              <tr><th>Agent</th><th>Cron</th><th>DM/Mention</th><th>Total</th><th>Cost ($)</th></tr>
            </thead>
            <tbody id="token-agent-tbody"></tbody>
          </table>
          <p id="token-agent-empty" class="empty-state" style="display:none">No data</p>
        </div>
        <div class="token-trends-section">
          <div class="token-trends-toggles" role="group" aria-label="Token series">
            <button class="token-series-btn active" data-token-series="input" type="button">Input</button>
            <button class="token-series-btn" data-token-series="output" type="button">Output</button>
            <button class="token-series-btn" data-token-series="total" type="button">Total</button>
            <button class="token-series-btn" data-token-series="all" type="button">All</button>
          </div>
          <div class="chart-container token-trends-chart-container">
            <canvas id="token-trends-chart" aria-label="Token usage trends chart"></canvas>
          </div>
        </div>
      </section>



      <!-- Feature Breakdown -->
      <section class="section features-section" aria-label="Feature breakdown">
        <div class="section-header">
          <h2 class="section-title">Feature Breakdown</h2>
        </div>
        <div class="features-table-wrapper">
          <table class="features-table">
            <thead>
              <tr>
                <th>Feature<span class="info-icon" data-tooltip="Planning session or feature group name" tabindex="0" aria-label="Planning session or feature group name">i</span></th>
                <th>Tasks<span class="info-icon" data-tooltip="Number of tasks shipped in this feature" tabindex="0" aria-label="Number of tasks shipped in this feature">i</span></th>
                <th>Avg Hrs<span class="info-icon" data-tooltip="Mean actual hours per task" tabindex="0" aria-label="Mean actual hours per task">i</span></th>
                <th>CI Pass<span class="info-icon" data-tooltip="CI first-pass rate for this feature's tasks" tabindex="0" aria-label="CI first-pass rate for this feature's tasks">i</span></th>
                <th>Review<span class="info-icon" data-tooltip="SHIP IT rate for this feature's tasks" tabindex="0" aria-label="SHIP IT rate for this feature's tasks">i</span></th>
              </tr>
            </thead>
            <tbody id="features-tbody"></tbody>
          </table>
        </div>
        <p id="features-empty" class="empty-state" style="display:none">No feature data for this period</p>
      </section>

      <!-- Efficiency -->
      <section class="section" aria-label="Efficiency">
        <div class="section-header">
          <h2 class="section-title">Efficiency</h2>
        </div>
        <div class="efficiency-grid">
          <div class="stat-block" data-metric="avg-actual-hours">
            <span class="stat-block-value" id="eff-avg-hours">--</span>
            <span class="stat-block-label">Avg actual hours<span class="info-icon" data-tooltip="Mean wall-clock hours per task from start to PR merge" tabindex="0" aria-label="Mean wall-clock hours per task from start to PR merge">i</span></span>
          </div>
          <div class="stat-block" data-metric="avg-estimated-hours">
            <span class="stat-block-value" id="eff-est-hours">--</span>
            <span class="stat-block-label">Avg estimated hours<span class="info-icon" data-tooltip="Mean planned hours per task from the planning doc" tabindex="0" aria-label="Mean planned hours per task from the planning doc">i</span></span>
          </div>
          <div class="stat-block" data-metric="avg-retries">
            <span class="stat-block-value" id="eff-retries">--</span>
            <span class="stat-block-label">Avg retries<span class="info-icon" data-tooltip="Mean CI fix attempts needed before the CI gate passed" tabindex="0" aria-label="Mean CI fix attempts needed before the CI gate passed">i</span></span>
          </div>
          <div class="stat-block" data-metric="avg-files-changed">
            <span class="stat-block-value" id="eff-files">--</span>
            <span class="stat-block-label">Avg files changed<span class="info-icon" data-tooltip="Mean files modified per task" tabindex="0" aria-label="Mean files modified per task">i</span></span>
          </div>
        </div>
      </section>

      <!-- Trends -->
      <section class="section" aria-label="Trends">
        <div class="section-header">
          <h2 class="section-title">Trends</h2>
        </div>
        <div class="chart-container">
          <canvas id="trends-chart" aria-label="Pipeline trends chart"></canvas>
        </div>
      </section>

    </main>

    <!-- Metric Graph Modal -->
    <div id="metric-modal" class="metric-modal" role="dialog" aria-modal="true" aria-labelledby="metric-modal-title" hidden>
      <div class="metric-modal-backdrop"></div>
      <div class="metric-modal-box">
        <div class="metric-modal-header">
          <h3 class="metric-modal-title" id="metric-modal-title">Metric</h3>
          <button class="metric-modal-close" type="button" aria-label="Close modal">×</button>
        </div>
        <div class="metric-modal-body">
          <canvas id="metric-chart" aria-label="Metric trend chart"></canvas>
        </div>
      </div>
    </div>

  </div>

  <script>window.__METRICS_BASE__ = ""; window.__ADMIN_BASE__ = "";</script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
  <script src="/dashboard/app.js"></script>
</body>
</html>"
`;

exports[`renderDashboardPage — PCE-1.4 Cost Efficiency card readOnly page snapshot matches 1`] = `
"<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="light dark" />
  <title>Metrics — Vitals OS</title>
  <script>(function(){var t="light";try{var s=localStorage.getItem("shipwright-theme");if(s==="dark"||s==="light"){t=s}else if(window.matchMedia&&window.matchMedia("(prefers-color-scheme: dark)").matches){t="dark"}}catch(e){}document.documentElement.setAttribute("data-theme",t)})();</script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    :root { color-scheme: light; --vos-bg: #f7f7fb; --vos-surface: #ffffff; --vos-surface-muted: #f9fafb; --vos-surface-subtle: #f3f4f6; --vos-border: #e8e8ee; --vos-border-strong: #d1d5db; --vos-text: #1a1a2e; --vos-text-body: #374151; --vos-text-muted: #6b7280; --vos-text-faint: #9ca3af; --vos-brand: #4f46e5; --vos-brand-strong: #4338ca; --vos-brand-bg: #eef2ff; --vos-brand-border: #c7d2fe; --vos-on-brand: #ffffff; --vos-primary: #1a1a2e; --vos-primary-hover: #2d2d4e; --vos-primary-text: #ffffff; --vos-success-bg: #d1fae5; --vos-success-text: #065f46; --vos-success-border: #a7f3d0; --vos-warning-bg: #fef3c7; --vos-warning-text: #92400e; --vos-warning-border: #fde68a; --vos-danger: #dc2626; --vos-danger-text: #b91c1c; --vos-danger-bg: #fee2e2; --vos-danger-border: #fecaca; --vos-info-bg: #dbeafe; --vos-info-text: #1e40af; --vos-info-border: #93c5fd; --vos-violet-bg: #ede9fe; --vos-violet-text: #5b21b6; --vos-teal-bg: #ccfbf1; --vos-teal-text: #0f766e; }
    :root[data-theme="dark"] { color-scheme: dark; --vos-bg: #0f1117; --vos-surface: #171a22; --vos-surface-muted: #1b1f29; --vos-surface-subtle: #1f2330; --vos-border: #2a2f3d; --vos-border-strong: #3a4052; --vos-text: #e6e8ef; --vos-text-body: #c9cdd8; --vos-text-muted: #a3a9b8; --vos-text-faint: #8891a3; --vos-brand: #818cf8; --vos-brand-strong: #a5b4fc; --vos-brand-bg: #23264a; --vos-brand-border: #3b3f7a; --vos-on-brand: #0f1117; --vos-primary: #e6e8ef; --vos-primary-hover: #ffffff; --vos-primary-text: #0f1117; --vos-success-bg: #0f2e1d; --vos-success-text: #86efac; --vos-success-border: #14532d; --vos-warning-bg: #3a2a0c; --vos-warning-text: #fcd34d; --vos-warning-border: #78350f; --vos-danger: #f87171; --vos-danger-text: #fca5a5; --vos-danger-bg: #3b1518; --vos-danger-border: #7f1d1d; --vos-info-bg: #16264a; --vos-info-text: #93c5fd; --vos-info-border: #1e3a8a; --vos-violet-bg: #2a1f4d; --vos-violet-text: #c4b5fd; --vos-teal-bg: #0f2f2c; --vos-teal-text: #5eead4; }
    :root[data-theme="dark"] textarea, :root[data-theme="dark"] select, :root[data-theme="dark"] input:not([type="checkbox"]):not([type="radio"]):not([type="range"]) { background-color: var(--vos-surface); color: var(--vos-text); }
    html { font-size: 16px; -webkit-font-smoothing: antialiased; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background: var(--vos-bg);
      color: var(--vos-text);
      min-height: 100vh;
    }

    /* ─── Toolbar ───────────────────────────────────────── */
    .vos-toolbar {
      background: var(--vos-surface);
      border-bottom: 1px solid var(--vos-border);
      height: 52px;
      display: flex;
      align-items: center;
      padding: 0 24px;
      gap: 24px;
      position: sticky;
      top: 0;
      z-index: 100;
    }
    .vos-wordmark {
      font-size: 15px;
      font-weight: 700;
      color: var(--vos-text);
      text-decoration: none;
      letter-spacing: -0.3px;
      flex-shrink: 0;
    }
    .vos-wordmark:hover { color: var(--vos-brand); }
    .vos-nav {
      display: flex;
      align-items: center;
      gap: 4px;
      flex: 1;
    }
    .vos-nav-link {
      padding: 5px 12px;
      border-radius: 6px;
      font-size: 13px;
      font-weight: 500;
      color: var(--vos-text-muted);
      text-decoration: none;
      transition: background 0.1s, color 0.1s;
      white-space: nowrap;
    }
    .vos-nav-link:hover { background: var(--vos-surface-subtle); color: var(--vos-text); }
    .vos-nav-link.active {
      background: var(--vos-brand-bg);
      color: var(--vos-brand);
      font-weight: 600;
    }
    .vos-user {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-shrink: 0;
      margin-left: auto;
    }
    .vos-username {
      font-size: 13px;
      color: var(--vos-text-muted);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 160px;
    }
    .vos-signout-btn {
      font-size: 13px;
      font-weight: 500;
      color: var(--vos-text-muted);
      background: none;
      border: 1px solid var(--vos-border);
      border-radius: 6px;
      padding: 5px 12px;
      cursor: pointer;
      font-family: inherit;
      transition: background 0.1s, color 0.1s, border-color 0.1s;
      white-space: nowrap;
    }
    .vos-signout-btn:hover { background: var(--vos-bg); color: var(--vos-text); border-color: var(--vos-border-strong); }

    /* ─── Page body ─────────────────────────────────────── */
    .vos-theme-toggle {
      font-size: 13px;
      font-weight: 500;
      color: var(--vos-text-muted);
      background: none;
      border: 1px solid var(--vos-border);
      border-radius: 6px;
      padding: 5px 12px;
      min-height: 28px;
      cursor: pointer;
      white-space: nowrap;
      transition: background 0.1s, color 0.1s, border-color 0.1s;
    }
    .vos-theme-toggle:hover { background: var(--vos-bg); color: var(--vos-text); border-color: var(--vos-border-strong); }
    .vos-theme-toggle[aria-pressed="true"] { background: var(--vos-brand-bg); color: var(--vos-brand); border-color: var(--vos-brand-border); }
    .vos-page {
      max-width: 960px;
      margin: 0 auto;
      padding: 32px 24px 64px;
    }
    .vos-page-wide { max-width: none; width: 100%; }

    /* ─── Hamburger toggle (CSS-only, no JS) ───────────── */
    .vos-nav-toggle { display: none; }
    .vos-hamburger {
      display: none;
      background: none;
      border: none;
      font-size: 20px;
      cursor: pointer;
      color: var(--vos-text);
      padding: 4px 8px;
      line-height: 1;
      font-family: inherit;
    }
    .vos-hamburger:hover { color: var(--vos-brand); }

    @media (max-width: 640px) {
      .vos-toolbar { padding: 0 16px; gap: 12px; flex-wrap: wrap; height: auto; min-height: 52px; align-items: center; }
      .vos-username { display: none; }
      .vos-nav-link { padding: 5px 8px; }
      .vos-page { padding: 20px 16px 48px; }

      /* Hide nav links by default on mobile */
      .vos-nav {
        display: none;
        flex-direction: column;
        width: 100%;
        gap: 2px;
        padding: 8px 0;
        order: 3;
      }
      /* Show nav links when hamburger checkbox is checked */
      .vos-nav-toggle:checked + nav .vos-nav {
        display: flex;
      }
      .vos-nav-link {
        display: block;
        padding: 10px 12px;
        border-radius: 6px;
        font-size: 14px;
      }
      .vos-nav-link.active {
        background: var(--vos-brand-bg);
        color: var(--vos-brand);
        font-weight: 600;
      }
      /* Show hamburger on mobile */
      .vos-hamburger {
        display: block;
      }
      /* Hide user section sign-out on mobile when nav is closed */
      .vos-user {
        order: 2;
        margin-left: 0;
      }
    }

  </style>
  <link rel="stylesheet" href="/dashboard/styles.css" />
</head>
<body>
  <input type="checkbox" id="vos-nav-toggle" class="vos-nav-toggle" aria-hidden="true">
  <nav class="vos-toolbar" aria-label="Site navigation">
    <a href="/dashboard" class="vos-wordmark">Shipwright</a>
    <div id="vos-nav-content" class="vos-nav">
      <a href="/dashboard" class="vos-nav-link active">Metrics</a>
      <a href="/tasks" class="vos-nav-link">Tasks</a>
    </div>
    <div class="vos-user">
      <button type="button" id="vos-theme-toggle" class="vos-theme-toggle" aria-pressed="false">Dark mode</button>
    </div>
    <label for="vos-nav-toggle" class="vos-hamburger" aria-label="Toggle navigation" aria-expanded="false" aria-controls="vos-nav-content">☰</label>
  </nav>
  <script>(function(){var t=document.getElementById('vos-nav-toggle');if(t)t.addEventListener('change',function(){var l=document.querySelector('label[for="vos-nav-toggle"]');if(l)l.setAttribute('aria-expanded',t.checked?'true':'false');});})();</script>
  <script>(function(){var d=document,r=d.documentElement,k="shipwright-theme",q=window.matchMedia?window.matchMedia("(prefers-color-scheme: dark)"):null;function saved(){try{var s=localStorage.getItem(k);return s==="dark"||s==="light"?s:null}catch(e){return null}}function apply(t){r.setAttribute("data-theme",t);var b=d.getElementById("vos-theme-toggle");if(b)b.setAttribute("aria-pressed",t==="dark"?"true":"false");d.dispatchEvent(new CustomEvent("vos-theme-change",{detail:{theme:t}}))}apply(saved()||(q&&q.matches?"dark":"light"));var b=d.getElementById("vos-theme-toggle");if(b)b.addEventListener("click",function(){var t=r.getAttribute("data-theme")==="dark"?"light":"dark";try{localStorage.setItem(k,t)}catch(e){}apply(t)});if(q&&q.addEventListener)q.addEventListener("change",function(e){if(!saved())apply(e.matches?"dark":"light")})})();</script>
  <div class="app">

    <!-- Page Controls -->
    <div class="page-controls">
      <div class="date-range-picker" role="group" aria-label="Date range">
        <button class="date-btn active" data-range="today" type="button">1D</button>
        <button class="date-btn" data-range="7d" type="button">7D</button>
        <button class="date-btn" data-range="30d" type="button">30D</button>
        <button class="date-btn" data-range="90d" type="button">90D</button>
      </div>
      <div class="page-meta">
        <button id="theme-toggle" class="theme-toggle" type="button" aria-pressed="false">Dark mode</button>
        <span id="freshness-indicator" class="freshness" aria-live="polite"></span>
        <span id="refresh-countdown" class="countdown" aria-live="polite"></span>
      </div>
    </div>

    <!-- Main -->
    <main class="main">

      <!-- KPI Cards -->
      <section class="section" aria-label="Key performance indicators">
        <div class="section-header">
          <h2 class="section-title">Overview</h2>
          <span class="section-badge" id="task-count-badge">0 tasks</span>
        </div>
        <div class="kpi-grid">
          <div class="kpi-card" data-metric="tasks-completed">
            <div class="kpi-label">Tasks Completed<span class="info-icon" data-tooltip="Total tasks shipped as merged PRs in the selected period" tabindex="0" aria-label="Total tasks shipped as merged PRs in the selected period">i</span></div>
            <div class="kpi-value" id="kpi-tasks"><span class="skeleton">&nbsp;</span></div>
            <div class="kpi-meta">shipwright_task_completed events</div>
          </div>
          <div class="kpi-card" data-metric="ci-first-pass">
            <div class="kpi-label">CI First-Pass Rate<span class="info-icon" data-tooltip="% of CI gate runs that passed without any fix attempts" tabindex="0" aria-label="% of CI gate runs that passed without any fix attempts">i</span></div>
            <div class="kpi-value" id="kpi-ci-rate"><span class="skeleton">&nbsp;</span></div>
            <div class="kpi-meta">passed_first_try / total gates</div>
          </div>
          <div class="kpi-card" data-metric="shipwright-prs-merged">
            <div class="kpi-label">Shipwright PRs Merged<span class="info-icon" data-tooltip="PRs authored by Shipwright that were merged in the selected period" tabindex="0" aria-label="PRs authored by Shipwright that were merged in the selected period">i</span></div>
            <div class="kpi-value" id="kpi-shipwright-prs"><span class="skeleton">&nbsp;</span></div>
            <div class="kpi-meta">origin=shipwright, state=merged</div>
          </div>
          <div class="kpi-card" data-metric="review-ship-it">
            <div class="kpi-label">Review SHIP IT Rate<span class="info-icon" data-tooltip="% of code reviews that received an immediate ship-it verdict" tabindex="0" aria-label="% of code reviews that received an immediate ship-it verdict">i</span></div>
            <div class="kpi-value" id="kpi-review-rate"><span class="skeleton">&nbsp;</span></div>
            <div class="kpi-meta">SHIP IT / total reviews</div>
          </div>
        </div>
      </section>

      <!-- Merged PRs by repo -->
      <section class="section" aria-label="Merged PRs by repo">
        <div class="section-header">
          <h2 class="section-title">Merged PRs by repo</h2>
        </div>
        <div id="merged-prs-content">
          <div class="merged-prs-repo-picker" id="merged-prs-repo-picker" style="display:none">
            <label for="merged-prs-repo-select">Repo</label>
            <select id="merged-prs-repo-select"></select>
          </div>
          <div class="merged-prs-charts">
            <div class="chart-container">
              <canvas id="merged-prs-bar-chart" aria-label="Merged PRs by repo and origin"></canvas>
            </div>
            <div class="chart-container">
              <canvas id="merged-prs-trend-chart" aria-label="Merged PRs trend by origin over time"></canvas>
            </div>
          </div>
        </div>
        <p id="merged-prs-empty" class="empty-state" style="display:none">No merged PRs in this range</p>
      </section>





      <!-- Pipeline Quality -->
      <section class="section" aria-label="Pipeline quality">
        <div class="section-header">
          <h2 class="section-title">Pipeline Quality</h2>
        </div>
        <div class="quality-grid">

          <!-- CI Gates -->
          <div class="quality-panel">
            <h3 class="panel-title">CI Gates</h3>
            <div class="stat-row" data-metric="ci-gates">
              <span class="stat-label">Total gates<span class="info-icon" data-tooltip="Total CI runs triggered by PRs in the period" tabindex="0" aria-label="Total CI runs triggered by PRs in the period">i</span></span>
              <span class="stat-value" id="ci-total">--</span>
            </div>
            <div class="stat-row" data-metric="ci-first-pass-count">
              <span class="stat-label">First-pass<span class="info-icon" data-tooltip="CI runs that passed without any fix commits" tabindex="0" aria-label="CI runs that passed without any fix commits">i</span></span>
              <span class="stat-value" id="ci-first">--</span>
            </div>
            <div class="stat-row" data-metric="avg-fix-attempts">
              <span class="stat-label">Avg fix attempts<span class="info-icon" data-tooltip="Mean number of fix commits needed before CI passed" tabindex="0" aria-label="Mean number of fix commits needed before CI passed">i</span></span>
              <span class="stat-value" id="ci-fix-avg">--</span>
            </div>
          </div>

          <!-- Simplify -->
          <div class="quality-panel">
            <h3 class="panel-title">Simplify Fixes</h3>
            <div class="stat-row" data-metric="simplify-total">
              <span class="stat-label">Total fixes<span class="info-icon" data-tooltip="Code simplifications applied automatically after implementation" tabindex="0" aria-label="Code simplifications applied automatically after implementation">i</span></span>
              <span class="stat-value" id="simplify-total">--</span>
            </div>
            <div class="simplify-breakdown" id="simplify-breakdown">
              <div class="bar-item" data-metric="simplify-dry"><span class="bar-label">DRY<span class="info-icon" data-tooltip="Duplicated code extractions applied" tabindex="0" aria-label="Duplicated code extractions applied">i</span></span><div class="bar-track"><div class="bar-fill" id="bar-dry"></div></div><span class="bar-val" id="val-dry">--</span></div>
              <div class="bar-item" data-metric="simplify-dead"><span class="bar-label">Dead code<span class="info-icon" data-tooltip="Unused imports, variables, or functions removed" tabindex="0" aria-label="Unused imports, variables, or functions removed">i</span></span><div class="bar-track"><div class="bar-fill" id="bar-dead"></div></div><span class="bar-val" id="val-dead">--</span></div>
              <div class="bar-item" data-metric="simplify-naming"><span class="bar-label">Naming<span class="info-icon" data-tooltip="Variable and function name improvements applied" tabindex="0" aria-label="Variable and function name improvements applied">i</span></span><div class="bar-track"><div class="bar-fill" id="bar-naming"></div></div><span class="bar-val" id="val-naming">--</span></div>
              <div class="bar-item" data-metric="simplify-complexity"><span class="bar-label">Complexity<span class="info-icon" data-tooltip="Over-engineered patterns simplified" tabindex="0" aria-label="Over-engineered patterns simplified">i</span></span><div class="bar-track"><div class="bar-fill" id="bar-complexity"></div></div><span class="bar-val" id="val-complexity">--</span></div>
              <div class="bar-item" data-metric="simplify-consistency"><span class="bar-label">Consistency<span class="info-icon" data-tooltip="Style or pattern inconsistencies corrected" tabindex="0" aria-label="Style or pattern inconsistencies corrected">i</span></span><div class="bar-track"><div class="bar-fill" id="bar-consistency"></div></div><span class="bar-val" id="val-consistency">--</span></div>
            </div>
          </div>

          <!-- Reviews -->
          <div class="quality-panel">
            <h3 class="panel-title">Reviews</h3>
            <div class="stat-row" data-metric="reviews-total">
              <span class="stat-label">Total reviews<span class="info-icon" data-tooltip="Code reviews run by the shipwright review agent" tabindex="0" aria-label="Code reviews run by the shipwright review agent">i</span></span>
              <span class="stat-value" id="review-total">--</span>
            </div>
            <div class="stat-row" data-metric="reviews-ship-it">
              <span class="stat-label">SHIP IT<span class="info-icon" data-tooltip="Reviews where no blocking issues were found" tabindex="0" aria-label="Reviews where no blocking issues were found">i</span></span>
              <span class="stat-value good" id="review-ship-it">--</span>
            </div>
            <div class="stat-row" data-metric="review-iterations">
              <span class="stat-label">Review Iterations<span class="info-icon" data-tooltip="Avg review + patch cycles per PR — an iteration-count proxy, not a findings count" tabindex="0" aria-label="Avg review + patch cycles per PR — an iteration-count proxy, not a findings count">i</span></span>
              <span class="stat-value" id="review-iterations">--</span>
            </div>
          </div>

          <!-- Coverage -->
          <div class="quality-panel">
            <h3 class="panel-title">Coverage</h3>
            <div class="stat-row">
              <span class="stat-label">Reports<span class="info-icon" data-tooltip="Tasks with a measured coverage delta" tabindex="0" aria-label="Tasks with a measured coverage delta">i</span></span>
              <span class="stat-value" id="coverage-reports">--</span>
            </div>
            <div class="stat-row">
              <span class="stat-label">Avg delta<span class="info-icon" data-tooltip="Mean change in line coverage % across all reports" tabindex="0" aria-label="Mean change in line coverage % across all reports">i</span></span>
              <span class="stat-value" id="coverage-delta">--</span>
            </div>
          </div>

          <!-- PR Commits -->
          <div class="quality-panel">
            <h3 class="panel-title">PR Commits</h3>
            <div class="stat-row" data-metric="pr-commits-total">
              <span class="stat-label">Avg per PR<span class="info-icon" data-tooltip="Fleet-wide weighted-average commits per Shipwright PR" tabindex="0" aria-label="Fleet-wide weighted-average commits per Shipwright PR">i</span></span>
              <span class="stat-value" id="pr-commits-total">--</span>
            </div>
            <div class="pr-commits-breakdown" id="pr-commits-breakdown">
              <div class="bar-item" data-metric="pr-commits-docs-refresh"><span class="bar-label">Docs refresh<span class="info-icon" data-tooltip="Avg commits for documentation updates" tabindex="0" aria-label="Avg commits for documentation updates">i</span></span><div class="bar-track"><div class="bar-fill" id="bar-pr-commits-docs-refresh"></div></div><span class="bar-val" id="val-pr-commits-docs-refresh">--</span></div>
              <div class="bar-item" data-metric="pr-commits-review-patch"><span class="bar-label">Review patch<span class="info-icon" data-tooltip="Avg commits for review feedback changes" tabindex="0" aria-label="Avg commits for review feedback changes">i</span></span><div class="bar-track"><div class="bar-fill" id="bar-pr-commits-review-patch"></div></div><span class="bar-val" id="val-pr-commits-review-patch">--</span></div>
              <div class="bar-item" data-metric="pr-commits-ci-fix"><span class="bar-label">CI fix<span class="info-icon" data-tooltip="Avg commits for CI gate fixes" tabindex="0" aria-label="Avg commits for CI gate fixes">i</span></span><div class="bar-track"><div class="bar-fill" id="bar-pr-commits-ci-fix"></div></div><span class="bar-val" id="val-pr-commits-ci-fix">--</span></div>
              <div class="bar-item" data-metric="pr-commits-implementation"><span class="bar-label">Implementation<span class="info-icon" data-tooltip="Avg commits for implementation work" tabindex="0" aria-label="Avg commits for implementation work">i</span></span><div class="bar-track"><div class="bar-fill" id="bar-pr-commits-implementation"></div></div><span class="bar-val" id="val-pr-commits-implementation">--</span></div>
            </div>
          </div>

        </div>
      </section>



      <!-- Cost Efficiency -->
      <section class="section" id="cost-efficiency-section" aria-label="Cost efficiency">
        <div class="section-header">
          <h2 class="section-title">Cost Efficiency</h2>
        </div>
        <div id="ce-content">
          <div class="model-mix-bar" id="ce-model-bar" aria-label="Model mix by cost share">
            <div class="model-bar-segment model-bar-haiku" id="ce-bar-haiku" style="flex-basis:0%"></div>
            <div class="model-bar-segment model-bar-sonnet" id="ce-bar-sonnet" style="flex-basis:100%"></div>
            <div class="model-bar-segment model-bar-opus" id="ce-bar-opus" style="flex-basis:0%"></div>
          </div>
          <div class="model-mix-legend" id="ce-legend">
            <span class="legend-item haiku"><span class="legend-swatch model-bar-haiku"></span><span id="ce-legend-haiku">Haiku --</span></span>
            <span class="legend-item sonnet"><span class="legend-swatch model-bar-sonnet"></span><span id="ce-legend-sonnet">Sonnet --</span></span>
            <span class="legend-item opus"><span class="legend-swatch model-bar-opus"></span><span id="ce-legend-opus">Opus --</span></span>
          </div>
          <div class="ce-kpi-row">
            <div class="kpi-card">
              <div class="kpi-label">Routed Cost</div>
              <div class="kpi-value" id="ce-routed"><span class="skeleton">&nbsp;</span></div>
              <div class="kpi-meta">actual spend</div>
            </div>
            <div class="kpi-card">
              <div class="kpi-label">All-Opus Cost</div>
              <div class="kpi-value" id="ce-opus"><span class="skeleton">&nbsp;</span></div>
              <div class="kpi-meta">hypothetical all-opus</div>
            </div>
          </div>
          <div class="ce-savings-highlight" id="ce-savings-line">
            <span id="ce-savings-text"><span class="skeleton">&nbsp;</span></span>
          </div>
          <p class="ce-empty" id="ce-empty" style="display:none">No cost data for this period</p>
          <p class="ce-limited" id="ce-limited" style="display:none">Limited sample — savings % only</p>
          <p class="ce-caveat">all-Opus assumes identical token counts re-priced at Opus rates</p>
        </div>
      </section>

      <!-- Feature Breakdown -->
      <section class="section features-section" aria-label="Feature breakdown">
        <div class="section-header">
          <h2 class="section-title">Feature Breakdown</h2>
        </div>
        <div class="features-table-wrapper">
          <table class="features-table">
            <thead>
              <tr>
                <th>Feature<span class="info-icon" data-tooltip="Planning session or feature group name" tabindex="0" aria-label="Planning session or feature group name">i</span></th>
                <th>Tasks<span class="info-icon" data-tooltip="Number of tasks shipped in this feature" tabindex="0" aria-label="Number of tasks shipped in this feature">i</span></th>
                <th>Avg Hrs<span class="info-icon" data-tooltip="Mean actual hours per task" tabindex="0" aria-label="Mean actual hours per task">i</span></th>
                <th>CI Pass<span class="info-icon" data-tooltip="CI first-pass rate for this feature's tasks" tabindex="0" aria-label="CI first-pass rate for this feature's tasks">i</span></th>
                <th>Review<span class="info-icon" data-tooltip="SHIP IT rate for this feature's tasks" tabindex="0" aria-label="SHIP IT rate for this feature's tasks">i</span></th>
              </tr>
            </thead>
            <tbody id="features-tbody"></tbody>
          </table>
        </div>
        <p id="features-empty" class="empty-state" style="display:none">No feature data for this period</p>
      </section>

      <!-- Efficiency -->
      <section class="section" aria-label="Efficiency">
        <div class="section-header">
          <h2 class="section-title">Efficiency</h2>
        </div>
        <div class="efficiency-grid">
          <div class="stat-block" data-metric="avg-actual-hours">
            <span class="stat-block-value" id="eff-avg-hours">--</span>
            <span class="stat-block-label">Avg actual hours<span class="info-icon" data-tooltip="Mean wall-clock hours per task from start to PR merge" tabindex="0" aria-label="Mean wall-clock hours per task from start to PR merge">i</span></span>
          </div>
          <div class="stat-block" data-metric="avg-estimated-hours">
            <span class="stat-block-value" id="eff-est-hours">--</span>
            <span class="stat-block-label">Avg estimated hours<span class="info-icon" data-tooltip="Mean planned hours per task from the planning doc" tabindex="0" aria-label="Mean planned hours per task from the planning doc">i</span></span>
          </div>
          <div class="stat-block" data-metric="avg-retries">
            <span class="stat-block-value" id="eff-retries">--</span>
            <span class="stat-block-label">Avg retries<span class="info-icon" data-tooltip="Mean CI fix attempts needed before the CI gate passed" tabindex="0" aria-label="Mean CI fix attempts needed before the CI gate passed">i</span></span>
          </div>
          <div class="stat-block" data-metric="avg-files-changed">
            <span class="stat-block-value" id="eff-files">--</span>
            <span class="stat-block-label">Avg files changed<span class="info-icon" data-tooltip="Mean files modified per task" tabindex="0" aria-label="Mean files modified per task">i</span></span>
          </div>
        </div>
      </section>

      <!-- Trends -->
      <section class="section" aria-label="Trends">
        <div class="section-header">
          <h2 class="section-title">Trends</h2>
        </div>
        <div class="chart-container">
          <canvas id="trends-chart" aria-label="Pipeline trends chart"></canvas>
        </div>
      </section>

    </main>

    <!-- Metric Graph Modal -->
    <div id="metric-modal" class="metric-modal" role="dialog" aria-modal="true" aria-labelledby="metric-modal-title" hidden>
      <div class="metric-modal-backdrop"></div>
      <div class="metric-modal-box">
        <div class="metric-modal-header">
          <h3 class="metric-modal-title" id="metric-modal-title">Metric</h3>
          <button class="metric-modal-close" type="button" aria-label="Close modal">×</button>
        </div>
        <div class="metric-modal-body">
          <canvas id="metric-chart" aria-label="Metric trend chart"></canvas>
        </div>
      </div>
    </div>

  </div>

  <script>window.__METRICS_BASE__ = ""; window.__ADMIN_BASE__ = "";</script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
  <script src="/dashboard/app.js"></script>
</body>
</html>"
`;
