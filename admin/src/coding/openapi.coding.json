{
  "openapi": "3.1.0",
  "info": {
    "title": "Shipwright Admin API (coding extension)",
    "version": "0.1.0",
    "description": "The coding admin extension's routes alone — the part of admin/openapi.json not served by the platform admin."
  },
  "paths": {
    "/agents/{id}/phase-methodology": {
      "get": {
        "summary": "List phase-methodology overrides",
        "description": "Returns every phase-methodology override configured for the agent — which subagent type handles each pipeline phase (prd, plan-session, review, patch, deploy, dev-task). A phase with no explicit override is simply absent from this list; see GET /agents/:id/config's `phaseMethodology` map for the full six-phase view with defaults filled in.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "clx1234567890"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "List of phase-methodology overrides",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PhaseMethodologyListWrapper"
                }
              }
            }
          },
          "404": {
            "description": "Agent not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/agents/{id}/phase-methodology/{phase}": {
      "put": {
        "summary": "Set a phase's subagent-type override",
        "description": "Upserts the `subagentType` override for one pipeline phase. Passing `subagentType: null` clears the override (the phase falls back to its default methodology). For the `review` phase only, `subagentType` may be a comma-separated list of up to 5 subagent types; entries are trimmed, duplicates dropped, and empty entries rejected. Any other phase rejects a multi-value list with a 400. `phase` must be one of prd, plan-session, review, patch, deploy, dev-task.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "clx1234567890"
            },
            "required": true,
            "name": "id",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "prd",
                "plan-session",
                "review",
                "patch",
                "deploy",
                "dev-task"
              ],
              "example": "review"
            },
            "required": true,
            "name": "phase",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PutAgentPhaseMethodologyBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Phase-methodology override upserted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PhaseMethodologyWrapper"
                }
              }
            }
          },
          "400": {
            "description": "Bad request — invalid phase, or an invalid/disallowed subagentType list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Agent not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/agents/all/cron-runs/dev-task-adherence": {
      "get": {
        "summary": "Get dev-task adherence report",
        "description": "Admin-only. Per dev-task run, compares skill-usage subagent dispatches against the required-steps table and reports per-step ran/skipped, with per-step adherence rates overall, per variant (contextFingerprint) and per commandVariant (default vs alternate). Rates cover task-bearing runs only (dispatched against a work item); `counts` separates them from silent no-ready-task ticks. A dispatch proves a step started, not that it was done well. Each series also carries `outcomes` (DTA-8.2): PRs, mean patch/review cycles, share of tasks with 0 and 2+ patch cycles, CI first-pass rate and mean ciFixAttempts, computed over tasks whose runs all used one arm; tasks that ran in more than one commandVariant are excluded and reported as `counts.mixedTasks`. Each series also carries `cost` (DTA-9.3): mean cost per run and token totals summed from the run's model breakdown (arm series exclude mixed-arm tasks; overall keeps every run). With `command=patch`, each series also carries `patchGuardrails` — repeat-patch rate (patched again after a push), CI-green-after-patch rate (a proxy: patched PRs with no CI failure recorded) and mean patch cycles over single-arm PRs — and `counts.mixedPrs` reports PRs that ran in both arms. Optional `from`/`to` ISO datetime params bound startedAt. Optional `command` (`dev-task` default, or `patch`) selects which phase to score: patch runs are scored against the patch required-steps table (lane-agnostic first cut; fix dispatch and PR-record push proof measured, other steps unmeasured) and grouped by commandVariant, with `command` echoed in the response.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "date-time",
              "example": "2026-01-01T00:00:00Z"
            },
            "required": false,
            "name": "from",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "date-time",
              "example": "2026-02-01T00:00:00Z"
            },
            "required": false,
            "name": "to",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "dev-task",
                "patch"
              ],
              "example": "patch",
              "description": "Command to score by phase: `dev-task` (default; output unchanged) or `patch`. Patch is scored lane-agnostically against its required-steps table."
            },
            "required": false,
            "description": "Command to score by phase: `dev-task` (default; output unchanged) or `patch`. Patch is scored lane-agnostically against its required-steps table.",
            "name": "command",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Dev-task adherence report",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {}
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden — requires admin scope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Adherence reporting not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/agents/{id}/dev-task-adherence": {
      "get": {
        "summary": "Get this agent's dev-task adherence report",
        "description": "Self-serve variant of the fleet-wide dev-task adherence report, scoped to the agent in the path. Access is gated by the generic agent-route auth (an agent's own bearer token, an admin, or a member session) — no admin scope required. Same report shape and optional `from`/`to`/`command` params as GET /agents/all/cron-runs/dev-task-adherence.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "clx1234567890"
            },
            "required": true,
            "name": "id",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "format": "date-time",
              "example": "2026-01-01T00:00:00Z"
            },
            "required": false,
            "name": "from",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "date-time",
              "example": "2026-02-01T00:00:00Z"
            },
            "required": false,
            "name": "to",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "dev-task",
                "patch"
              ],
              "example": "patch",
              "description": "Command to score by phase: `dev-task` (default; output unchanged) or `patch`. Patch is scored lane-agnostically against its required-steps table."
            },
            "required": false,
            "description": "Command to score by phase: `dev-task` (default; output unchanged) or `patch`. Patch is scored lane-agnostically against its required-steps table.",
            "name": "command",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Dev-task adherence report for this agent's runs only",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": {}
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Adherence reporting not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/agents/{id}/work-queue": {
      "post": {
        "summary": "Push a work-queue snapshot",
        "description": "Upserts the agent's single ranked work-queue snapshot (tasks/PRs across pipeline phases), overwriting any prior snapshot — there is no history.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "clx1234567890"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PushWorkQueueSnapshotBody"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Snapshot upserted (overwrites any prior snapshot for this agent)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkQueueSnapshotWrapper"
                }
              }
            }
          },
          "400": {
            "description": "Bad request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Get the latest work-queue snapshot",
        "description": "Returns the most recently pushed work-queue snapshot, or 404 if the agent has never pushed one.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "clx1234567890"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Latest work-queue snapshot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkQueueSnapshotWrapper"
                }
              }
            }
          },
          "404": {
            "description": "No snapshot pushed yet",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/session-follows": {
      "get": {
        "summary": "List the caller's followed sessions",
        "description": "Returns the session slugs of the non-muted SessionFollow rows belonging to the signed-in user. The user is taken from the verified session token (`admin_session` cookie) — never from the request — so a caller can only read their own follows. Bearer credentials (agent tokens, admin API keys) carry no user identity and are rejected with 403.",
        "responses": {
          "200": {
            "description": "Non-muted followed session slugs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionFollowsResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Credential is not bound to a user (bearer token)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Session follows not configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "PhaseMethodologyListWrapper": {
        "type": "object",
        "properties": {
          "phaseMethodology": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AgentPhaseMethodology"
            }
          }
        },
        "required": [
          "phaseMethodology"
        ]
      },
      "AgentPhaseMethodology": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "clx1234567890"
          },
          "agentId": {
            "type": "string",
            "example": "clx1234567890"
          },
          "phase": {
            "type": "string",
            "enum": [
              "prd",
              "plan-session",
              "review",
              "patch",
              "deploy",
              "dev-task"
            ],
            "example": "review"
          },
          "subagentType": {
            "type": [
              "string",
              "null"
            ],
            "example": "shipwright:code-reviewer"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-01-01T00:00:00.000Z"
          }
        },
        "required": [
          "id",
          "agentId",
          "phase",
          "subagentType",
          "updatedAt"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "not found"
          }
        },
        "required": [
          "error"
        ]
      },
      "PhaseMethodologyWrapper": {
        "type": "object",
        "properties": {
          "phaseMethodology": {
            "$ref": "#/components/schemas/AgentPhaseMethodology"
          }
        },
        "required": [
          "phaseMethodology"
        ]
      },
      "PutAgentPhaseMethodologyBody": {
        "type": "object",
        "properties": {
          "subagentType": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "example": "shipwright:code-reviewer",
            "description": "Subagent type for the phase, or null to clear. For the `review` phase only, a comma-separated list of up to 5 types (trimmed, de-duplicated, no empty entries); other phases accept a single value."
          }
        },
        "required": [
          "subagentType"
        ]
      },
      "WorkQueueSnapshotWrapper": {
        "type": "object",
        "properties": {
          "snapshot": {
            "$ref": "#/components/schemas/AgentWorkQueueSnapshot"
          }
        },
        "required": [
          "snapshot"
        ]
      },
      "AgentWorkQueueSnapshot": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "clx1234567890"
          },
          "agentId": {
            "type": "string",
            "example": "clx1234567890"
          },
          "computedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-01-01T00:00:00.000Z"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RankedWorkItem"
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-01-01T00:00:00.000Z"
          }
        },
        "required": [
          "id",
          "agentId",
          "computedAt",
          "items",
          "createdAt"
        ]
      },
      "RankedWorkItem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "task",
              "pr"
            ],
            "example": "task"
          },
          "id": {
            "type": "string",
            "example": "WLS-2.2"
          },
          "title": {
            "type": "string",
            "example": "Add work queue snapshot endpoints"
          },
          "phase": {
            "type": "string",
            "enum": [
              "dev-task",
              "plan",
              "review",
              "patch",
              "merge"
            ],
            "example": "dev-task"
          },
          "age": {
            "type": "string",
            "example": "2026-01-01T00:00:00.000Z",
            "description": "ISO timestamp"
          }
        },
        "required": [
          "type",
          "id",
          "phase",
          "age"
        ]
      },
      "PushWorkQueueSnapshotBody": {
        "type": "object",
        "properties": {
          "computedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-01-01T00:00:00.000Z"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RankedWorkItem"
            }
          }
        },
        "required": [
          "computedAt",
          "items"
        ]
      },
      "SessionFollowsResponse": {
        "type": "object",
        "properties": {
          "sessionSlugs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Slugs of the sessions the caller follows and has not muted"
          }
        },
        "required": [
          "sessionSlugs"
        ]
      }
    }
  }
}
