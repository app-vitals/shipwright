{
  "name": "@shipwright/admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/main.ts",
  "description": "Shipwright's admin: the composition root (src/main.ts) that boots the platform admin from @app-vitals/agent-admin with the coding extension (src/coding)",
  "exports": {
    "./main": "./src/main.ts",
    "./coding/*": "./src/coding/*.ts",
    "./openapi.json": "./openapi.json",
    "./prisma.config": "./prisma.config.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "NODE_ENV=test bun test",
    "test:e2e": "bunx playwright test",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate deploy"
  },
  "dependencies": {
    "@app-vitals/agent-admin": "0.15.0",
    "@app-vitals/agent-lib": "0.15.0",
    "@shipwright/lib": "workspace:*",
    "@hono/zod-openapi": "^1.0.0",
    "hono": "^4.13.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "bun-types": "^1.3.14",
    "prisma": "^7.10.0",
    "typescript": "*"
  }
}
