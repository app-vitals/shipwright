{
  "name": "@app-vitals/agent-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.ts",
  "description": "Shipwright admin service — CRUD API + UI for agents, env vars, cron jobs, tokens, tools, and plugins",
  "exports": {
    ".": "./src/server.ts",
    "./admin-boot": "./src/admin-boot.ts",
    "./admin-extension": "./src/admin-extension.ts",
    "./admin-spec": "./src/admin-spec.ts",
    "./main": "./src/main.ts",
    "./openapi-schemas": "./src/openapi-schemas.ts",
    "./prisma-client": "./src/prisma-client.ts",
    "./specialty-manifest-loader": "./src/specialty-manifest-loader.ts",
    "./specialty-registry": "./src/specialty-registry.ts",
    "./theme-tokens.json": "./src/theme-tokens.json",
    "./coding/*": "./src/coding/*.ts",
    "./openapi.json": "./openapi.json",
    "./openapi.platform.json": "./openapi.platform.json",
    "./prisma.config": "./prisma.config.ts",
    "./prisma/schema/*": "./prisma/schema/*",
    "./prisma/migrations/*": "./prisma/migrations/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "postinstall": "prisma generate --schema=prisma/schema",
    "test": "NODE_ENV=test bun test",
    "test:e2e": "bunx playwright test",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate --schema=prisma/schema",
    "db:migrate": "prisma migrate deploy --schema=prisma/schema"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.135.0",
    "@hono/zod-openapi": "^1.0.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sentry/bun": "^10.63.0",
    "@sentry/hono": "^10.63.0",
    "@app-vitals/agent-lib": "0.2.0",
    "@slack/web-api": "^8.1.0",
    "hono": "^4.13.1",
    "pg": "^8.16.3",
    "yaml": "^2.9.0",
    "zod": "^4"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/pg": "^8.15.5",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "bun-types": "^1.3.14",
    "prisma": "^7.10.0",
    "typescript": "*"
  }
}
